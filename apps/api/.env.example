# Postgres connection string. See infrastructure/local/compose.yml for the
# local dev container's defaults.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# Redis connection string. Optional — defaults to redis://127.0.0.1:6379
# (see apps/api/src/redis/redis.service.ts) if unset.
REDIS_URL="redis://127.0.0.1:6379"

# API server port. The web app uses the Next.js default (3000), so the API
# must run on a different port locally.
PORT=3001

# Origin(s) allowed to call this API directly from the browser (the cart
# page revalidates client-side, since it reads localStorage). Comma-
# separated if more than one.
CORS_ORIGIN=http://localhost:3000

# DEV-ONLY: enables the unauthenticated internal store/admin order endpoints
# (/api/v1/admin/orders/*, see DevInternalGuard) for local development
# before real Role/Permission/Scope authorization exists. Must be exactly
# "true" AND NODE_ENV must not be "production" — production always denies
# these routes regardless of this flag. This is not production security;
# never enable it in a deployed/production environment.
ENABLE_DEV_INTERNAL_ORDER_ADMIN=false

# Customer authentication boundary (Milestone 4, see
# customer-auth/infrastructure/auth-provider-mode.ts). "cognito" (the
# default — used whenever this is unset) is the only production-safe value.
# "dev" is a fail-closed local/test-only escape hatch that also requires
# NODE_ENV to not be "production" — it is never sufficient by itself, and
# production always uses Cognito regardless of this value.
AUTH_PROVIDER=cognito

# Required when AUTH_PROVIDER=cognito. The Cognito user pool id (format
# "<region>_xxxxxxxxx" — the region is derived from it, no separate region
# variable is needed) and the app client id used for both InitiateAuth
# (sign-in) and ID token verification. The app client must have
# ALLOW_USER_PASSWORD_AUTH enabled and no client secret (a public client).
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# Required when AUTH_PROVIDER=dev. Shared secret used only to sign/verify
# the local dev auth boundary's own tokens — never a Cognito credential, and
# never used when AUTH_PROVIDER=cognito. Any long random string for local
# dev; never reuse a real secret here.
AUTH_DEV_JWT_SECRET=

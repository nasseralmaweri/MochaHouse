# Postgres connection string. See infrastructure/local/compose.yml for the
# local dev container's defaults.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# Redis connection string. Optional — defaults to redis://127.0.0.1:6379
# (see apps/api/src/redis/redis.service.ts) if unset.
REDIS_URL="redis://127.0.0.1:6379"

# API server port. The web app uses the Next.js default (3000), so the API
# must run on a different port locally.
PORT=3001

# Origin(s) allowed to call this API directly from the browser (the cart
# page revalidates client-side, since it reads localStorage). Comma-
# separated if more than one.
CORS_ORIGIN=http://localhost:3000

# Number of trusted reverse-proxy hops in front of this API, used only for
# client-IP derivation (req.ip → the gift-card public throttle). Unset or 0
# (the default) trusts nobody: req.ip is the direct socket peer and a
# client-sent X-Forwarded-For is ignored. Set it to the exact proxy count in
# your deployment (e.g. 1 behind a single load balancer). Never set a value
# larger than the real hop count — that lets clients spoof their IP.
TRUSTED_PROXY_HOP_COUNT=0

# ---------------------------------------------------------------------------
# Development authentication safety (ESP-02, see
# apps/api/src/config/auth-startup-guard.ts and dev-auth-context.ts)
#
# The dev auth providers ("dev" below) sign in WITHOUT a password and trust a
# shared dev secret. The API refuses to start, and the request-time gates stay
# OFF, unless the environment is a verified safe development context:
#   - NODE_ENV=development (an unset or unknown NODE_ENV is NOT safe),
#   - ALLOW_DEV_AUTH=1 (explicit opt-in; NODE_ENV alone is never enough),
#   - DATABASE_URL names a loopback host (localhost / 127.0.0.0/8 / ::1),
#   - and NO production-like signal: NODE_ENV, CENTERIVO_ENV, APP_ENV,
#     DEPLOYMENT_ENV or ENVIRONMENT set to production, prod, staging or live
#     (the strictest signal wins, so NODE_ENV=development with APP_ENV=staging
#     is refused).
# A declared isolated test run (CI, the Jest suites: CENTERIVO_TEST_DATABASE=1
# plus a token, NODE_ENV=test) is accepted without the opt-in by the request-
# time gates, but an API SERVER started that way must still use dev secrets that
# meet the requirements below (never the placeholder values published in the
# CI workflow).
#
# To use the dev providers locally put these in apps/api/.env:
#   NODE_ENV=development
#   ALLOW_DEV_AUTH=1
#   AUTH_PROVIDER=dev / INTERNAL_AUTH_PROVIDER=dev
#   AUTH_DEV_JWT_SECRET / INTERNAL_AUTH_DEV_JWT_SECRET: two DIFFERENT random
#   strings of at least 32 characters (no placeholders, no repeated character,
#   not the public CI values).
# In staging and production the mode variables must be unset or "cognito", the
# Cognito pool and client ids below must be set, no dev secret may be present,
# ALLOW_DEV_AUTH must be unset and PAYMENT_PROVIDER must not be "fake".
# ---------------------------------------------------------------------------
NODE_ENV=
ALLOW_DEV_AUTH=

# Customer authentication boundary (Milestone 4, see
# customer-auth/infrastructure/auth-provider-mode.ts). "cognito" (the
# default — used whenever this is unset) is the only production-safe value.
# "dev" is a fail-closed local/test-only escape hatch that also requires a
# verified safe development context (see the ESP-02 block above) — it is never
# sufficient by itself, and production always uses Cognito regardless of this
# value. Any other value (even a typo such as "Dev") stops the API starting.
AUTH_PROVIDER=cognito

# Required when AUTH_PROVIDER=cognito. The Cognito user pool id (format
# "<region>_xxxxxxxxx" — the region is derived from it, no separate region
# variable is needed) and the app client id used for InitiateAuth
# (sign-in), ID token verification, registration/verification
# (SignUp/ConfirmSignUp/ResendConfirmationCode — see
# cognito-registration.provider.ts), and password recovery
# (ForgotPassword/ConfirmForgotPassword — see
# cognito-password-recovery.provider.ts). The app client must have
# ALLOW_USER_PASSWORD_AUTH and self-registration enabled, and no client
# secret (a public client).
#
# Password recovery additionally requires, on the USER POOL itself (no
# app-client change): a working email delivery channel (Cognito's default
# email sender or an SES configuration) and "Email" enabled as an account
# recovery method. No AWS infrastructure is provisioned by this codebase —
# these are console/IaC settings on the pool.
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# Required when AUTH_PROVIDER=dev. Shared secret used only to sign/verify
# the local dev auth boundary's own tokens, to derive its deterministic
# email-verification and password-recovery codes (see dev-verification-code.ts
# / dev-recovery-code.ts), and to hash dev passwords so a reset can be
# demonstrated (see dev-password-hash.ts) — never a Cognito credential, and
# never used when AUTH_PROVIDER=cognito. Any long random string for local
# dev; never reuse a real secret here.
AUTH_DEV_JWT_SECRET=

# ---------------------------------------------------------------------------
# Internal (employee/admin) authentication boundary (Milestone 5A, see
# internal-auth/infrastructure/internal-auth-provider-mode.ts). A SEPARATE
# boundary from customer auth above: distinct provider switch, distinct
# Cognito pool/app client, distinct dev secret, distinct token marker. A
# customer token — Cognito or dev — can never authenticate here.
#
# Every /api/v1/admin/* and /api/v1/internal/* route is protected by
# InternalAuthGuard: a valid internal identity that maps to an existing
# Mocha House InternalUser whose status is ACTIVE. INVITED/SUSPENDED/DISABLED
# are always denied. There is no role/permission/scope model yet (5B).
# ---------------------------------------------------------------------------

# "cognito" (the default — used whenever unset) is the only production-safe
# value. "dev" is a fail-closed local/test-only escape hatch that also
# requires a verified safe development context (see the ESP-02 block above).
# Independent of AUTH_PROVIDER.
INTERNAL_AUTH_PROVIDER=cognito

# Required when INTERNAL_AUTH_PROVIDER=cognito. The DEDICATED internal
# Cognito user pool id ("<region>_xxxxxxxxx" — region is derived from it)
# and the internal app client id used for InitiateAuth (sign-in) and ID
# token verification. These MUST be different from COGNITO_USER_POOL_ID /
# COGNITO_CLIENT_ID above. The internal app client must have
# ALLOW_USER_PASSWORD_AUTH, no client secret (public client), and
# self-registration DISABLED (internal users are provisioned
# administratively). No AWS infrastructure is provisioned by this codebase.
INTERNAL_COGNITO_USER_POOL_ID=
INTERNAL_COGNITO_CLIENT_ID=

# Required when INTERNAL_AUTH_PROVIDER=dev. Shared secret used only to
# sign/verify the local dev INTERNAL auth boundary's own tokens — never a
# Cognito credential, never the customer AUTH_DEV_JWT_SECRET (keeping them
# distinct is what stops a customer dev token verifying as internal). Any
# long random string for local dev.
INTERNAL_AUTH_DEV_JWT_SECRET=

# --- CENTERIVO platform operators (SC1a) ----------------------------
# The /api/v1/platform/* boundary for the people who administer the SaaS
# platform itself (not any tenant). See docs/security/platform-operator-auth.md.
#
# "cognito" (the default — used whenever unset) is the only production-safe
# value. "dev" requires a verified safe development context, exactly like
# the boundaries above, and is refused at startup in production.
PLATFORM_AUTH_PROVIDER=cognito

# The DEDICATED platform-operator Cognito user pool and app client. MUST be
# different from both the customer and the internal pool/client (startup and
# every platform request refuse a shared one). The pool MUST have MFA set to
# REQUIRED (TOTP) and self-registration DISABLED — production MFA enforcement
# depends entirely on that pool configuration. Optional at startup: until
# both are set, every platform request answers 503 (no tenant route is
# affected). No AWS infrastructure is provisioned by this codebase.
PLATFORM_COGNITO_USER_POOL_ID=
PLATFORM_COGNITO_CLIENT_ID=

# Required when PLATFORM_AUTH_PROVIDER=dev. Signs/verifies the local dev
# PLATFORM tokens only; must differ from AUTH_DEV_JWT_SECRET and
# INTERNAL_AUTH_DEV_JWT_SECRET. Never set in production.
PLATFORM_AUTH_DEV_JWT_SECRET=

# --- Gift Cards (Milestone 7F) ---------------------------------------
# Required for gift-card issuance and lookup. HMAC-SHA-256 key used to hash
# gift-card codes before they are stored — the plaintext code is never
# persisted, and a database leak yields no spendable codes. Not a Cognito
# credential and unrelated to the JWT secrets above. Any long random string
# for local dev; a leaked/rotated secret invalidates lookup of every
# existing code, so treat it like a signing key in production.
GIFT_CARD_CODE_SECRET=

# --- Gift Cards (Milestone 7H) ---------------------------------------
# Required for customer gift-card purchases. AES-256-GCM key encrypting the
# full gift-card code for a bounded 7-day lost-response recovery window only
# (GiftCardPurchase.codeCiphertext) — the plaintext is never persisted and
# steady-state storage stays hash-only. A SEPARATE, purpose-specific secret
# from GIFT_CARD_CODE_SECRET (which must remain one-way). 256-bit key given
# as 64 hex chars (or 44 base64 chars). Rotating it makes existing purchases'
# codes unrecoverable via this flow (the cards and their balances are
# unaffected).
GIFT_CARD_PURCHASE_CODE_KEK=

# Required for customer gift-card purchases. HMAC-SHA-256 key used to build
# the one-way verifier of a GUEST purchase's recovery credential
# (GiftCardPurchase.recoveryCredentialHash). The credential itself is a
# server-generated 256-bit CSPRNG value returned to the buyer once and never
# persisted; only this keyed hash of it is stored. A SEPARATE,
# purpose-specific secret — never GIFT_CARD_CODE_SECRET or
# GIFT_CARD_PURCHASE_CODE_KEK. Any long random string for local dev; rotating
# it invalidates every outstanding guest recovery credential (issued cards
# and balances are unaffected).
GIFT_CARD_PURCHASE_RECOVERY_SECRET=

# --- Payment safety -----------------------------------------------------
# Selects the payment provider. There is no live processor yet:
#   - "fake": the deterministic simulated provider (no real money moves).
#     Development and tests ONLY — refused at startup when
#     NODE_ENV=production, and refused at every charge there as well.
#   - unset (or "disabled"): online payment is unavailable — checkout that
#     needs a card payment and gift-card purchases are refused before
#     anything is recorded. This is the default, so forgetting the variable
#     can never turn simulated payments on.
# Any other value stops the API from starting. Set "fake" for local work.
PAYMENT_PROVIDER=

# --- Milestone 8F, Media Library --------------------------------------
# Selects the MediaStorage implementation. Omit or set anything other
# than "s3" for the default LOCAL/in-memory dev-and-test provider — no AWS
# credentials required, and uploaded bytes are served back out by this API
# itself at /api/v1/media/objects/*. Set to "s3" in production.
MEDIA_STORAGE_PROVIDER=

# Required only when MEDIA_STORAGE_PROVIDER=s3.
MEDIA_S3_BUCKET=
MEDIA_S3_REGION=
# AWS credentials are resolved through the normal SDK provider chain
# (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY env vars, a shared config/
# credentials file, or an IAM role) — never set or read directly here.

# The public host images are served from — a CDN/bucket domain in
# production, or this API's own /api/v1/media/objects route in local dev
# (see apps/web/.env.example's matching value). MediaAsset only ever
# stores an objectKey; the public URL is always resolved from this value.
MEDIA_PUBLIC_BASE_URL=http://localhost:3001/api/v1/media/objects

# --- Milestone S0C, SaaS tenant foundation ------------------------------
# REQUIRED. The id of the ONE tenant this deployment currently operates as.
# Startup fails if it is missing, is not a canonical lowercase UUID, or does
# not reference an existing Tenant row — there is no default and no
# fallback. Today this is Mocha House, Tenant #1, whose id is fixed in every
# environment (TENANT_1_MOCHA_HOUSE_ID in packages/database/src/tenancy).
SINGLE_TENANT_ID=01a0db02-f800-7000-8000-000000000001

# Report-only tenant query audit (S0C). Unset or "report" logs each distinct
# tenant-owned query signature once at debug level; "off" disables it. Any
# other value fails startup. It never alters or blocks a query.
TENANT_QUERY_AUDIT=report

# Security 4C-1 — TEST RUNS ONLY. `pnpm test` refuses any database that was
# not created for testing by `pnpm --filter @mocha-house/testing
# db:create-disposable` (which creates a NEW database and marks it with this
# token; existing databases are never marked). Use a dedicated test
# DATABASE_URL whose name contains a `test` or `ci` segment, e.g. mocha_test.
# CENTERIVO_TEST_DATABASE=1
# CENTERIVO_TEST_DB_TOKEN=choose-a-local-token-of-16-plus-chars

# R1 / S3a — public API rate limiting. See docs/security/public-api-rate-limiting.md.
# Every limit is a starting value tunable per scope with
#   RATE_LIMIT_<POLICY>_<SCOPE>_LIMIT / _WINDOW_SECONDS
# (for example RATE_LIMIT_CHECKOUT_IP_LIMIT=60). A malformed value refuses to start.
# RATE_LIMIT_ENABLED=1          # 0 is refused in a production-like environment
#
# How the client IP is trusted (default: forwarded if the secret below is set,
# otherwise "off": no per-IP limits; tenant/customer/identifier/order limits
# still apply). Do NOT guess: set these once the hosting topology is decided.
#   forwarded  the web tier sends a SIGNED client IP (needs the secret)
#   peer       the connection's peer address (Express "trust proxy" via
#              TRUSTED_PROXY_HOP_COUNT above) is the real client
#   off        per-IP limits inactive
# RATE_LIMIT_CLIENT_IP_MODE=off
# Shared with the web app's CLIENT_IP_FORWARD_SECRET. At least 32 characters.
# CLIENT_IP_FORWARD_SECRET=
# Optional secret mixed into the hash of sign-in identifiers used in counters.
# RATE_LIMIT_KEY_PEPPER=
# A Redis call slower than this is treated as a failure (limits then continue
# in memory, per API instance).
# RATE_LIMIT_REDIS_TIMEOUT_MS=300

# SC4a — business owner self-service registration. OFF unless enabled AND
# fully configured (see docs/security/owner-self-registration.md; the AWS
# prerequisites there need separate approval before enabling anywhere real).
# SELF_SERVICE_REGISTRATION_ENABLED=0
# SELF_SERVICE_TERMS_VERSION=
# SELF_SERVICE_PRIVACY_VERSION=
# SELF_SERVICE_TERMS_URL=
# SELF_SERVICE_PRIVACY_URL=
# At least 32 characters; server-only.
# SELF_SERVICE_REGISTRATION_SECRET=
# SELF_SERVICE_REGISTRATION_DAILY_LIMIT=50
# The dedicated, confidential registration app client of the internal pool.
# INTERNAL_COGNITO_REGISTRATION_CLIENT_ID=
# INTERNAL_COGNITO_REGISTRATION_CLIENT_SECRET=

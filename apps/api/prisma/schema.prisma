// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Location {
  id        String         @id @default(uuid(7))
  name      String
  slug      String         @unique
  isActive  Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  menus     LocationMenu[]
}

model Category {
  id           String    @id @default(uuid(7))
  name         String
  slug         String    @unique
  displayOrder Int       @default(0)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  products     Product[]
}

model Product {
  id             String                 @id @default(uuid(7))
  name           String
  slug           String                 @unique
  description    String?
  basePrice      Int?
  currency       String                 @default("USD")
  isActive       Boolean                @default(true)
  categoryId     String
  category       Category               @relation(fields: [categoryId], references: [id])
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  modifierGroups ProductModifierGroup[]
  menus          MenuProduct[]

  @@index([categoryId])
}

model Menu {
  id        String         @id @default(uuid(7))
  name      String
  slug      String         @unique
  isActive  Boolean        @default(true)
  products  MenuProduct[]
  locations LocationMenu[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model ModifierGroup {
  id            String                 @id @default(uuid(7))
  name          String
  displayOrder  Int                    @default(0)
  isRequired    Boolean                @default(false)
  minSelections Int                    @default(0)
  maxSelections Int?
  isActive      Boolean                @default(true)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  options       ModifierOption[]
  products      ProductModifierGroup[]
}

model ModifierOption {
  id              String        @id @default(uuid(7))
  name            String
  priceAdjustment Int           @default(0)
  displayOrder    Int           @default(0)
  isActive        Boolean       @default(true)
  modifierGroupId String
  modifierGroup   ModifierGroup @relation(fields: [modifierGroupId], references: [id])
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([modifierGroupId])
}

model ProductModifierGroup {
  productId       String
  modifierGroupId String
  displayOrder    Int    @default(0)

  product       Product       @relation(fields: [productId], references: [id])
  modifierGroup ModifierGroup @relation(fields: [modifierGroupId], references: [id])

  @@id([productId, modifierGroupId])
  @@index([modifierGroupId])
}

model MenuProduct {
  menuId       String
  productId    String
  displayOrder Int     @default(0)
  isActive     Boolean @default(true)

  menu    Menu    @relation(fields: [menuId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@id([menuId, productId])
  @@index([productId])
}

model LocationMenu {
  locationId String
  menuId     String
  isActive   Boolean @default(true)

  location Location @relation(fields: [locationId], references: [id])
  menu     Menu     @relation(fields: [menuId], references: [id])

  @@id([locationId, menuId])
  @@index([menuId])
}

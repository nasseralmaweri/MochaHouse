# Server-only: base URL of the Mocha House API, used only in Server
# Components / route handlers. No NEXT_PUBLIC_ prefix — this must never be
# sent to the browser bundle unless a client-side caller is introduced.
# Also used by the internal-auth session helpers and the /api/internal/admin
# server-side proxy (Milestone 5A): the internal bearer token
# (mh_internal_session, an HttpOnly cookie) is only ever attached to
# outgoing requests here, never exposed to client-side JS.
API_URL=http://localhost:3001/api/v1

# SC4f-1 — NEXT_PUBLIC_API_URL is no longer used: the browser never calls the
# API directly (the cart revalidates through this app's /api/locations/:id/menu
# route), so the API's address is never sent to the browser.

# SC4f-1 — storefront host routing (see docs/security/storefront-host-routing.md).
# Off by default: one storefront business per deployment (the API's
# SINGLE_TENANT_ID), exactly as before. Turn on together with the API.
# STOREFRONT_HOST_ROUTING_ENABLED=false
# Must equal the API's STOREFRONT_CONTEXT_SECRET (at least 32 characters);
# required when routing is on. Different from CLIENT_IP_FORWARD_SECRET.
# STOREFRONT_CONTEXT_SECRET=
# Leave unset to use the Host header. Set ONLY if your own edge proxy rewrites
# Host and passes the original in a header it controls (e.g. x-forwarded-host);
# the hostname is read that many entries from the END of that header.
# STOREFRONT_FORWARDED_HOST_HEADER=
# STOREFRONT_FORWARDED_HOST_TRUSTED_HOPS=1

# Milestone 8F — must match the API's MEDIA_PUBLIC_BASE_URL exactly. Used
# ONLY at build/server-start time to add next/image's single allowed
# remote host (see next.config.ts) — never broadens to arbitrary domains.
MEDIA_PUBLIC_BASE_URL=http://localhost:3001/api/v1/media/objects

# R1 / S3a — forwarding the visitor's IP to the API for rate limiting.
# NOTHING is forwarded unless all three of the first two are set. Declare where
# the TRUSTWORTHY client IP comes from in YOUR deployment; this repo does not
# assume a hosting platform. See docs/security/public-api-rate-limiting.md.
# Must equal the API's CLIENT_IP_FORWARD_SECRET (at least 32 characters).
# CLIENT_IP_FORWARD_SECRET=
# The request header set by your own edge/proxy that holds the client IP
# (for example x-forwarded-for, or a platform-specific header).
# CLIENT_IP_HEADER=x-forwarded-for
# How many of your proxies append to that header (default 1). The client IP is
# the entry that many places from the END of the list; earlier entries are
# client-controlled and ignored.
# CLIENT_IP_TRUSTED_HOPS=1

# Request-origin protection (R1 / S3b). The /api proxy routes and Server Actions
# accept only requests from their own origin. List any additional trusted
# origins here (comma-separated, scheme + host), e.g. a front proxy. Empty by default.
# CSRF_ALLOWED_ORIGINS=https://shop.example
#
# Optional: send Strict-Transport-Security with this max-age (seconds). Set only
# once every host the site is served on is HTTPS-only (for example 31536000).
# HSTS_MAX_AGE_SECONDS=

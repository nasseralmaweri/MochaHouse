# Server-only: base URL of the Mocha House API, used only in Server
# Components / route handlers. No NEXT_PUBLIC_ prefix — this must never be
# sent to the browser bundle unless a client-side caller is introduced.
# Also used by the internal-auth session helpers and the /api/internal/admin
# server-side proxy (Milestone 5A): the internal bearer token
# (mh_internal_session, an HttpOnly cookie) is only ever attached to
# outgoing requests here, never exposed to client-side JS.
API_URL=http://localhost:3001/api/v1

# Public: the same API, reachable directly from the browser. Only
# /order/cart uses this — the cart lives in localStorage, so it must
# revalidate itself client-side (Server Components can't read localStorage).
# Keep this equal to API_URL for local dev; in a real deployment this may
# point at a different, publicly reachable host than the internal one.
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# Postgres connection string. Must match apps/api's DATABASE_URL — both
# processes share the same Prisma schema/client via @mocha-house/database.
# See infrastructure/local/compose.yml for the local dev container's
# defaults.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# Worker HTTP port (health checks etc. only — no order/checkout traffic
# ever reaches this process). Must differ from apps/api's PORT (3001) and
# apps/web's default (3000).
PORT=3002

# --- Milestone 8H, Notifications ---------------------------------------
# Selects the EmailSender implementation used by NotificationDispatchService
# (apps/worker/src/notifications). Omit or set anything other than "ses"
# for the default LOGGING sender — no AWS credentials required, sends are
# only logged. Set to "ses" in production.
NOTIFICATIONS_EMAIL_PROVIDER=

# Required only when NOTIFICATIONS_EMAIL_PROVIDER=ses.
NOTIFICATIONS_SES_REGION=
NOTIFICATIONS_SES_FROM_EMAIL=
# AWS credentials are resolved through the normal SDK provider chain
# (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY env vars, a shared config/
# credentials file, or an IAM role) — never set or read directly here.

# Milestone S0D-2C-3 — REMOVED from this worker. Who receives the "new job
# application" / "new franchise inquiry" internal notification is now
# tenant-owned configuration (the NotificationRecipient table), resolved
# per-tenant from the triggering OutboxEvent's own tenantId — never a
# single, process-wide address read from this file. A tenant with nothing
# configured has that notification's NotificationDelivery recorded FAILED
# (never blocks the underlying submission or its OutboxEvent). Manage the
# real configuration through the admin API (notifications.routing.manage).
# (For one-time Tenant #1 bootstrap input only, see
# packages/database/.env.example.)

# --- Milestone S0C, SaaS tenant foundation ------------------------------
# REQUIRED. The id of the ONE tenant this deployment currently operates as.
# Startup fails if it is missing, is not a canonical lowercase UUID, or does
# not reference an existing Tenant row — there is no default and no
# fallback. Today this is Mocha House, Tenant #1, whose id is fixed in every
# environment (TENANT_1_MOCHA_HOUSE_ID in packages/database/src/tenancy).
SINGLE_TENANT_ID=01a0db02-f800-7000-8000-000000000001

# Report-only tenant query audit (S0C). Unset or "report" logs each distinct
# tenant-owned query signature once at debug level; "off" disables it. Any
# other value fails startup. It never alters or blocks a query.
TENANT_QUERY_AUDIT=report

# Security 4C-1 — TEST RUNS ONLY. `pnpm test` refuses any database that was
# not created for testing by `pnpm --filter @mocha-house/testing
# db:create-disposable` (which creates a NEW database and marks it with this
# token; existing databases are never marked). Use a dedicated test
# DATABASE_URL whose name contains a `test` or `ci` segment, e.g. mocha_test.
# CENTERIVO_TEST_DATABASE=1
# CENTERIVO_TEST_DB_TOKEN=choose-a-local-token-of-16-plus-chars

# R1 / S4b — reliable notification worker (all optional; see
# docs/operations/notification-worker-cutover.md). Malformed values refuse to start.
# OUTBOX_WORKER_ENABLED=1           # 0 = boot, check the schema, claim nothing
# OUTBOX_CONCURRENCY=2              # independent claim loops (1-10)
# OUTBOX_POLL_INTERVAL_MS=2000
# OUTBOX_LEASE_SECONDS=60
# OUTBOX_SEND_TIMEOUT_MS=10000      # a provider timeout is an ambiguous outcome
# OUTBOX_MAX_ATTEMPTS=7
# OUTBOX_BACKOFF_BASE_MS=30000
# OUTBOX_BACKOFF_CAP_MS=21600000
# OUTBOX_SHUTDOWN_GRACE_MS=20000
# REQUIRED unless NODE_ENV is development, test or local: events created before this ISO-8601 instant (with a time zone) are
# never claimed (left for an operator to classify), or "none" once classified.
# OUTBOX_HISTORICAL_CUTOFF=2026-10-20T14:00:00Z

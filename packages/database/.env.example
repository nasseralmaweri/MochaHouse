# Postgres connection string. See infrastructure/local/compose.yml for the
# local dev container's defaults. Used by `prisma migrate`/`prisma generate`
# when run from this package, and shared with apps/api and apps/worker,
# which each read the same DATABASE_URL from their own .env at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# Milestone S0D-2C-3 — ONE-TIME bootstrap input for `prisma/seed.ts`, read
# from THIS package's own .env (seed runs with this package as its cwd).
# If set, and no NotificationRecipient row exists yet for Tenant #1 /
# that purpose, the seed creates it once; re-seeding never overwrites an
# HQ-chosen value. Nothing at runtime (worker or API) reads these — the
# worker resolves recipients from the NotificationRecipient table only, and
# ongoing configuration (for Tenant #1 or any other tenant) is managed
# through the admin API (notifications.routing.manage), not this file.
CAREERS_NOTIFICATION_EMAIL=
FRANCHISING_NOTIFICATION_EMAIL=

// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// --- Milestone S0C, SaaS tenant foundation -----------------------------
// A Tenant is one independent business subscribing to the platform. It is
// PLATFORM-PLANE metadata, not any one tenant's business data (see
// MODEL_TENANCY in src/tenancy/model-tenancy.ts).
//
// Mocha House is Tenant #1 with a FIXED id (TENANT_1_MOCHA_HOUSE_ID,
// 01a0db02-f800-7000-8000-000000000001) inserted by this milestone's
// migration, so every environment — including one that never runs the
// seed — has the same Tenant #1 for S0D backfills and recovery tooling.
//
// S0C adds NO tenantId to any existing table (that is S0D), and there is
// deliberately no column default anywhere that assigns a record to a
// tenant: tenant ownership is always explicit.

// ADR-5 foundation. Only the shape is introduced here — nothing enforces
// suspension yet (that is S0L-2). A DECOMMISSIONED value is intentionally
// NOT added until decommissioning has defined behaviour; adding an enum
// value later is a non-breaking migration.
enum TenantStatus {
  ACTIVE
  SUSPENDED
}

// Why a tenant is SUSPENDED. The migration's CHECK constraint makes this
// non-null exactly when status = SUSPENDED.
enum TenantSuspensionReason {
  SECURITY
  BILLING
  REQUESTED
}

model Tenant {
  id               String                  @id @default(uuid(7))
  // Stable, URL-safe key (lowercase words separated by single hyphens —
  // enforced by a CHECK constraint in the migration). Reserved for future
  // host/domain resolution; nothing resolves tenants by slug in S0C.
  slug             String                  @unique
  name             String
  // No default: provisioning must choose a status explicitly.
  status           TenantStatus
  suspensionReason TenantSuspensionReason?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  // Milestone S0D-1 — Prisma back-relations for every tenant-owned model.
  // Navigational only; a Tenant owns no business columns itself.
  locations                            Location[]
  categories                           Category[]
  products                             Product[]
  menus                                Menu[]
  modifierGroups                       ModifierGroup[]
  modifierOptions                      ModifierOption[]
  productModifierGroups                ProductModifierGroup[]
  menuProducts                         MenuProduct[]
  locationMenus                        LocationMenu[]
  locationProductPriceOverrides        LocationProductPriceOverride[]
  locationProductAvailabilityOverrides LocationProductAvailabilityOverride[]
  customers                            Customer[]
  customerPreferredLocations           CustomerPreferredLocation[]
  paymentAttempts                      PaymentAttempt[]
  paymentReconciliationCases           PaymentReconciliationCase[]
  paymentReconciliationEvents          PaymentReconciliationEvent[]
  orderClosures                        OrderClosure[]
  orderRefundObligations               OrderRefundObligation[]
  orders                               Order[]
  orderLines                           OrderLine[]
  orderStatusHistories                 OrderStatusHistory[]
  outboxEvents                         OutboxEvent[]
  notificationDeliveries               NotificationDelivery[]
  internalUsers                        InternalUser[]
  internalAuditEvents                  InternalAuditEvent[]
  internalRoles                        InternalRole[]
  internalRolePermissions              InternalRolePermission[]
  internalUserRoleAssignments          InternalUserRoleAssignment[]
  checklistTemplates                   ChecklistTemplate[]
  checklistTemplateItems               ChecklistTemplateItem[]
  checklistInstances                   ChecklistInstance[]
  checklistInstanceItems               ChecklistInstanceItem[]
  operationsTasks                      OperationsTask[]
  customerLoyaltyAccounts              CustomerLoyaltyAccount[]
  mochaBeanLedgerEntries               MochaBeanLedgerEntry[]
  loyaltyConfigurations                LoyaltyConfiguration[]
  loyaltyRewards                       LoyaltyReward[]
  loyaltyRewardProducts                LoyaltyRewardProduct[]
  loyaltyRewardCategories              LoyaltyRewardCategory[]
  orderLoyaltyRewardRedemptions        OrderLoyaltyRewardRedemption[]
  loyaltyBonusPromotions               LoyaltyBonusPromotion[]
  loyaltyBonusPromotionProducts        LoyaltyBonusPromotionProduct[]
  loyaltyBonusPromotionLocations       LoyaltyBonusPromotionLocation[]
  orderLoyaltyBonuses                  OrderLoyaltyBonus[]
  orderLoyaltyBonusItems               OrderLoyaltyBonusItem[]
  promotions                           Promotion[]
  promotionProducts                    PromotionProduct[]
  promotionCategories                  PromotionCategory[]
  promotionLocations                   PromotionLocation[]
  promotionCustomerUsages              PromotionCustomerUsage[]
  orderPromotionRedemptions            OrderPromotionRedemption[]
  giftCards                            GiftCard[]
  giftCardTransactions                 GiftCardTransaction[]
  orderGiftCardRedemptions             OrderGiftCardRedemption[]
  giftCardPurchases                    GiftCardPurchase[]
  giftCardConfigurations               GiftCardConfiguration[]
  jobOpenings                          JobOpening[]
  jobApplications                      JobApplication[]
  jobApplicationNotes                  JobApplicationNote[]
  customerNotes                        CustomerNote[]
  franchiseInquiries                   FranchiseInquiry[]
  franchiseInquiryNotes                FranchiseInquiryNote[]
  cmsPages                             CmsPage[]
  mediaAssets                          MediaAsset[]
  campaigns                            Campaign[]
  campaignProducts                     CampaignProduct[]
  approvalRequests                     ApprovalRequest[]
  notificationRecipients               NotificationRecipient[]
  // SC3c-3 — the business's designated billing contact.
  billingContact                       TenantBillingContact?

  // SC2a — the business's SaaS subscription (platform data; at most one).
  subscription TenantSubscription? @relation("TenantSubscriptionSubscriber")
}

// --- SC1a, CENTERIVO platform operators ----------------------------
// The people who administer the SaaS platform itself — NOT any tenant's
// staff. PLATFORM-PLANE data (MODEL_TENANCY 'platform'): no tenantId, no
// reference to any business record, and no relation to InternalUser or to
// any tenant role (a tenant's "platform-administrator" role confers nothing
// here).
//
// An operator is identified by the VERIFIED identity of the dedicated
// platform Cognito user pool — (externalProvider, externalSubject) — never
// by email. Rows are created only by the provisioning CLI (no API, no
// self-registration, no seed), and `status` has no default: provisioning
// chooses it explicitly. Every authenticated platform request re-reads the
// row, so DISABLED takes effect on the next request.
enum PlatformOperatorStatus {
  ACTIVE
  DISABLED
}

model PlatformOperator {
  id                  String                 @id @default(uuid(7))
  // "cognito-platform" (the dedicated platform pool) or "platform-dev"
  // (local/test only). A dev-provisioned row can never match a Cognito
  // identity, and vice versa.
  externalProvider    String
  // The pool's immutable `sub`.
  externalSubject     String
  // Lower-case (CHECK in the migration); informational and unique, never
  // used to authenticate.
  email               String                 @unique
  displayName         String?
  status              PlatformOperatorStatus
  // Observational only; set when the operator's profile is read
  // (GET /api/v1/platform/me). Never widens access.
  lastAuthenticatedAt DateTime?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  auditEventsActed             PlatformAuditEvent[]              @relation("PlatformAuditEventActor")
  // SC1d — the businesses this operator provisioned.
  tenantProvisioningOperations TenantProvisioningOperation[]     @relation("TenantProvisioningOperationActor")
  // SC2a — subscription changes this operator made.
  tenantModuleGrants           TenantModuleGrant[]               @relation("TenantModuleGrantActor")
  tenantSubscriptionEvents     TenantSubscriptionEvent[]         @relation("TenantSubscriptionEventActor")
  // SC3a — prices and billing-policy changes this operator made.
  subscriptionPlanPrices       SubscriptionPlanPrice[]           @relation("SubscriptionPlanPriceActor")
  billingPolicies              BillingPolicy[]                   @relation("BillingPolicyActor")
  // SC3b — reconciliation cases this operator resolved.
  billingReconciliationCases   BillingReconciliationCase[]       @relation("BillingReconciliationCaseResolver")
  billingGraceExtensions       BillingGraceExtension[]           @relation("BillingGraceExtensionActor")
  billingPlanChanges           BillingPlanChange[]               @relation("BillingPlanChangeActor")
  // SC3e-2 — permissions, complimentary grants and review-case actions.
  permissions                  PlatformOperatorPermission[]      @relation("PlatformOperatorPermissionHolder")
  complimentaryGranted         BillingComplimentaryGrant[]       @relation("BillingComplimentaryGrantGrantedBy")
  complimentaryFinished        BillingComplimentaryGrant[]       @relation("BillingComplimentaryGrantFinishedBy")
  billingCaseActions           BillingReconciliationCaseAction[] @relation("BillingCaseActionActor")
  // SC3e-3 — permissions granted / revoked by this operator (console), and
  // billing adjustments requested, decided and acted on.
  permissionsGranted           PlatformOperatorPermission[]      @relation("PlatformOperatorPermissionGrantor")
  permissionsRevoked           PlatformOperatorPermission[]      @relation("PlatformOperatorPermissionRevoker")
  adjustmentsRequested         BillingAdjustment[]               @relation("BillingAdjustmentRequester")
  adjustmentDecisions          BillingAdjustmentDecision[]       @relation("BillingAdjustmentDecider")
  adjustmentEvents             BillingAdjustmentEvent[]          @relation("BillingAdjustmentEventActor")

  @@unique([externalProvider, externalSubject])
}

// SC1d — one completed business provisioning, keyed by the operation's
// idempotency key: a retry of the same operation (same key, same request)
// returns the business it created; the same key with a different request is
// a conflict. Written in the same transaction as the business, its roles,
// its first owner and the audit event, so it exists exactly when they do.
// Platform-plane (no tenantId): provisionedTenantId is a plain value, never
// a foreign key to the business. Append-only (database trigger).
model TenantProvisioningOperation {
  id                      String   @id @default(uuid(7))
  idempotencyKey          String   @unique
  // SHA-256 (hex) of the normalised request; never the request itself.
  requestHash             String
  provisionedTenantId     String   @unique
  actorPlatformOperatorId String
  createdAt               DateTime @default(now())

  actorPlatformOperator PlatformOperator @relation("TenantProvisioningOperationActor", fields: [actorPlatformOperatorId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([actorPlatformOperatorId])
}

// --- CENTERIVO SaaS: plans and subscriptions (SC2a) -----------------------
// Platform data (MODEL_TENANCY 'platform'), entirely separate from a
// business's customer payments. A plan has versions; a PUBLISHED version is
// immutable (database trigger) and can only be RETIRED. A business has at
// most one current subscription (to one plan version) — the ONLY link from
// platform subscription data to a business (a reviewed exception to the
// tenancy guards) — plus add-on module grants and an append-only history.
// SC3a adds the subscription-billing foundation on the SAME tables: prices
// (versioned independently of plan features), the billing lifecycle on
// TenantSubscription, a platform billing policy, one-trial claims and a
// durable, idempotent ledger of billing-provider events. SaaS billing is
// entirely separate from a business's restaurant/customer payments: no table
// here references PaymentAttempt, orders or refunds, and none of those
// reference these.

enum SubscriptionPlanVersionStatus {
  DRAFT
  PUBLISHED
  RETIRED
}

// SC3a — the billing lifecycle of a subscription (see
// apps/api/src/saas-billing/domain/billing-lifecycle.ts). A COMPLIMENTARY
// subscription is always ACTIVE. CANCELED is a billing state, deliberately
// separate from a business's administrative/security suspension
// (Tenant.status / suspensionReason).
enum TenantSubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  UNPAID
  TRIAL_EXPIRED
  CANCELED
}

enum TenantSubscriptionEventType {
  PLAN_ASSIGNED
  PLAN_CHANGED
  ADDON_GRANTED
  ADDON_REVOKED
  // SC3a — billing lifecycle (each records fromStatus -> toStatus).
  TRIAL_STARTED
  PAYMENT_AUTHORIZED
  PAYMENT_SUCCEEDED
  PAYMENT_FAILED
  GRACE_EXPIRED
  TRIAL_EXPIRED
  CANCEL_SCHEDULED
  CANCEL_UNDONE
  CANCELED
  PLAN_CHANGE_PENDING
  PLAN_CHANGE_APPLIED
  PLAN_CHANGE_ABANDONED
  // SC3c — an expired trial's recovery window ended; the business's
  // billing suspension was applied / lifted (toStatus = the billing status).
  RECOVERY_EXPIRED
  BILLING_SUSPENDED
  BILLING_SUSPENSION_LIFTED
  // SC3c-2 — an ended subscription (expired trial or canceled) was replaced
  // by a new, PAID provider subscription through a restart Checkout.
  SUBSCRIPTION_REPLACED
  // SC3c-3 — an operator extended a PAST_DUE grace period; granted / ended
  // an UNPAID grace exception.
  GRACE_EXTENDED
  GRACE_EXCEPTION_GRANTED
  GRACE_EXCEPTION_EXPIRED
  // SC3e-2 — a complimentary grant was scheduled (the paid period ends
  // first), started, withdrawn before it started, or ended.
  COMPLIMENTARY_SCHEDULED
  COMPLIMENTARY_STARTED
  COMPLIMENTARY_WITHDRAWN
  COMPLIMENTARY_ENDED
}

// SC3a — who caused a subscription history entry.
enum TenantSubscriptionEventSource {
  OPERATOR
  BILLING_PROVIDER
  SYSTEM
}

// SC3a — COMPLIMENTARY: never billed (Founding businesses, owner decision
// E3). BILLED: billed through the SaaS billing provider.
enum TenantBillingMode {
  COMPLIMENTARY
  BILLED
}

enum SubscriptionBillingInterval {
  MONTH
  YEAR
}

// A price row is never edited: a new price is a new row and the old one is
// ARCHIVED (subscribers keep the price they agreed to).
enum SubscriptionPlanPriceStatus {
  ACTIVE
  ARCHIVED
}

enum TenantPlanChangeKind {
  UPGRADE
  DOWNGRADE
}

// SC3a — what happened to one billing-provider event (BillingProviderEvent).
enum BillingProviderEventStatus {
  RECEIVED
  APPLIED
  IGNORED
  REJECTED
  FAILED
}

model SubscriptionPlan {
  id                String   @id @default(uuid(7))
  // Stable identifier, e.g. "founding" (lowercase words, single hyphens).
  key               String   @unique
  name              String
  description       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  // SC3b — the billing provider's product for this plan (set once, when the
  // plan's first price is synced).
  externalProductId String?  @unique

  versions SubscriptionPlanVersion[]
  prices   SubscriptionPlanPrice[]
}

model SubscriptionPlanVersion {
  id          String                        @id @default(uuid(7))
  planId      String
  version     Int
  status      SubscriptionPlanVersionStatus @default(DRAFT)
  // Optional module keys (core is implicit). Frozen once PUBLISHED.
  moduleKeys  String[]
  publishedAt DateTime?
  retiredAt   DateTime?
  createdAt   DateTime                      @default(now())
  updatedAt   DateTime                      @updatedAt

  plan                 SubscriptionPlan            @relation(fields: [planId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  subscriptions        TenantSubscription[]
  pendingSubscriptions TenantSubscription[]        @relation("TenantSubscriptionPendingPlanVersion")
  planChangesFrom      BillingPlanChange[]         @relation("BillingPlanChangeFromVersion")
  planChangesTo        BillingPlanChange[]         @relation("BillingPlanChangeToVersion")
  eventsFrom           TenantSubscriptionEvent[]   @relation("TenantSubscriptionEventFrom")
  eventsTo             TenantSubscriptionEvent[]   @relation("TenantSubscriptionEventTo")
  // SC3e-2 — complimentary grants on this version / restoring from it.
  complimentaryGrants  BillingComplimentaryGrant[] @relation("BillingComplimentaryGrantPlan")
  complimentaryRestore BillingComplimentaryGrant[] @relation("BillingComplimentaryGrantPreviousPlan")

  @@unique([planId, version])
  @@index([status])
}

model TenantSubscription {
  id                     String                   @id @default(uuid(7))
  // The business — a real foreign key (owner decision S3), one per business.
  subscriberTenantId     String                   @unique
  planVersionId          String
  status                 TenantSubscriptionStatus @default(ACTIVE)
  startedAt              DateTime                 @default(now())
  // The billing provider's ids for this subscription and its customer (null
  // while COMPLIMENTARY). A billing event is matched to a business ONLY
  // through these stored ids — never through event metadata.
  billingProvider        String?
  externalSubscriptionId String?
  externalCustomerId     String?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt

  // --- SC3a billing lifecycle (null / defaults while COMPLIMENTARY) ------
  billingMode                  TenantBillingMode     @default(COMPLIMENTARY)
  // The price this business agreed to. Kept when the plan's list price
  // changes (grandfathered) until its terms are explicitly changed.
  planPriceId                  String?
  // When the business authorized recurring charges (an automatic payment
  // method on file). Nothing is ever charged without it.
  recurringPaymentAuthorizedAt DateTime?
  trialStartedAt               DateTime?
  trialEndsAt                  DateTime?
  trialRequiresPaymentMethod   Boolean?
  currentPeriodStart           DateTime?
  currentPeriodEnd             DateTime?
  // The first failed payment of the current delinquency and the end of its
  // grace period (fixed at that first failure; never extended).
  pastDueAt                    DateTime?
  graceEndsAt                  DateTime?
  // SC3c — TRIAL_EXPIRED only: when the restricted recovery window ends (then
  // the business is suspended for billing and this is cleared).
  recoveryEndsAt               DateTime?
  // SC3c-3 — UNPAID only: an operator's explicit, audited, time-limited
  // grace EXCEPTION (temporary access). The subscription stays UNPAID — the
  // provider's true state — and the debt stays outstanding.
  graceExceptionEndsAt         DateTime?
  cancelAtPeriodEnd            Boolean               @default(false)
  canceledAt                   DateTime?
  // A plan change waiting to take effect: an upgrade waits for confirmed
  // payment of pendingChangeReference; a downgrade for pendingEffectiveAt.
  pendingChangeKind            TenantPlanChangeKind?
  pendingPlanVersionId         String?
  pendingPlanPriceId           String?
  pendingChangeReference       String?
  pendingEffectiveAt           DateTime?
  // The newest billing-provider event applied (out-of-order protection) and
  // a counter for compare-and-set writes.
  lastBillingEventAt           DateTime?
  billingStateVersion          Int                   @default(0)

  subscriberTenant     Tenant                      @relation("TenantSubscriptionSubscriber", fields: [subscriberTenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  planVersion          SubscriptionPlanVersion     @relation(fields: [planVersionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  planPrice            SubscriptionPlanPrice?      @relation("TenantSubscriptionPlanPrice", fields: [planPriceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  pendingPlanVersion   SubscriptionPlanVersion?    @relation("TenantSubscriptionPendingPlanVersion", fields: [pendingPlanVersionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  pendingPlanPrice     SubscriptionPlanPrice?      @relation("TenantSubscriptionPendingPlanPrice", fields: [pendingPlanPriceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  moduleGrants         TenantModuleGrant[]
  events               TenantSubscriptionEvent[]
  trialClaim           BillingTrialClaim?
  graceExtensions      BillingGraceExtension[]
  billingNotifications BillingNotification[]
  planChanges          BillingPlanChange[]
  // SC3e-1 — the provider invoices of this subscription (history).
  invoices             BillingInvoice[]
  // SC3e-2 — complimentary grants (current and past).
  complimentaryGrants  BillingComplimentaryGrant[]
  // SC3e-3 — refunds and credits on its invoices.
  adjustments          BillingAdjustment[]
  billingEvents        BillingProviderEvent[]
  checkoutSessions     BillingCheckoutSession[]
  reconciliationCases  BillingReconciliationCase[]

  @@unique([billingProvider, externalSubscriptionId])
  @@unique([billingProvider, externalCustomerId])
  @@index([planVersionId])
  @@index([planPriceId])
  @@index([pendingPlanVersionId])
  @@index([pendingPlanPriceId])
}

// SC3a — a plan's list price for one billing interval and currency, versioned
// independently of the plan's features: a new price is a new row and the
// previous one is ARCHIVED (database trigger: an amount never changes and a
// price is never deleted). At most one ACTIVE price per plan, interval and
// currency (partial unique index). An annual price is its own amount — any
// annual discount is configured, never hard-coded.
model SubscriptionPlanPrice {
  id                      String                      @id @default(uuid(7))
  planId                  String
  interval                SubscriptionBillingInterval
  currency                String
  amountMinorUnits        Int
  status                  SubscriptionPlanPriceStatus @default(ACTIVE)
  // The billing provider's price id (set when the price is synced; SC3b).
  externalPriceId         String?                     @unique
  actorPlatformOperatorId String?
  createdAt               DateTime                    @default(now())
  archivedAt              DateTime?

  plan                  SubscriptionPlan            @relation(fields: [planId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  actorPlatformOperator PlatformOperator?           @relation("SubscriptionPlanPriceActor", fields: [actorPlatformOperatorId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  subscriptions         TenantSubscription[]        @relation("TenantSubscriptionPlanPrice")
  pendingSubscriptions  TenantSubscription[]        @relation("TenantSubscriptionPendingPlanPrice")
  planChangesFrom       BillingPlanChange[]         @relation("BillingPlanChangeFromPrice")
  planChangesTo         BillingPlanChange[]         @relation("BillingPlanChangeToPrice")
  events                TenantSubscriptionEvent[]
  checkoutSessions      BillingCheckoutSession[]
  // SC3e-2 — complimentary grants restoring to this price.
  complimentaryRestore  BillingComplimentaryGrant[] @relation("BillingComplimentaryGrantPreviousPrice")

  @@index([planId, status])
}

// SC3a — the platform billing policy: ONE row (id "default"). Read when a
// trial or a delinquency starts and copied onto the subscription
// (trialEndsAt / graceEndsAt), so a later policy change never alters a trial
// or grace period already running.
model BillingPolicy {
  id                         String   @id
  trialDays                  Int
  trialRequiresPaymentMethod Boolean
  gracePeriodDays            Int
  // SC3c — the restricted recovery window an expired trial gets (core
  // access only) before its business is suspended for billing.
  trialRecoveryDays          Int      @default(3)
  actorPlatformOperatorId    String?
  updatedAt                  DateTime @updatedAt

  actorPlatformOperator PlatformOperator? @relation("BillingPolicyActor", fields: [actorPlatformOperatorId], references: [id], onDelete: Restrict, onUpdate: Restrict)
}

// SC3a — repeated-trial protection, append-only (database trigger): one trial
// per business (subscriptionId unique) and one per owner email across
// businesses (claimKey: a SHA-256 digest of the normalized owner email, so
// the address itself is not copied here).
model BillingTrialClaim {
  id             String   @id @default(uuid(7))
  subscriptionId String   @unique
  claimKey       String   @unique
  createdAt      DateTime @default(now())

  subscription TenantSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
}

// SC3a — the durable ledger of billing-provider events. Delivery is
// at-least-once, possibly delayed and out of order: an event is recorded
// FIRST (unique per provider event id, so a redelivery is a no-op) and its
// effect is applied at most once. Identity columns never change and rows
// are never deleted (database trigger); only the processing outcome moves.
// No card data and no raw payload are kept (payloadDigest is a SHA-256).
model BillingProviderEvent {
  id                     String                     @id @default(uuid(7))
  provider               String
  externalEventId        String
  type                   String
  livemode               Boolean
  occurredAt             DateTime
  receivedAt             DateTime                   @default(now())
  payloadDigest          String
  externalSubscriptionId String?
  externalCustomerId     String?
  // The subscription this event matched through OUR stored provider ids
  // (null when it matched none).
  subscriptionId         String?
  status                 BillingProviderEventStatus @default(RECEIVED)
  outcome                String?
  processedAt            DateTime?
  attempts               Int                        @default(0)

  subscription        TenantSubscription?         @relation(fields: [subscriptionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  historyItems        TenantSubscriptionEvent[]
  reconciliationCases BillingReconciliationCase[]

  @@unique([provider, externalEventId])
  @@index([subscriptionId, occurredAt])
  @@index([status, receivedAt])
}

enum BillingCheckoutSessionStatus {
  OPEN
  COMPLETED
  EXPIRED
}

// SC3b — a hosted Checkout session WE created for a business's subscription
// (the only way a provider subscription is linked to a business: the
// completed session must be one of these). At most one OPEN per subscription
// (partial unique index). The trial offered is fixed when the session is
// created. Rows are never deleted; the provider session id is set once
// (database trigger).
model BillingCheckoutSession {
  id                             String                       @id @default(uuid(7))
  subscriptionId                 String
  planPriceId                    String
  externalSessionId              String?                      @unique
  status                         BillingCheckoutSessionStatus @default(OPEN)
  // 0 = no trial.
  trialDays                      Int
  requiresPaymentMethod          Boolean
  // SC3b — the one-trial claim this Checkout offers a trial under (set iff
  // trialDays > 0). Only a hold: BillingTrialClaim is recorded when the
  // provider has verifiably created the trial subscription.
  trialClaimKey                  String?
  // SC3c-2 — a restart Checkout: the ended provider subscription it
  // replaces (never with a trial; set once; one COMPLETED per replaced id).
  replacesExternalSubscriptionId String?
  expiresAt                      DateTime?
  completedAt                    DateTime?
  createdAt                      DateTime                     @default(now())

  subscription TenantSubscription    @relation(fields: [subscriptionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  planPrice    SubscriptionPlanPrice @relation(fields: [planPriceId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([subscriptionId, createdAt])
  @@index([planPriceId])
}

enum BillingReconciliationCaseStatus {
  OPEN
  RESOLVED
}

// SC3b — something a platform operator must review: a provider/ours state
// mismatch, an event that could not be applied, a payment we could not
// match. Review only: creating or resolving a case never moves money or
// changes a subscription. At most one OPEN case per subscription and kind
// (partial unique index). Rows are never deleted.
model BillingReconciliationCase {
  id                           String                          @id @default(uuid(7))
  kind                         String
  subscriptionId               String?
  billingProviderEventId       String?
  detail                       String?
  status                       BillingReconciliationCaseStatus @default(OPEN)
  createdAt                    DateTime                        @default(now())
  resolvedAt                   DateTime?
  resolvedByPlatformOperatorId String?
  // SC3e-2 — how it was closed (an outcome code) and the operator's note.
  resolutionOutcome            String?
  resolutionNote               String?

  subscription         TenantSubscription?               @relation(fields: [subscriptionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  billingProviderEvent BillingProviderEvent?             @relation(fields: [billingProviderEventId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  resolvedBy           PlatformOperator?                 @relation("BillingReconciliationCaseResolver", fields: [resolvedByPlatformOperatorId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  actions              BillingReconciliationCaseAction[]

  @@index([status, createdAt])
  @@index([subscriptionId])
  @@index([billingProviderEventId])
  @@index([resolvedByPlatformOperatorId])
}

// An add-on: one optional module granted to one business beyond its plan.
model TenantModuleGrant {
  id                      String   @id @default(uuid(7))
  subscriptionId          String
  moduleKey               String
  actorPlatformOperatorId String?
  grantedAt               DateTime @default(now())

  subscription          TenantSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  actorPlatformOperator PlatformOperator?  @relation("TenantModuleGrantActor", fields: [actorPlatformOperatorId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([subscriptionId, moduleKey])
}

// Append-only (database trigger): every assignment, plan change and add-on
// grant or revocation, for the record and for future billing.
model TenantSubscriptionEvent {
  id                      String                        @id @default(uuid(7))
  subscriptionId          String
  type                    TenantSubscriptionEventType
  fromPlanVersionId       String?
  toPlanVersionId         String?
  moduleKey               String?
  actorPlatformOperatorId String?
  createdAt               DateTime                      @default(now())
  // SC3a — billing lifecycle history.
  source                  TenantSubscriptionEventSource @default(OPERATOR)
  fromStatus              TenantSubscriptionStatus?
  toStatus                TenantSubscriptionStatus?
  planPriceId             String?
  billingProviderEventId  String?

  subscription          TenantSubscription       @relation(fields: [subscriptionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  fromPlanVersion       SubscriptionPlanVersion? @relation("TenantSubscriptionEventFrom", fields: [fromPlanVersionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  toPlanVersion         SubscriptionPlanVersion? @relation("TenantSubscriptionEventTo", fields: [toPlanVersionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  actorPlatformOperator PlatformOperator?        @relation("TenantSubscriptionEventActor", fields: [actorPlatformOperatorId], references: [id], onDelete: Restrict, onUpdate: Restrict)

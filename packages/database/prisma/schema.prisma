// --- Milestone 4, customer identity foundation -------------------------
// Cognito owns credentials/passwords, verification, recovery, and token
// lifecycle. Mocha House owns this record, the customer's profile, and
// account status. externalProvider + externalSubject is a deliberately
// provider-agnostic identity mapping (a plain string pair, never a Cognito
// SDK payload shape) so the Customer domain never depends on Cognito's
// token/claims structure — only the customer-auth boundary (apps/api) does.
// No password or Cognito token is ever stored here.

enum CustomerAccountStatus {
  ACTIVE
  RESTRICTED
  DEACTIVATED
}

model Customer {
  id                  String                      @id @default(uuid(7))
  externalProvider    String
  externalSubject     String
  email               String?
  displayName         String?
  status              CustomerAccountStatus       @default(ACTIVE)
  // Contact-verification state (Milestone 4C) — deliberately separate from
  // `status` above: this tracks whether the registration email has been
  // confirmed with the identity provider, not the customer's business
  // account standing. Null means "never verified" — set once, at
  // successful verification, and never fabricated/backfilled for rows
  // created before this column existed (see the migration's own comment).
  emailVerifiedAt     DateTime?
  // Communication preference (Milestone 4F). true ONLY when the customer
  // has explicitly opted in to marketing/promotional email. It never gates
  // transactional/account mail (verification, password recovery, order
  // confirmation, security notices) — those are operationally required and
  // sent regardless. This column is current-state only: it is not, and
  // must not be treated as, an audit-quality record of historic consent
  // (no source/version/timestamp of the consent event is captured here).
  marketingEmailOptIn Boolean                     @default(false)
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt
  orders              Order[]
  preferredLocations  CustomerPreferredLocation[]
  loyaltyAccount      CustomerLoyaltyAccount?
  promotionUsage      PromotionCustomerUsage[]
  promoRedemptions    OrderPromotionRedemption[]
  // Milestone 7H — gift cards this customer bought while signed in. Guest
  // purchases have customerId null and never appear here. onDelete: SetNull
  // (see GiftCardPurchase) keeps the purchase + its financial history intact
  // if the Customer is later removed.
  giftCardPurchases   GiftCardPurchase[]
  // Milestone 8A — internal CRM notes attached to this customer. onDelete:
  // Cascade (see CustomerNote): a note is meaningless without its customer,
  // and the customer row has no FK pointing here so removing notes can
  // never corrupt it.
  crmNotes            CustomerNote[]

  // Milestone S0D-1 / S0D-2B-1 — the owning tenant. REQUIRED since
  // S0D-2B-1: a Customer is only ever created by the JIT resolver, from the
  // request's explicit TenantContext. No default.
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([externalProvider, externalSubject])
  // Security 4C-2 — composite tenant key: lets child tables reference
  // (tenantId, id) so the database itself can refuse a cross-business link
  // (composite foreign keys arrive in Security 4C-3).
  @@unique([tenantId, id])
  @@index([tenantId])
}

// --- Milestone 4F, preferred locations --------------------------------
// A managed set of authoritative Mocha House Location records a customer
// has saved to speed up repeat ordering. Pure join table: it carries no
// customer-authored content (no nickname/notes/ranking) — those are
// deliberately out of scope. There is no "primary/default" concept; the
// approved requirement is satisfied by the set alone.
//
// onDelete: Cascade on both sides — a join row is meaningless without both
// referents, and removing it can never corrupt a Customer or a Location
// (neither has a foreign key pointing here). A Location going inactive is
// handled in the query layer (CustomerPreferredLocationsService only
// returns rows whose Location is still active), not by deleting rows.
model CustomerPreferredLocation {
  id         String   @id @default(uuid(7))
  customerId String
  locationId String
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Cascade, onUpdate: Restrict)
  location Location @relation(fields: [tenantId, locationId], references: [tenantId, id], onDelete: Cascade, onUpdate: Restrict)

  // Milestone S0D-1 / S0D-2B-2 — the owning tenant. REQUIRED since
  // S0D-2B-2: copied from the tenant-validated parent Customer, and the
  // Location must belong to that same tenant. No default.
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([customerId, locationId])
  @@index([customerId])
  @@index([locationId])
  @@index([tenantId])
}

// --- Milestone 3, first transaction slice -----------------------------
// Checkout -> FakePaymentProvider -> durable Order + immutable snapshots
// -> OrderStatusHistory -> transactional OutboxEvent -> confirmation.
// Store Queue processing / status advancement is a later slice: OutboxEvent
// rows are written here but nothing consumes them yet.

enum PaymentAttemptStatus {
  PENDING
  SUCCEEDED
  DECLINED
  FAILED
}

// RECEIVED is the only status this slice ever writes. ACCEPTED..COMPLETED
// name the approved Store Queue pipeline stages so the next slice adds no
// new enum values, only the code that transitions into them.
enum OrderStatus {
  RECEIVED
  ACCEPTED
  PREPARING
  READY
  COMPLETED
  // R1 / S5a — terminal states for an order the shop turned away (REJECTED,
  // only from RECEIVED) or called off after accepting it (CANCELLED, from
  // ACCEPTED / PREPARING / READY). Both are TERMINAL like COMPLETED. S5a only
  // adds the values and the records around them (OrderClosure,
  // OrderRefundObligation, the ledger reversal types): NOTHING writes either
  // status yet, no API can reach them, and no benefit is reversed. The writer
  // arrives in S5b. Postgres cannot remove an enum value, so rolling back
  // means "stop using them", never "drop them".
  REJECTED
  CANCELLED
}

enum OutboxEventStatus {
  PENDING
  PROCESSED
  FAILED
}

// Milestone 8H — the only channel this slice supports.
enum NotificationChannel {
  EMAIL
}

enum NotificationDeliveryStatus {
  PENDING
  SENT
  FAILED
}

// A durable, independent record of a payment charge attempt against
// FakePaymentProvider. Created (PENDING) before the provider is invoked,
// and preserved regardless of outcome — a decline/failure never deletes or
// overwrites this row, it only ever updates its status once. The unique
// idempotencyKey is what makes checkout submission idempotent: a retried
// request with the same key reuses this row's outcome instead of charging
// or creating an Order again.
model PaymentAttempt {
  id                String               @id @default(uuid(7))
  idempotencyKey    String               @unique
  provider          String
  status            PaymentAttemptStatus @default(PENDING)
  // Milestone 7H — nullable: a food-order checkout always sets it; a
  // gift-card purchase (which has no location) leaves it null.
  locationId        String?
  amount            Int
  currency          String
  providerReference String?
  failureReason     String?

  // Set when this attempt's payment SUCCEEDED but the subsequent protected
  // Order transaction did not commit (e.g. the catalog changed underneath
  // it, or an unexpected error aborted the transaction). `status` stays
  // SUCCEEDED — the payment truthfully did succeed — this is a separate,
  // explicit flag so that condition is durable and queryable rather than
  // only inferable from "SUCCEEDED with no linked Order". No refund or
  // retry is triggered automatically; a later reconciliation slice (worker
  // or admin) is expected to query reconciliationRequired = true.
  reconciliationRequired   Boolean   @default(false)
  reconciliationReason     String?
  reconciliationDetectedAt DateTime?

  // ESP-03 PR 1 — the payment-recovery state machine, ADDITIVE and unused by
  // application code until a later PR. Both are NULL for every row the new
  // code has not yet classified: NULL means "legacy semantics — `status` and
  // `reconciliationRequired` above are authoritative". Plain text with CHECK
  // constraints (not enums): PostgreSQL cannot add an enum value and use it
  // in the same transaction, and enum values cannot be dropped.
  //   paymentState      NOT_SENT | CHARGING | AWAITING_CONFIRMATION | UNKNOWN |
  //                     SUCCEEDED | DECLINED | FAILED   (the provider side;
  //                     an unknown outcome is NEVER recorded as FAILED)
  //   fulfilmentStatus  NOT_REQUIRED | PENDING | DONE | NEEDS_REVIEW
  //                     (our side: the order / gift card for a SUCCEEDED payment)
  // The migration backfills ONLY rows that clearly need attention (stuck
  // PENDING, SUCCEEDED without an order or card) and opens a reconciliation
  // case for each; every other row stays NULL.
  paymentState     String?
  fulfilmentStatus String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // A PaymentAttempt backs AT MOST ONE domain object — a food Order OR a
  // gift-card purchase, never both. Each side is a 1:1 (Order.paymentAttemptId
  // and GiftCardPurchase.paymentAttemptId are both @unique). BEFORE INSERT OR
  // UPDATE OF "paymentAttemptId" triggers on Order and GiftCardPurchase
  // (migration 20260910..._harden_gift_card_purchase_recovery) reject any
  // insert OR update whose paymentAttemptId is already claimed by the other
  // table — declarative cross-table enforcement, not programmer convention.
  order              Order?
  reconciliationCase PaymentReconciliationCase?
  // R1 / S5a — at most one refund obligation, through its Order.
  refundObligations  OrderRefundObligation[]
  // Security 4C-3 — the checkout location, now a composite foreign key: a
  // payment attempt can only name a Location of its own business. Locations
  // are never deleted while a payment references them (Restrict, like
  // Order.location): payment history is audit data, so such a location is
  // deactivated (isActive = false), never hard-deleted. A gift-card purchase
  // still leaves it null.
  location           Location?                  @relation(fields: [tenantId, locationId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  giftCardPurchase   GiftCardPurchase?

  // Milestone S0D-1 / S0D-2C-1 — the owning tenant. REQUIRED since
  // S0D-2C-1: a checkout attempt takes the tenant of its server-validated
  // Location; a gift-card purchase attempt takes the request's explicit
  // TenantContext. No default.
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  // Security 4C-2 — composite tenant key: lets child tables reference
  // (tenantId, id) so the database itself can refuse a cross-business link
  // (composite foreign keys arrive in Security 4C-3).
  @@unique([tenantId, id])
  @@index([status])
  @@index([reconciliationRequired])
  @@index([tenantId])
}

// ESP-03 PR 1 — one reconciliation case per PaymentAttempt that needs a human
// or a later automated recovery step (a payment of unknown outcome, or a
// charged payment with no order / gift card). A case is the OPERATIONAL record;
// every change to it is also appended to PaymentReconciliationEvent. Nothing in
// the application reads or writes either table yet (PR 1 is the foundation).
//
// status      OPEN | IN_REVIEW | RESOLVED
// reasonCode  a short machine code (e.g. LEGACY_PENDING_UNRESOLVED) — never
//             free text, never provider output, never personal data
// resolution  set only with status RESOLVED: FULFILLED | REFUNDED_EXTERNALLY |
//             NOT_CHARGED. REFUNDED_EXTERNALLY records a HUMAN-asserted fact; no
//             refund capability exists in the platform.
// CHECK constraints (not expressible in Prisma) keep status / resolution /
// resolvedAt consistent. Tenant-owned: composite foreign keys keep the case, its
// attempt, its assignee and its events inside one business; the
// "<Table>_tenantId_immutable" trigger refuses a change of tenantId.
model PaymentReconciliationCase {
  id                     String         @id @default(uuid(7))
  paymentAttemptId       String
  paymentAttempt         PaymentAttempt @relation(fields: [tenantId, paymentAttemptId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  status                 String         @default("OPEN")
  reasonCode             String
  assigneeInternalUserId String?
  assignee               InternalUser?  @relation("PaymentReconciliationAssignee", fields: [tenantId, assigneeInternalUserId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  resolution             String?
  resolvedAt             DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events PaymentReconciliationEvent[]

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, paymentAttemptId])
  @@index([tenantId, status])
}

// ESP-03 PR 1 — append-only history of a reconciliation case. A database
// trigger rejects every UPDATE and DELETE of a row. actorKind USER carries the
// acting InternalUser; SYSTEM (a sweeper, a migration) carries none — which is
// why this is not InternalAuditEvent, whose actor is required. `detail` is a
// small JSON object that must never hold personal data, secrets, codes,
// tokens, idempotency keys or raw provider payloads.
model PaymentReconciliationEvent {
  id                  String                    @id @default(uuid(7))
  caseId              String
  reconciliationCase  PaymentReconciliationCase @relation(fields: [tenantId, caseId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  actorKind           String
  actorInternalUserId String?
  actor               InternalUser?             @relation("PaymentReconciliationEventActor", fields: [tenantId, actorInternalUserId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  action              String
  detail              Json?

  createdAt DateTime @default(now())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([tenantId])
  @@index([caseId, createdAt])
}

// The durable Mocha House order. Only ever created inside the protected
// transaction that follows a SUCCEEDED PaymentAttempt — paymentAttemptId is
// required and unique, so the database itself rules out an Order existing
// without a successful payment behind it. Guest contact and pricing fields
// are point-in-time snapshots (see OrderLine), never re-derived from the
// catalog after the fact.
model Order {
  id          String      @id @default(uuid(7))
  orderNumber String      @unique
  // Opaque bearer credential for guest access to this order's status. The
  // internal id alone is not authorization — see OrdersController.
  accessToken String      @unique
  status      OrderStatus @default(RECEIVED)

  locationId String
  location   Location @relation(fields: [tenantId, locationId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  // Nullable: guest checkout (Milestone 3) never sets this. Populated only
  // when the checkout request carried a valid, verified customer session
  // (Milestone 4B) — the Mocha House Customer.id, never a Cognito subject,
  // keeping this relationship provider-agnostic like the rest of the
  // customer domain. onDelete: SetNull rather than Cascade so a Customer
  // record being removed later (privacy handling is explicitly not part of
  // this slice) can never destroy this Order's own history — the order
  // simply reverts to looking like a guest order, never disappears.
  customerId String?
  customer   Customer? @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: SetNull, onUpdate: Restrict)

  paymentAttemptId String         @unique
  paymentAttempt   PaymentAttempt @relation(fields: [tenantId, paymentAttemptId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  // Guest contact snapshot, captured at checkout time regardless of whether
  // the order is also linked to a Customer above — never re-derived from a
  // Customer's (mutable) profile fields, so this historical snapshot can
  // never change after the fact even if the customer later edits their
  // profile (not yet possible, but this must hold once it is).
  guestName  String
  guestPhone String
  guestEmail String?

  currency                    String
  // Gross merchandise total — the sum of every OrderLine.lineTotal, exactly
  // as before Milestone 7C. No tax/fee model is approved yet.
  subtotal                    Int
  // Milestone 7E — the discount applied by the ONE regular Promotion or
  // Coupon used on this order, in integer minor units. 0 when none was used
  // (every pre-7E order). Applied to gross merchandise BEFORE the Mocha Bean
  // reward. The immutable snapshot lives on OrderPromotionRedemption.
  promotionDiscountMinorUnits Int    @default(0)
  // Milestone 7C — the discount applied by a single redeemed Mocha Bean
  // reward, in integer minor units. 0 when no reward was used (every
  // pre-7C order). Applied AFTER the regular Promotion/Coupon discount and
  // capped at the merchandise then remaining. The amount actually charged /
  // owed is `subtotal - promotionDiscountMinorUnits - rewardDiscountMinorUnits`;
  // Mocha Beans are earned on that same net figure. Never makes the net
  // negative (each discount is capped at the merchandise then remaining).
  // The immutable reward snapshot lives on OrderLoyaltyRewardRedemption.
  rewardDiscountMinorUnits    Int    @default(0)
  // Milestone 7G — the amount of this order paid by a redeemed gift card, in
  // integer minor units. 0 when no gift card was used (every pre-7G order). A
  // gift card is a TENDER, not a discount: it does NOT change `subtotal` or
  // either discount above and it is NOT part of the merchandise basis for
  // promotion or Mocha Bean earning. The amount owed is
  // `subtotal - promotionDiscountMinorUnits - rewardDiscountMinorUnits`; of
  // that, `giftCardTenderMinorUnits` is covered by the gift card and the
  // remainder (`PaymentAttempt.amount`) is charged externally. The immutable
  // snapshot lives on OrderGiftCardRedemption.
  giftCardTenderMinorUnits    Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines                   OrderLine[]
  statusHistory           OrderStatusHistory[]
  mochaBeanEntries        MochaBeanLedgerEntry[]
  loyaltyRewardRedemption OrderLoyaltyRewardRedemption?
  loyaltyBonus            OrderLoyaltyBonus?
  promotionRedemption     OrderPromotionRedemption?
  giftCardRedemption      OrderGiftCardRedemption?
  giftCardTransactions    GiftCardTransaction[]
  // R1 / S5a — present only on a REJECTED / CANCELLED order (written by S5b).
  // R1 / S5b — an Order can never be INSERTED already REJECTED / CANCELLED
  // (BEFORE INSERT trigger Order_insert_not_closed, migration
  // 20261020090000_order_closure_writer_guards): those statuses are reached
  // only by the closure workflow updating an existing order.
  closure                 OrderClosure?
  refundObligation        OrderRefundObligation?

  // Milestone S0D-1 / S0D-2C-1 — the owning tenant. REQUIRED since
  // S0D-2C-1: copied from its PaymentAttempt, whose tenant is that of the
  // server-validated Location. No default.
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  // Security 4C-2 — composite tenant key: lets child tables reference
  // (tenantId, id) so the database itself can refuse a cross-business link
  // (composite foreign keys arrive in Security 4C-3).
  @@unique([tenantId, id])
  // Security 4C-3 — the one-to-one payment link as a composite key (paymentAttemptId
  // is already unique on its own, so this pair is too).
  @@unique([tenantId, paymentAttemptId])
  @@index([locationId])
  @@index([customerId])
  @@index([tenantId])
}

// --- R1 / S5a, order closure foundation ---------------------------
// The permanent record that an order was REJECTED (turned away while still
// RECEIVED) or CANCELLED (called off after acceptance). ONE immutable row per
// order, written by the S5b closure writer in the SAME transaction as the
// Order.status change, the status-history row and every benefit reversal.
// In S5a NOTHING writes it: the table, its constraints and its triggers are
// the foundation only.
//
// It is a summary SNAPSHOT, never a source of truth for money: the ledgers
// (GiftCardTransaction, MochaBeanLedgerEntry) and the refund obligation hold
// the actual movements. `refundDueMinorUnits` is the externally charged
// amount owed back; `giftCardRestoredMinorUnits` the gift-card tender returned
// to the card; `loyaltyShortfallBeans` the Beans that could not be recovered
// because the customer had already spent them (see MochaBeanEntryType).
//
// Database guarantees (migration 20261019090100_order_closure_foundation):
//   - append-only: every UPDATE and DELETE is rejected;
//   - composite tenant keys to the Order and the acting InternalUser, plus an
//     immutable-tenant trigger;
//   - a deferred check that the Order's status equals `kind` and that a
//     refund obligation exists exactly when refundDueMinorUnits > 0, with the
//     same amount (so the summary can never disagree with the obligation).
model OrderClosure {
  id                         String       @id @default(uuid(7))
  orderId                    String       @unique
  order                      Order        @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  // REJECTED | CANCELLED (CHECK). Equals Order.status of a closed order.
  kind                       String
  // The status the order held when it was closed: RECEIVED for a rejection,
  // ACCEPTED / PREPARING / READY for a cancellation (CHECK).
  fromStatus                 OrderStatus
  // UPPER_SNAKE machine code (CHECK); the staff-visible wording lives in code.
  reasonCode                 String
  // Optional free text for the audit trail, 1-500 characters (CHECK).
  note                       String?
  actorInternalUserId        String
  actor                      InternalUser @relation("OrderClosureActor", fields: [tenantId, actorInternalUserId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  refundDueMinorUnits        Int          @default(0)
  giftCardRestoredMinorUnits Int          @default(0)
  loyaltyShortfallBeans      Int          @default(0)
  createdAt                  DateTime     @default(now())

  refundObligation OrderRefundObligation?

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, orderId])
  @@index([tenantId, createdAt])
  @@index([actorInternalUserId])
}

// R1 / S5a — money owed back to the customer on an external (card) payment
// of a rejected or cancelled order. There is NO refund capability in the
// payment provider yet, so an obligation is created DUE and stays DUE until a
// person records an out-of-band refund (MANUAL_EXTERNAL) or, later, a real
// processor refund (PROCESSOR, S5c). Nothing here moves money and nothing
// may mark a refund REFUNDED silently: REFUNDED requires a method, a time
// and either the staff member who recorded it or the processor's refund id
// (CHECKs), and is terminal (trigger).
//
// Why not PaymentReconciliationCase: that case is unique per payment attempt
// and describes an unresolved CHARGE; reusing it could hide an owed refund
// behind a resolved case. This is a different obligation with its own life.
//
// Not append-only (it is the one mutable row of the closure): its identity
// (order, closure, attempt, amount, currency, tenant) is immutable and a
// REFUNDED row is frozen, both enforced by triggers. A gift-card tender is
// never refunded here; it is restored to the card by a ledger entry.
//
// R1 / S5b (migration 20261020090000_order_closure_writer_guards): a
// MANUAL_EXTERNAL settlement also needs `settlementReference` (the evidence;
// CHECK OrderRefundObligation_manual_evidence_check) and must be recorded by
// someone other than the staff member who closed the order (trigger
// OrderRefundObligation_settler_not_closer). The S5b writer creates
// obligations DUE and never settles them.
model OrderRefundObligation {
  id                      String         @id @default(uuid(7))
  orderId                 String         @unique
  order                   Order          @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  closureId               String         @unique
  closure                 OrderClosure   @relation(fields: [tenantId, closureId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  paymentAttemptId        String
  paymentAttempt          PaymentAttempt @relation(fields: [tenantId, paymentAttemptId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  // Positive integer minor units (CHECK): the externally charged amount to
  // return. Never exceeds what was charged; the writer enforces that against
  // PaymentAttempt.amount.
  amountMinorUnits        Int
  currency                String
  // DUE | PROCESSING | REFUNDED | FAILED (CHECK).
  status                  String         @default("DUE")
  // MANUAL_EXTERNAL | PROCESSOR; set exactly when status is REFUNDED (CHECK).
  settlementMethod        String?
  // Short staff note for a manual refund (a receipt or reference), 1-200.
  settlementReference     String?
  // The processor's refund id: PROCESSING / REFUNDED / FAILED only; unique
  // per business so one processor refund cannot settle two obligations.
  processorRefundId       String?
  settledAt               DateTime?
  settledByInternalUserId String?
  settledBy               InternalUser?  @relation("OrderRefundObligationSettledBy", fields: [tenantId, settledByInternalUserId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, orderId])
  @@unique([tenantId, closureId])
  @@unique([tenantId, processorRefundId])
  @@index([tenantId, status])
  @@index([paymentAttemptId])
  @@index([settledByInternalUserId])
}

// Immutable line snapshot captured at order-creation time: prices and
// modifier selections are copied by value from the authoritative repricing
// step, never re-joined against the live catalog. `selections` is a JSON
// snapshot (group/option names + price adjustments) for the same reason
// the cart already treats catalog state as mutable — an Order must survive
// later menu/price changes unchanged.
model OrderLine {
  id      String @id @default(uuid(7))
  orderId String
  order   Order  @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  productId   String
  productName String
  unitPrice   Int
  quantity    Int
  lineTotal   Int
  currency    String
  selections  Json

  createdAt DateTime @default(now())

  // Milestone S0D-1 / S0D-2C-1 — the owning tenant. REQUIRED since
  // S0D-2C-1: copied from its parent Order. No default.
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([orderId])
  // Security 4C-6 — the deleted-product-id reuse guard looks product
  // snapshots up by this column.
  @@index([productId])
  @@index([tenantId])
}

// Append-only. Rows are never updated or deleted — the current status is
// whichever row is latest, but Order.status is kept as the fast-read
// projection of that history rather than requiring a join on every read.
model OrderStatusHistory {
  id      String @id @default(uuid(7))
  orderId String
  order   Order  @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())

  // Milestone S0D-1 / S0D-2C-1 — the owning tenant. REQUIRED since
  // S0D-2C-1: copied from its parent Order. No default.
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([orderId])
  @@index([tenantId])
}

// Generic transactional outbox: written in the same database transaction
// that commits a successful Order, so "the order exists" and "a
// fulfillment event was recorded" can never disagree. Deliberately not
// scoped to Order via a foreign key — that's what keeps this a genuine,
// aggregate-agnostic outbox rather than an Order-specific queue table.
// Nothing consumes these rows yet; that is the next slice (Store Queue
// worker), not this one.
model OutboxEvent {
  id            String            @id @default(uuid(7))
  aggregateType String
  aggregateId   String
  eventType     String
  payload       Json
  status        OutboxEventStatus @default(PENDING)
  createdAt     DateTime          @default(now())
  processedAt   DateTime?

  // S4a — notification reliability foundation. ADDITIVE ONLY: nothing reads or
  // writes these columns yet (the live worker is unchanged), so behaviour is
  // identical until S4b. They give the future worker a PostgreSQL lease,
  // scheduled retries and a dead-letter state:
  //   PENDING   = not finished: waiting for its first attempt or a retry; it is
  //               "in progress" while leaseExpiresAt is in the future
  //   PROCESSED = handled successfully (the email provider ACCEPTED the message,
  //               or the event type has no handler). This is NOT a guarantee
  //               that the message reached the customer's inbox.
  //   FAILED    = permanent failure or exhausted retries (the dead letter);
  //               failedAt is set and lastError(Code) say why
  // All timestamps are UTC (timestamp without time zone, as everywhere else);
  // compare them with timezone('utc', now()), never a bare now() (see the
  // migration). attemptCount is bumped by every claim. A worker id alone does
  // NOT identify a claim (a worker can lose a lease and re-claim the same
  // event): S4b must fence later writes on (id, tenantId, leaseOwner,
  // attemptCount) or use a unique per-claim token as leaseOwner.
  // Constraints and the two partial indexes are in the migration SQL, which
  // Prisma cannot express; they are listed here so they are not lost:
  //   CHECKs: attemptCount >= 0; leaseOwner and leaseExpiresAt both set or both
  //   null; leaseOwner 1-200 chars; only PENDING rows hold a lease; failedAt is
  //   set exactly when status is FAILED; lastError <= 2000 chars; lastErrorCode
  //   is UPPER_SNAKE; expiresAt not before createdAt.
  //   INDEXES: OutboxEvent_pending_due_idx (nextAttemptAt, createdAt)
  //   WHERE status = 'PENDING'; OutboxEvent_failed_idx (tenantId, failedAt)
  //   WHERE status = 'FAILED'.
  attemptCount   Int       @default(0)
  nextAttemptAt  DateTime  @default(dbgenerated("timezone('utc'::text, now())"))
  lastAttemptAt  DateTime?
  leaseOwner     String?
  leaseExpiresAt DateTime?
  // Event-specific staleness: NULL = never goes stale. S4b decides per
  // eventType whether to set it (and how long it lasts); there is no global
  // cut-off in the schema.
  expiresAt      DateTime?
  lastErrorCode  String?
  lastError      String?
  failedAt       DateTime?

  // Milestone 8H — the worker's notification dispatch is one more consumer
  // of this same row (see NotificationDelivery below); this relation is
  // just the FK side of that, not a second outbox.
  notificationDeliveries NotificationDelivery[]

  // Milestone S0D-1 / S0D-2C-2 — the owning tenant. REQUIRED since
  // S0D-2C-2: every current producer (checkout, admin order advancement,
  // careers application submission, franchise inquiry submission) already
  // writes this from already-validated ownership — never from payload. No
  // default: aggregateType is polymorphic, so the migration backfill
  // resolves each row's parent by its own aggregateType rather than a
  // single JOIN. A genuinely platform-wide event (none exist today) would
  // need an explicit scope discriminator, not a nullable tenantId.
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  // Security 4C-2 — composite tenant key: lets child tables reference
  // (tenantId, id) so the database itself can refuse a cross-business link
  // (composite foreign keys arrive in Security 4C-3).
  @@unique([tenantId, id])
  @@index([status])
  @@index([aggregateType, aggregateId])
  @@index([tenantId])
}

// Milestone 8H — a worker-owned delivery log, NOT a second outbox/event
// queue. API business modules never write this table; only the worker
// does, at the moment it actually attempts a send, after claiming the
// triggering OutboxEvent. The @@unique below is the idempotency guard: at
// most one delivery attempt per (event, channel), so re-encountering the
// same OutboxEvent (a duplicate claim, a re-run) can never send twice —
// see NotificationDispatchService (apps/worker) for how it's used.
// Deliberately does not store message body/rendered content or
// credentials, only what's needed to know what was sent, to whom, and
// whether it succeeded.
model NotificationDelivery {
  id                String                     @id @default(uuid(7))
  outboxEventId     String
  outboxEvent       OutboxEvent                @relation(fields: [tenantId, outboxEventId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  channel           NotificationChannel
  recipient         String
  templateKey       String
  status            NotificationDeliveryStatus @default(PENDING)
  aggregateType     String
  aggregateId       String
  providerMessageId String?
  failureReason     String?
  createdAt         DateTime                   @default(now())
  sentAt            DateTime?

  // S4a — durable send intent, written by the future worker BEFORE it calls
  // the provider. sendStartedAt set with sentAt still null after the lease has
  // expired means the outcome is AMBIGUOUS (the provider may have accepted it);
  // a retry of an ambiguous attempt sets possibleDuplicate. Unused until S4b.
  // CHECK (migration): possibleDuplicate requires sendStartedAt.
  sendStartedAt     DateTime?
  possibleDuplicate Boolean   @default(false)

  // Milestone S0D-1 / S0D-2C-2 — the owning tenant. REQUIRED since
  // S0D-2C-2: copied from the triggering OutboxEvent's own tenantId (the
  // one authoritative chain — never a second, independently-resolved
  // source, never the worker's SINGLE_TENANT_ID). No default.
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([outboxEventId, channel])
  @@index([aggregateType, aggregateId])
  @@index([tenantId])
}

// Milestone S0D-2C-3 — tenant-owned notification recipient routing. WHERE a
// business notification (as opposed to a customer's own order notification
// — see NotificationDispatchService's Order case, which resolves the
// Order's own customer/guest email and never touches this table) gets sent
// is tenant-specific configuration, never a global process-wide value.
//
// `purpose` is a plain string, deliberately NOT a Prisma enum — the same
// convention as OutboxEvent.eventType / NotificationDelivery.templateKey.
// Today's two valid values (careers.application.received,
// franchising.inquiry.received — see NotificationRecipientPurpose in
// @mocha-house/contracts) are enforced at the application layer, so a
// future purpose never needs a migration. tenantId is REQUIRED FROM
// INCEPTION: this is a brand-new model, so there is no nullable window to
// convert and no backfill migration — unlike every tenantId column
// converted earlier in S0D-2.
//
// @@unique([tenantId, purpose]) deliberately allows exactly one recipient
// per tenant per purpose today. Supporting multiple recipients later is a
// constraint relaxation, not a redesign — NOT implemented now because
// nothing requires it yet.
//
// Missing configuration is a legitimate, intentional state, not an error
// to be defaulted away: unlike GiftCardConfiguration/LoyaltyConfiguration,
// nothing ever lazily upserts a default row here. A tenant with no row for
// a purpose means the worker fails that notification closed (ends up
// FAILED, no email sent) — it must NEVER fall back to another tenant's
// row, a global env var, or any other tenant's/default recipient.
model NotificationRecipient {
  id        String   @id @default(uuid(7))
  purpose   String
  email     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, purpose])
  @@index([tenantId])
}

// --- Milestone 5A, internal identity & admin authentication -----------
// A deliberately separate identity boundary from Customer. A production
// internal user authenticates against a dedicated Cognito user pool + app
// client (never the customer pool); the local-dev provider stands in when
// none is provisioned. Mocha House is authoritative for this record and
// its lifecycle. NO password or provider token is stored here.
//
// externalProvider + externalSubject is the provider-agnostic identity
// mapping (a plain string pair, never a provider SDK payload), mirroring
// Customer. externalSubject is nullable so an InternalUser can be created
// in the INVITED state before the person has ever authenticated — it is
// bound on the first successful authentication of an already-ACTIVE user
// and is never, on its own, treated as activation.
//
// Lifecycle: INVITED -> ACTIVE -> SUSPENDED/DISABLED (and back). Only
// ACTIVE confers internal/Admin access. Authentication never promotes
// INVITED to ACTIVE — that is an explicit administrative action, never a
// side effect of signing in.
enum InternalUserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  DISABLED
}

model InternalUser {
  id               String             @id @default(uuid(7))
  externalProvider String
  externalSubject  String?
  // Milestone S0D-2E — was globally @unique. An InternalUser row belongs to
  // exactly ONE tenant (there is no membership table; a human who
  // administers two tenants needs two separate rows — that is the existing
  // model, not something this milestone invents). A global email constraint
  // made that existing model internally inconsistent: it would forbid the
  // same person from ever administering a second tenant, for no reason tied
  // to any actual business rule. Scoped to (tenantId, email) instead — see
  // the matching unique index below.
  //
  // Milestone S0F — externalProvider/externalSubject is now unique PER
  // TENANT too: (tenantId, externalProvider, externalSubject). The verified
  // external identity is the human; each InternalUser row is that human's
  // membership of ONE business (ADR-4 amendment — no separate membership
  // table). One human may therefore hold at most one row per tenant, and a
  // multi-business administrator is simply the same verified identity bound
  // to a row in each business. Which row applies to a request is decided by
  // InternalAuthGuard from a validated active-business selection — never
  // by the identity alone.
  email            String
  displayName      String?
  status           InternalUserStatus @default(INVITED)

  // When the invitation record was created. `activatedAt` is set the first
  // time the account is moved to ACTIVE (administratively, or by the local
  // seed), never by authentication. `lastAuthenticatedAt` is updated only
  // on a successful ACTIVE authentication and is purely observational — it
  // can never widen access.
  invitedAt           DateTime  @default(now())
  activatedAt         DateTime?
  lastAuthenticatedAt DateTime?
  // SC3c-3 — the address the identity provider last asserted as VERIFIED
  // for this person (lower-cased) and when. Billing email goes only to an
  // address verified recently AND still equal to `email`; a historical
  // sign-in alone is never permanent proof.
  verifiedEmail       String?
  emailVerifiedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roleAssignments               InternalUserRoleAssignment[]
  auditEventsActed              InternalAuditEvent[]         @relation("InternalAuditEventActor")
  reconciliationCasesAssigned   PaymentReconciliationCase[]  @relation("PaymentReconciliationAssignee")
  reconciliationEventsActed     PaymentReconciliationEvent[] @relation("PaymentReconciliationEventActor")
  // R1 / S5a — the order closures this user performed and the refund
  // obligations this user settled by hand.
  orderClosuresActed            OrderClosure[]               @relation("OrderClosureActor")
  orderRefundsSettled           OrderRefundObligation[]      @relation("OrderRefundObligationSettledBy")
  // Milestone 7A — the manual Mocha Bean adjustments this HQ user performed.
  // onDelete: Restrict (see MochaBeanLedgerEntry) so an internal user who
  // has moved customer Beans cannot be hard-deleted and orphan that record.
  mochaBeanAdjustments          MochaBeanLedgerEntry[]       @relation("MochaBeanLedgerActor")
  // Milestone 6B — the checklist items this user is the CURRENT completion
  // actor for. onDelete: Restrict (see ChecklistInstanceItem) mirrors the
  // audit-actor relation: an internal user who has completed operational
  // work cannot be hard-deleted, so that record can never be orphaned.
  checklistItemsCompleted       ChecklistInstanceItem[]      @relation("ChecklistItemCompletedBy")
  // Milestone 6C — the checklist items this user is the CURRENT management
  // exception actor for, and the operational tasks they created / completed.
  // All onDelete: Restrict, for the same integrity reason.
  checklistItemsExcepted        ChecklistInstanceItem[]      @relation("ChecklistItemExceptionBy")
  operationsTasksCreated        OperationsTask[]             @relation("OperationsTaskCreatedBy")
  operationsTasksCompleted      OperationsTask[]             @relation("OperationsTaskCompletedBy")
  // Milestone 7F — the gift-card ledger entries this HQ user performed
  // (issuance and manual balance corrections). onDelete: Restrict (see
  // GiftCardTransaction) so an internal user who has moved stored value
  // cannot be hard-deleted and orphan that financial record.
  giftCardTransactionsActed     GiftCardTransaction[]        @relation("GiftCardTransactionActor")
  // Milestone 8A — internal CRM notes this HQ user authored. onDelete:
  // Restrict (see CustomerNote) mirrors the audit-actor relation: an
  // internal user who has authored CRM history cannot be hard-deleted and
  // orphan that record.
  customerNotesAuthored         CustomerNote[]               @relation("CustomerNoteAuthor")
  // Milestone 8C — internal applicant notes this HQ user authored. Same
  // onDelete: Restrict integrity reason.
  jobApplicationNotesAuthored   JobApplicationNote[]         @relation("JobApplicationNoteAuthor")
  // Milestone 8D — internal franchise-inquiry notes this HQ user authored.
  // Same onDelete: Restrict integrity reason.
  franchiseInquiryNotesAuthored FranchiseInquiryNote[]       @relation("FranchiseInquiryNoteAuthor")
  // Milestone 8F — media assets this HQ user uploaded. Same onDelete:
  // Restrict integrity reason.
  mediaAssetsUploaded           MediaAsset[]                 @relation("MediaAssetUploader")
  // Milestone 8J — approval requests this HQ user made and decided. Same
  // onDelete: Restrict integrity reason; also structurally prevents a
  // requester and decider from ever being reconciled to "nobody" in a way
  // that would hide who made which side of a decision.
  approvalRequestsMade          ApprovalRequest[]            @relation("ApprovalRequester")
  approvalRequestsDecided       ApprovalRequest[]            @relation("ApprovalDecider")
  billingContactFor             TenantBillingContact?        @relation("TenantBillingContactUser")

  // Milestone S0D-2E — the owning tenant. REQUIRED: this is the internal
  // identity/authorization chain's root, converted together with
  // InternalRole / InternalRolePermission / InternalUserRoleAssignment so
  // AuthorizationService can evaluate every grant within one trusted tenant
  // boundary. No default: every existing row was already Tenant #1 (the
  // single-tenant era's only tenant).
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, externalProvider, externalSubject])
  @@unique([tenantId, email])
  // Security 4C-2 — composite tenant key: lets child tables reference
  // (tenantId, id) so the database itself can refuse a cross-business link
  // (composite foreign keys arrive in Security 4C-3).
  @@unique([tenantId, id])
  @@index([tenantId])
  // Milestone S0F — the identity -> memberships lookup runs BEFORE any
  // tenant is known, so it needs an index that does not lead with tenantId.
  @@index([externalProvider, externalSubject])
}

// --- Milestone 5E-3, access-control audit foundation ------------------
// The durable, synchronous history of security-sensitive Admin writes. Not
// an OutboxEvent (that is an async processing queue) and not an event bus —
// this is application history, written in the SAME transaction as the change
// it records, so "the change happened" and "the change was recorded" can
// never disagree.
//
// Deliberately minimal and general-purpose: `action` names the event
// (e.g. "user.status_changed"), `targetType` + `targetId` are a polymorphic
// reference (no FK — a future event may target a role or an assignment), and
// before/after are small JSON snapshots. `reason` is required for every
// event. No IP/device metadata, no diff engine, no retention policy — those
// are not needed for the foundation.
//
// The ACTOR is always an InternalUser and the relation is onDelete: Restrict:
// an internal user who has authored audit events cannot be deleted, so audit
// history can never be orphaned or silently destroyed. The product never
// hard-deletes internal users anyway (DISABLED is terminal), so Restrict
// creates no real operational problem and gives the strongest integrity.
model InternalAuditEvent {
  id                  String   @id @default(uuid(7))
  actorInternalUserId String
  action              String
  targetType          String
  targetId            String
  beforeData          Json?
  afterData           Json?
  reason              String
  createdAt           DateTime @default(now())

  actorInternalUser InternalUser @relation("InternalAuditEventActor", fields: [tenantId, actorInternalUserId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  // Milestone S0D-1 — the owning tenant. REQUIRED since tenant isolation
  // phase 2: every write supplies it explicitly (root writes from the
  // request's TenantContext, child writes from a validated parent). No
  // default.
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([targetType, targetId])
  @@index([actorInternalUserId])
  @@index([createdAt])
  @@index([tenantId])
}

// --- Milestone 5B, internal authorization (roles, permissions, scope) --
// The authorization backbone. An authorization decision is:
//   ACTIVE internal user  +  required permission  +  authorized scope.
// Never a role-name check. Role names are business configuration; the
// decision is made purely from effective permission keys and the scopes
// they are granted through.
//
// Permission VOCABULARY is a closed set defined in code
// (@mocha-house/contracts INTERNAL_PERMISSION_KEYS) — there is deliberately
// no Permission table, so a permission string only means something if
// server code checks that exact key. Roles, their permission keys, and
// user assignments are the data below.

// Only the scope types the application currently resolves. Additional
// organizational scope types are added here only once their domain models
// (e.g. location groups, franchise organizations) exist.
enum InternalScopeType {
  CORPORATE
  LOCATION
}

// A reusable bundle of permission keys. `key` is the stable programmatic
// identifier (e.g. "platform-administrator"); `displayName` is for humans.
// `isSystem` marks a built-in role that a future administration UI must
// protect from destructive edits — it is metadata ONLY and confers no
// authorization by itself.
model InternalRole {
  id          String   @id @default(uuid(7))
  // Milestone S0D-2E — was globally @unique. The same inconsistency as
  // InternalUser.email: a role "key" (e.g. "platform-administrator",
  // "store-manager") is tenant configuration, and a global constraint would
  // mean only ONE tenant across the whole platform could ever use a given
  // key — an accidental cross-tenant coupling left over from the
  // single-tenant era, not a real business rule. Scoped to (tenantId, key).
  key         String
  displayName String
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions InternalRolePermission[]
  assignments InternalUserRoleAssignment[]

  // Milestone S0D-2E — the owning tenant. REQUIRED (see InternalUser).
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, key])
  // Security 4C-2 — composite tenant key: lets child tables reference
  // (tenantId, id) so the database itself can refuse a cross-business link
  // (composite foreign keys arrive in Security 4C-3).
  @@unique([tenantId, id])
  @@index([tenantId])
}

// One permission key granted by one role. `permissionKey` is a plain string
// validated against the code vocabulary at read time — an unknown key never
// grants a capability (there is no code path that honours it) and is
// dropped defensively when building an authorization context.
model InternalRolePermission {
  roleId        String
  permissionKey String
  createdAt     DateTime @default(now())

  role InternalRole @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Cascade, onUpdate: Restrict)

  // Milestone S0D-2E — the owning tenant. REQUIRED, copied from the owning
  // InternalRole (the same authoritative-parent pattern as every other
  // tenant-owned child in S0D-2).
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([roleId, permissionKey])
  @@index([permissionKey])
  @@index([tenantId])
}

// A role granted to an internal user within one scope. The same user may
// hold the same role at several LOCATION scopes and a different role at
// CORPORATE scope simultaneously — each is its own row. Scope invariants
// (CORPORATE => scopeId null; LOCATION => scopeId is a Location id) are
// enforced in application logic, not the schema, because scopeId is a
// deliberately polymorphic reference.
model InternalUserRoleAssignment {
  id             String            @id @default(uuid(7))
  internalUserId String
  roleId         String
  scopeType      InternalScopeType
  scopeId        String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  internalUser InternalUser @relation(fields: [tenantId, internalUserId], references: [tenantId, id], onDelete: Cascade, onUpdate: Restrict)
  role         InternalRole @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  // Security 4C-5 — a LOCATION assignment's scopeId is a Location of the
  // SAME business (composite foreign key); CORPORATE leaves it null. A CHECK
  // constraint (migration) keeps scopeType and scopeId consistent, and a
  // partial unique index allows one CORPORATE grant per user and role.
  location     Location?    @relation(fields: [tenantId, scopeId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  // Milestone S0D-2E — the owning tenant. REQUIRED, copied from the
  // assigned InternalUser — the same authoritative-parent pattern as every
  // other tenant-owned child. The application layer (not a composite FK —
  // that is S0D-4) additionally verifies the assigned InternalRole belongs
  // to this SAME tenant before an assignment is ever created, so these two
  // parents can never legitimately disagree.
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([internalUserId, roleId, scopeType, scopeId])
  @@index([internalUserId])
  @@index([roleId])
  @@index([tenantId])
}

// --- Milestone 6B, Store Operations: the Opening Checklist ------------
// The first real Store Operations workflow. Deliberately the minimum
// domain: a corporate template, its items, one instance per location per
// business day, and the instance's item rows.
//
// HISTORICAL STRATEGY — SNAPSHOT BY VALUE. When a location first opens
// today's checklist (lazily, on GET) the ACTIVE template items are copied
// BY VALUE (section, label, sortOrder) into ChecklistInstanceItem rows.
// ChecklistInstanceItem has NO foreign key back to ChecklistTemplateItem —
// once created, an instance never re-reads the template. Future HQ edits
// (6B-2: wording, order, turning an item off/on) therefore affect only
// instances created afterwards. There is no template-version table.

// The corporate checklist standard. 6B seeds exactly one row (key
// "opening"). `isActive` on the template is configuration for a future HQ
// control; there is no editing UI in 6B.
model ChecklistTemplate {
  id        String   @id @default(uuid(7))
  key       String
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items     ChecklistTemplateItem[]
  instances ChecklistInstance[]

  // Milestone S0D-1 / S0D-2A — the owning tenant. REQUIRED since S0D-2A:
  // every write supplies it explicitly (root writes from the request's
  // TenantContext, child writes from a validated parent). No default.
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, key])
  // Security 4C-2 — composite tenant key: lets child tables reference
  // (tenantId, id) so the database itself can refuse a cross-business link
  // (composite foreign keys arrive in Security 4C-3).
  @@unique([tenantId, id])
  @@index([tenantId])
}

// One configured line of a checklist template. `isActive` is the
// foundation for HQ to toggle individual items on/off in 6B-2: only
// isActive items are copied into a NEW instance. Toggling it NEVER touches
// an already-created ChecklistInstanceItem.
model ChecklistTemplateItem {
  id         String   @id @default(uuid(7))
  templateId String
  section    String
  label      String
  sortOrder  Int
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  template ChecklistTemplate @relation(fields: [tenantId, templateId], references: [tenantId, id], onDelete: Cascade, onUpdate: Restrict)

  // Milestone S0D-1 / S0D-2A — the owning tenant. REQUIRED since S0D-2A:
  // every write supplies it explicitly (root writes from the request's
  // TenantContext, child writes from a validated parent). No default.
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([templateId])
  @@index([tenantId])
}

// One location's checklist for one business day. Created lazily on the
// first GET. `businessDate` is stored explicitly (@db.Date) — resolved
// once, at creation, from the Mocha House business timezone
// (America/Detroit) — never re-derived from createdAt afterwards. The
// unique constraint is what makes lazy creation race-safe: two devices
// opening at once collide on it, and the loser re-reads the winner.
// `completedAt` is a derived projection of "every item is RESOLVED" — an
// item is resolved by a normal completion OR (Milestone 6C) a logged
// management exception. Kept on the row so progress reads need no
// aggregate; set when the last item is resolved and cleared when an Undo /
// Clear Exception makes the checklist incomplete again. There is no status
// enum.
model ChecklistInstance {
  id           String    @id @default(uuid(7))
  templateId   String
  locationId   String
  businessDate DateTime  @db.Date
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  template ChecklistTemplate       @relation(fields: [tenantId, templateId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  location Location                @relation(fields: [tenantId, locationId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  items    ChecklistInstanceItem[]

  // Milestone S0D-1 / S0D-2A — the owning tenant. REQUIRED since S0D-2A:
  // every write supplies it explicitly (root writes from the request's
  // TenantContext, child writes from a validated parent). No default.
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([templateId, locationId, businessDate])
  // Security 4C-2 — composite tenant key: lets child tables reference
  // (tenantId, id) so the database itself can refuse a cross-business link
  // (composite foreign keys arrive in Security 4C-3).
  @@unique([tenantId, id])
  @@index([locationId, businessDate])
  @@index([tenantId])
}

// The historical snapshot AND the current resolution record for one line of
// one instance. section/label/sortOrder are copied by value at creation.
//
// An item is resolved in exactly ONE of two mutually exclusive ways:
//   - NORMAL COMPLETION — completedByInternalUserId + completedAt, set
//     together on Complete, cleared together on Undo.
//   - MANAGEMENT EXCEPTION (Milestone 6C) — exceptionReason +
//     exceptionByInternalUserId + exceptionAt, set together on Log
//     Exception, cleared together on Clear Exception. Used when the
//     requirement genuinely could not be completed; it is NOT a normal
//     completion and every projection keeps the two visibly distinct.
// The service enforces that the two never overlap: Complete is rejected on
// an exception-resolved item and Log Exception is rejected on a completed
// item (clear/undo back to "open" first).
//
// Because Undo / Clear reset these fields, 6B/6C keep no event-by-event
// history of completion cycles here — the significant management decision
// (log / clear an exception) is recorded in InternalAuditEvent instead.
model ChecklistInstanceItem {
  id                        String    @id @default(uuid(7))
  checklistInstanceId       String
  section                   String
  label                     String
  sortOrder                 Int
  completedByInternalUserId String?
  completedAt               DateTime?
  exceptionReason           String?
  exceptionByInternalUserId String?
  exceptionAt               DateTime?
  createdAt                 DateTime  @default(now())

  checklistInstance ChecklistInstance @relation(fields: [tenantId, checklistInstanceId], references: [tenantId, id], onDelete: Cascade, onUpdate: Restrict)
  completedBy       InternalUser?     @relation("ChecklistItemCompletedBy", fields: [tenantId, completedByInternalUserId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  exceptionBy       InternalUser?     @relation("ChecklistItemExceptionBy", fields: [tenantId, exceptionByInternalUserId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  // Milestone S0D-1 / S0D-2A — the owning tenant. REQUIRED since S0D-2A:
  // every write supplies it explicitly (root writes from the request's
  // TenantContext, child writes from a validated parent). No default.
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([checklistInstanceId])
  @@index([completedByInternalUserId])
  @@index([exceptionByInternalUserId])
  @@index([tenantId])
}

// --- Milestone 6C, Store Operations: Today's Tasks -------------------
// A simple, location-scoped operational to-do for ONE America/Detroit
// business date. Deliberately the minimum: a title, an optional note, who
// created it, and the current completion actor/time. There is NO priority,
// due time, assignee, category, recurrence, or rollover — a task belongs
// only to `businessDate` and is never carried forward. "Open" vs "Done" is
// derived purely from `completedAt`; there is no status enum.
//
// Not tied to any template or checklist. Not an audit surface — routine
// task add/complete/reopen/delete are not recorded in InternalAuditEvent.
// Hard delete is allowed (a mistaken same-day task, unlike a checklist
// template item, has no "inactive" concept and just clutters the day).
model OperationsTask {
  id                        String    @id @default(uuid(7))
  locationId                String
  businessDate              DateTime  @db.Date
  title                     String
  note                      String?
  createdByInternalUserId   String
  completedByInternalUserId String?
  completedAt               DateTime?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  location    Location      @relation(fields: [tenantId, locationId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  createdBy   InternalUser  @relation("OperationsTaskCreatedBy", fields: [tenantId, createdByInternalUserId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  completedBy InternalUser? @relation("OperationsTaskCompletedBy", fields: [tenantId, completedByInternalUserId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  // Milestone S0D-1 / S0D-2A — the owning tenant. REQUIRED since S0D-2A:
  // every write supplies it explicitly (root writes from the request's
  // TenantContext, child writes from a validated parent). No default.
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([locationId, businessDate])
  @@index([createdByInternalUserId])
  @@index([completedByInternalUserId])
  @@index([tenantId])
}

// --- Milestone 7A, Mocha Beans foundation ----------------------------
// "Mocha Beans" is the official customer-facing loyalty currency. This is
// the minimum safe, ledger-backed foundation: earning on a successful
// authenticated Order, plus manual HQ add/deduct. Rewards, redemption,
// bonus campaigns, expiration, customer-facing history and any refund /
// reversal behaviour are deliberately NOT here — they arrive in later
// bounded slices, and the ledger gains new entry types only when the
// capability that writes them actually ships.
//
// A Bean has no fractional unit: every amount is a whole signed integer.

enum MochaBeanEntryType {
  // A qualifying purchase: earned on Order.subtotal AFTER any loyalty
  // reward discount, whole qualifying dollars only, at the configured
  // rate. Written in the SAME transaction that creates the Order, and only
  // when the Order has a customerId (guests never earn).
  EARN
  // An HQ operator manually added or deducted Beans. Always carries a
  // trimmed non-empty `reason` and an `actorInternalUserId`, and is
  // mirrored by an InternalAuditEvent written in the same transaction.
  MANUAL_ADJUSTMENT
  // Milestone 7C — Beans spent to redeem ONE Mocha Bean reward on an order.
  // `amount` is negative (the reward's full configured beanCost), `orderId`
  // is set, and the entry is written in the SAME transaction as the Order
  // and the OrderLoyaltyRewardRedemption snapshot. @@unique([type, orderId])
  // makes it exactly-once per order.
  REDEEM
  // Milestone 7D — additional Beans awarded by one or more Bonus Mocha Bean
  // Promotions on a qualifying order. `amount` is positive (the sum of every
  // qualifying item's bonus), `orderId` is set, and the entry is written in
  // the SAME transaction as the Order, the standard EARN entry and the
  // OrderLoyaltyBonus snapshot. @@unique([type, orderId]) makes it
  // exactly-once per order. It is separate from EARN so HQ accounting can
  // see standard vs promotional earning at a glance.
  BONUS_EARN
  // R1 / S5a — the three reversals a rejected or cancelled order can need.
  // Each is exactly-once per order through @@unique([type, orderId]); each
  // has `orderId` and `actorInternalUserId` set. They are separate types
  // (not one generic reversal) because that unique key allows one row per
  // type per order. NOTHING writes them in S5a.
  //   REDEEM_REVERSAL     Beans RETURNED to the customer for a redeemed
  //                       reward; `amount` is positive.
  //   EARN_REVERSAL       Beans RECOVERED that the order had earned;
  //                       `amount` is negative.
  //   BONUS_EARN_REVERSAL Bonus Beans RECOVERED; `amount` is negative.
  // A recovery is clamped at the account's current balance (it never goes
  // below zero); the part that could not be recovered is the SHORTFALL,
  // recorded on OrderClosure.loyaltyShortfallBeans so the ledger, the
  // balance and the closure always reconcile (earned - recovered =
  // shortfall) instead of leaving an unexplained difference.
  REDEEM_REVERSAL
  EARN_REVERSAL
  BONUS_EARN_REVERSAL
}

// One row per Customer. `balance` is a materialized projection of the sum
// of this account's ledger entries — kept on the row (the same pattern as
// Order.status ↔ OrderStatusHistory) so a balance read needs no aggregate,
// and, more importantly, so there is a single row to lock (SELECT ... FOR
// UPDATE) when a future redemption slice must enforce its non-negative
// invariant under concurrency. Created lazily (upsert on customerId) the
// first time the customer earns or is adjusted.
model CustomerLoyaltyAccount {
  id         String   @id @default(uuid(7))
  customerId String   @unique
  balance    Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  customer Customer               @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Cascade, onUpdate: Restrict)
  entries  MochaBeanLedgerEntry[]
  // No @@index([customerId]) — `customerId @unique` above already indexes it.

  // Milestone S0D-1 — the owning tenant. REQUIRED since tenant isolation
  // phase 2: every write supplies it explicitly (root writes from the
  // request's TenantContext, child writes from a validated parent). No
  // default.
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  // Security 4C-2 — composite tenant key: lets child tables reference
  // (tenantId, id) so the database itself can refuse a cross-business link
  // (composite foreign keys arrive in Security 4C-3).
  @@unique([tenantId, id])
  // Security 4C-4 — the one-to-one composite relation needs its key
  // unique together with tenantId (the column alone already is).
  @@unique([tenantId, customerId])
  @@index([tenantId])
}

// Append-oriented Mocha Bean transaction history — the authoritative record
// of every Bean movement. The service never updates or deletes a row here
// (mirrors OrderStatusHistory / InternalAuditEvent). `amount` is signed:
// positive for EARN and for a positive MANUAL_ADJUSTMENT, negative for a
// deduction. Every balance-changing write inserts one row here AND updates
// CustomerLoyaltyAccount.balance by the same signed delta inside one
// transaction, so the ledger and the materialized balance can never
// disagree.
//
// Idempotency:
//   - @@unique([type, orderId]) makes EARN exactly-once per Order (NULLs
//     are distinct in Postgres, so MANUAL_ADJUSTMENT rows with a null
//     orderId are unaffected).
//   - @@unique([type, operationKey]) makes a manual adjustment idempotent
//     on its caller-supplied operationKey; a retry with the same key
//     returns the existing row instead of applying the change twice.
model MochaBeanLedgerEntry {
  id                  String             @id @default(uuid(7))
  loyaltyAccountId    String
  type                MochaBeanEntryType
  // Signed whole Beans. The resulting account balance is never allowed
  // below zero (enforced in the service, before the write).
  amount              Int
  // Required (trimmed, non-empty) for MANUAL_ADJUSTMENT; null for EARN.
  reason              String?
  // Set for EARN, REDEEM and BONUS_EARN (and for a future EARN reversal).
  // onDelete: SetNull keeps the ledger entry — and the balance it accounts
  // for — intact even if the Order is later removed, exactly like
  // Order.customerId.
  orderId             String?
  // Set for MANUAL_ADJUSTMENT: the HQ operator who performed it.
  actorInternalUserId String?
  // Caller-supplied idempotency key for MANUAL_ADJUSTMENT; null for EARN
  // (EARN is keyed by orderId instead).
  operationKey        String?
  createdAt           DateTime           @default(now())

  loyaltyAccount    CustomerLoyaltyAccount @relation(fields: [tenantId, loyaltyAccountId], references: [tenantId, id], onDelete: Cascade, onUpdate: Restrict)
  order             Order?                 @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: SetNull, onUpdate: Restrict)
  actorInternalUser InternalUser?          @relation("MochaBeanLedgerActor", fields: [tenantId, actorInternalUserId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  // Milestone S0D-1 — the owning tenant. REQUIRED since tenant isolation
  // phase 2: every write supplies it explicitly (root writes from the
  // request's TenantContext, child writes from a validated parent). No
  // default.
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([type, orderId])
  @@unique([tenantId, type, operationKey])
  @@index([loyaltyAccountId, createdAt])
  @@index([orderId])
  @@index([actorInternalUserId])
  @@index([tenantId])
}

// --- Milestone 7B, HQ loyalty configuration + Rewards Catalog --------
// 7B gives HQ two controls: the company-wide Mocha Bean earning rate, and
// the customer Rewards Catalog. It deliberately does NOT touch redemption —
// customers cannot redeem, no Beans are deducted, and there are no
// redemption/snapshot tables yet (that is 7C).

// The single company-wide loyalty configuration. Modelled as a keyed
// singleton (like ChecklistTemplate): every code path uses key "company",
// so the @unique key is the "exactly one active configuration" invariant.
// Seeded, and also lazily upserted by LoyaltySettingsService so a fresh
// database (or a test that skips the seed) still has a safe default.
model LoyaltyConfiguration {
  id                   String   @id @default(uuid(7))
  key                  String
  // Whole Mocha Beans awarded per whole qualifying dollar. Default 1
  // preserves the 7A behaviour exactly. Company-wide only — never
  // per-location, per-segment or time-based. Changing it affects only
  // FUTURE earning; historical EARN ledger entries are never recalculated.
  earningRatePerDollar Int      @default(1)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  // Milestone S0D-1 — the owning tenant. REQUIRED since tenant isolation
  // phase 2: every write supplies it explicitly (root writes from the
  // request's TenantContext, child writes from a validated parent). No
  // default.
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, key])
  @@index([tenantId])
}

enum LoyaltyRewardType {
  // A fixed dollar-off discount, redeemable later with Mocha Beans. The
  // discount value is `fixedAmountMinorUnits` (integer cents). Never
  // creates cash value; the future redemption slice caps it at the
  // eligible merchandise amount.
  FIXED_AMOUNT
  // A specific free item, redeemable later with Mocha Beans. Eligibility is
  // one or more Products and/or Categories (LoyaltyRewardProduct /
  // LoyaltyRewardCategory) — never raw display text.
  FREE_ITEM
}

// One HQ-defined reward customers will later be able to redeem with Mocha
// Beans. 7B manages the catalog only. Rewards are never hard-deleted
// (isActive is the off switch) so a future redemption record can always
// still point at the reward it used. `type` is fixed at creation — it is
// never editable, so the type-specific fields can never become
// inconsistent.
model LoyaltyReward {
  id                    String            @id @default(uuid(7))
  name                  String
  description           String?
  type                  LoyaltyRewardType
  // Whole Mocha Beans the customer will later spend to redeem this reward.
  beanCost              Int
  // FIXED_AMOUNT only — the dollar-off value in integer minor units (cents),
  // always > 0. Null for FREE_ITEM.
  fixedAmountMinorUnits Int?
  isActive              Boolean           @default(true)
  // Ascending display order for the customer catalog and the Admin list.
  sortOrder             Int               @default(0)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  eligibleProducts   LoyaltyRewardProduct[]
  eligibleCategories LoyaltyRewardCategory[]

  // Milestone S0D-1 — the owning tenant. REQUIRED since tenant isolation
  // phase 2: every write supplies it explicitly (root writes from the
  // request's TenantContext, child writes from a validated parent). No
  // default.
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  // Security 4C-2 — composite tenant key: lets child tables reference
  // (tenantId, id) so the database itself can refuse a cross-business link
  // (composite foreign keys arrive in Security 4C-3).
  @@unique([tenantId, id])
  @@index([isActive, sortOrder])
  @@index([tenantId])
}

// FREE_ITEM eligibility by Product. onDelete: Cascade from the reward (a
// join row is meaningless without it); onDelete: Restrict from the Product
// so a catalog product that a reward depends on cannot be hard-deleted out
// from under it (the catalog uses isActive anyway).
model LoyaltyRewardProduct {
  rewardId  String
  productId String
  createdAt DateTime @default(now())

  reward  LoyaltyReward @relation(fields: [tenantId, rewardId], references: [tenantId, id], onDelete: Cascade, onUpdate: Restrict)
  product Product       @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  // Milestone S0D-1 — the owning tenant. REQUIRED since tenant isolation
  // phase 2: every write supplies it explicitly (root writes from the
  // request's TenantContext, child writes from a validated parent). No
  // default.
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([rewardId, productId])
  @@index([productId])
  @@index([tenantId])
}

// FREE_ITEM eligibility by Category — same delete semantics as
// LoyaltyRewardProduct.
model LoyaltyRewardCategory {
  rewardId   String
  categoryId String
  createdAt  DateTime @default(now())

  reward   LoyaltyReward @relation(fields: [tenantId, rewardId], references: [tenantId, id], onDelete: Cascade, onUpdate: Restrict)
  category Category      @relation(fields: [tenantId, categoryId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  // Milestone S0D-1 — the owning tenant. REQUIRED since tenant isolation
  // phase 2: every write supplies it explicitly (root writes from the
  // request's TenantContext, child writes from a validated parent). No
  // default.
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([rewardId, categoryId])
  @@index([categoryId])
  @@index([tenantId])
}

// --- Milestone 7C, Mocha Bean reward redemption --------------------
// The immutable record of the ONE Mocha Bean reward redeemed on an order.
// Written in the SAME transaction as the Order, the REDEEM ledger entry and
// the EARN ledger entry — never split into independent commits.
//
// SNAPSHOT BY VALUE (the OrderLine philosophy): rewardName / rewardType /
// beanCost / discountMinorUnits / freeItem* are copied here at redemption
// time and never re-read from LoyaltyReward. Later HQ edits to the reward
// (name, cost, value, eligibility, active state) therefore never change a
// completed order. `sourceRewardId` is a plain reference string (like
// OrderLine.productId — no foreign key), kept only so history can point at
// the reward it came from; it is NEVER trusted for display or accounting.
//
// `orderId @unique` is both the "one reward per order" invariant and the
// idempotency anchor: a checkout replay re-uses the same Order (or none),
// so this row — and the REDEEM entry — can be created at most once.
model OrderLoyaltyRewardRedemption {
  id      String @id @default(uuid(7))
  orderId String @unique
  order   Order  @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  // Plain reference to the reward this came from. Nullable and un-joined on
  // purpose — the snapshot below is authoritative.
  sourceRewardId String?

  // Immutable snapshot.
  rewardName          String
  rewardType          LoyaltyRewardType
  // Mocha Beans actually deducted (the reward's full configured beanCost —
  // never prorated by how much of the discount was usable).
  beanCost            Int
  // Discount actually applied to the gross merchandise subtotal, in integer
  // minor units. For FIXED_AMOUNT: min(reward value, gross subtotal). For
  // FREE_ITEM: the unit price of the single freed unit.
  discountMinorUnits  Int
  // FREE_ITEM only — the cart product one unit of which was made free (the
  // lowest-priced eligible unit). Plain snapshot strings, no FK, mirroring
  // OrderLine.productId.
  freeItemProductId   String?
  freeItemProductName String?

  createdAt DateTime @default(now())

  // Milestone S0D-1 — the owning tenant. REQUIRED since tenant isolation
  // phase 2: every write supplies it explicitly (root writes from the
  // request's TenantContext, child writes from a validated parent). No
  // default.
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  // Security 4C-4 — the one-to-one composite relation needs its key
  // unique together with tenantId (the column alone already is).
  @@unique([tenantId, orderId])
  @@index([sourceRewardId])
  // Security 4C-6 — the deleted-product-id reuse guard looks product
  // snapshots up by this column.
  @@index([freeItemProductId])
  @@index([tenantId])
}

// --- Milestone 7D, Bonus Mocha Beans Promotions --------------------
// HQ-defined, deliberately simple product-based Bean bonus campaigns. NOT a
// generic promotion/rules engine: two bonus types, product targeting only,
// optional flat date window, all-or-selected locations. A promotion never
// discounts money — it only awards extra Mocha Beans on qualifying items of
// a successful order. Promotions are never hard-deleted (isActive is the
// off switch) so a historical OrderLoyaltyBonusItem can always still point
// at the promotion it used.

enum LoyaltyBonusPromotionType {
  // A flat, additive bonus: `bonusValue` whole Mocha Beans for every
  // qualifying PAID unit of an eligible product (a unit made free by a
  // FREE_ITEM loyalty reward does not qualify). Never derived from price.
  EXTRA_BEANS
  // The qualifying item's TOTAL earning becomes `bonusValue` times its
  // standard earning (`bonusValue` >= 2). The BONUS_EARN contribution is
  // therefore `standardItemBeans * (bonusValue - 1)`, computed on the
  // item's post-discount qualifying spend at the configured company rate.
  MULTIPLIER
}

model LoyaltyBonusPromotion {
  id                    String                    @id @default(uuid(7))
  name                  String
  type                  LoyaltyBonusPromotionType
  // EXTRA_BEANS: whole Beans per qualifying paid unit (1..100000).
  // MULTIPLIER: whole multiple of standard item earning (2..10).
  bonusValue            Int
  isActive              Boolean                   @default(true)
  // Optional active window. A promotion is eligible for an order only when
  // isActive AND (startsAt is null OR startsAt <= orderTime) AND
  // (endsAt is null OR orderTime < endsAt) — end-exclusive.
  startsAt              DateTime?
  endsAt                DateTime?
  // true  -> applies at every location; no join rows are required.
  // false -> applies only at the locations in `eligibleLocations`.
  appliesToAllLocations Boolean                   @default(false)
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt

  eligibleProducts  LoyaltyBonusPromotionProduct[]
  eligibleLocations LoyaltyBonusPromotionLocation[]
  // Milestone 8G — Campaigns that reference this bonus promotion as an
  // optional benefit. Campaign.onDelete is Restrict, so a promotion linked
  // by a Campaign cannot be hard-deleted (it never is anyway — isActive is
  // the off switch). Purely referential: a Campaign never mutates or
  // duplicates this promotion's own bonus logic.
  campaigns         Campaign[]

  // Milestone S0D-1 — the owning tenant. REQUIRED since tenant isolation
  // phase 2: every write supplies it explicitly (root writes from the
  // request's TenantContext, child writes from a validated parent). No
  // default.
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  // Security 4C-2 — composite tenant key: lets child tables reference
  // (tenantId, id) so the database itself can refuse a cross-business link
  // (composite foreign keys arrive in Security 4C-3).
  @@unique([tenantId, id])
  @@index([isActive])
  @@index([tenantId])
}

// Product targeting. onDelete: Cascade from the promotion (a join row is
// meaningless without it); onDelete: Restrict from the Product so a catalog
// product a promotion depends on cannot be hard-deleted out from under it.
model LoyaltyBonusPromotionProduct {
  promotionId String
  productId   String
  createdAt   DateTime @default(now())

  promotion LoyaltyBonusPromotion @relation(fields: [tenantId, promotionId], references: [tenantId, id], onDelete: Cascade, onUpdate: Restrict)
  product   Product               @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  // Milestone S0D-1 — the owning tenant. REQUIRED since tenant isolation
  // phase 2: every write supplies it explicitly (root writes from the
  // request's TenantContext, child writes from a validated parent). No
  // default.
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([promotionId, productId])
  @@index([productId])
  @@index([tenantId])
}

// Selected-location targeting — only present when appliesToAllLocations is
// false. Same delete semantics as LoyaltyBonusPromotionProduct.
model LoyaltyBonusPromotionLocation {
  promotionId String
  locationId  String
  createdAt   DateTime @default(now())

  promotion LoyaltyBonusPromotion @relation(fields: [tenantId, promotionId], references: [tenantId, id], onDelete: Cascade, onUpdate: Restrict)
  location  Location              @relation(fields: [tenantId, locationId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  // Milestone S0D-1 — the owning tenant. REQUIRED since tenant isolation
  // phase 2: every write supplies it explicitly (root writes from the
  // request's TenantContext, child writes from a validated parent). No
  // default.
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([promotionId, locationId])
  @@index([locationId])
  @@index([tenantId])
}

// The immutable per-order snapshot of the bonus Mocha Beans awarded.
// Written in the SAME transaction as the Order, the REDEEM/EARN ledger
// entries and the single positive BONUS_EARN ledger entry — never split
// into independent commits. Historical orders never change when HQ later
// edits or deactivates a promotion; every value here is copied by value.
//
// `orderId @unique` is both the "one bonus record per order" invariant and
// the idempotency anchor: a checkout replay re-uses the same Order (or
// none), so this row — and the BONUS_EARN entry — is created at most once.
model OrderLoyaltyBonus {
  id              String   @id @default(uuid(7))
  orderId         String   @unique
  order           Order    @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  // Sum of every item's bonusBeans — equals the BONUS_EARN ledger amount.
  totalBonusBeans Int
  createdAt       DateTime @default(now())

  items OrderLoyaltyBonusItem[]

  // Milestone S0D-1 — the owning tenant. REQUIRED since tenant isolation
  // phase 2: every write supplies it explicitly (root writes from the
  // request's TenantContext, child writes from a validated parent). No
  // default.
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  // Security 4C-2 — composite tenant key: lets child tables reference
  // (tenantId, id) so the database itself can refuse a cross-business link
  // (composite foreign keys arrive in Security 4C-3).
  @@unique([tenantId, id])
  // Security 4C-4 — the one-to-one composite relation needs its key
  // unique together with tenantId (the column alone already is).
  @@unique([tenantId, orderId])
  @@index([tenantId])
}

// One row per qualifying order line that earned a bonus. Enough detail to
// answer, from the snapshot alone: which promotion applied, its name / type
// / configured value, the qualifying product, how many paid units
// qualified, the post-discount qualifying spend, the standard Beans those
// units earned, and the bonus Beans awarded.
model OrderLoyaltyBonusItem {
  id                  String            @id @default(uuid(7))
  orderLoyaltyBonusId String
  orderLoyaltyBonus   OrderLoyaltyBonus @relation(fields: [tenantId, orderLoyaltyBonusId], references: [tenantId, id], onDelete: Cascade, onUpdate: Restrict)

  // Plain reference to the promotion this came from — nullable and
  // un-joined on purpose (mirrors OrderLoyaltyRewardRedemption.sourceRewardId).
  sourcePromotionId String?

  // Immutable snapshot.
  promotionName             String
  promotionType             LoyaltyBonusPromotionType
  bonusValue                Int
  productId                 String
  productName               String
  // Paid qualifying units (a FREE_ITEM-reward free unit is excluded).
  qualifyingUnits           Int
  // Post-discount qualifying spend attributed to those units, minor units.
  qualifyingSpendMinorUnits Int
  // Standard Beans those units earned at the configured company rate — the
  // MULTIPLIER math input; informational for EXTRA_BEANS.
  standardBeansForItem      Int
  bonusBeans                Int
  createdAt                 DateTime                  @default(now())

  // Milestone S0D-1 — the owning tenant. REQUIRED since tenant isolation
  // phase 2: every write supplies it explicitly (root writes from the
  // request's TenantContext, child writes from a validated parent). No
  // default.
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([orderLoyaltyBonusId])
  @@index([sourcePromotionId])
  // Security 4C-6 — the deleted-product-id reuse guard looks product
  // snapshots up by this column.
  @@index([productId])
  @@index([tenantId])
}

// --- Milestone 7E, Promotions & Coupons ---------------------------
// The platform's regular merchandise-discount system — entirely separate
// from Mocha Bean rewards (7C), Bonus Mocha Bean Promotions (7D) and Gift
// Cards. Deliberately bounded: three discount types, product/category/
// whole-order applicability, all-or-selected locations, an optional flat
// date window, optional minimum purchase, optional redemption limits. NOT a
// generic marketing/rules engine.
//
// A PROMOTION (kind AUTOMATIC) applies automatically when eligible. A
// COUPON (kind COUPON) requires the customer to enter its code. An order
// may use at most ONE regular Promotion OR Coupon, and may additionally use
// ONE Mocha Bean reward. Promotions are never hard-deleted (isActive is the
// off switch) so a historical OrderPromotionRedemption can always still
// point at what it used.

enum PromotionKind {
  // Applies automatically when eligible — no code.
  AUTOMATIC
  // Requires a customer-entered code (case-insensitive).
  COUPON
}

enum PromotionDiscountType {
  // `discountValue` is a whole percent, 1..100, off eligible merchandise.
  // `maxDiscountMinorUnits` optionally caps the resulting discount.
  PERCENTAGE_OFF
  // `discountValue` is a positive amount in minor units off eligible
  // merchandise, capped at the eligible merchandise amount.
  FIXED_AMOUNT
  // The lowest-priced eligible cart unit is free (mirrors the 7C Mocha Bean
  // FREE_ITEM reward). Requires product/category eligibility.
  FREE_ITEM
}

enum PromotionApplicability {
  // The discount applies to the whole merchandise order.
  ENTIRE_ORDER
  // Only the lines whose product is in `eligibleProducts`.
  SELECTED_PRODUCTS
  // Only the lines whose category is in `eligibleCategories`.
  SELECTED_CATEGORIES
}

model Promotion {
  id                         String                 @id @default(uuid(7))
  name                       String
  description                String?
  kind                       PromotionKind
  // Normalized (trimmed + upper-cased) coupon code. Null for AUTOMATIC.
  // The @unique on the normalized form is the case-insensitive uniqueness
  // guarantee: "welcome10" and "WELCOME10" cannot both exist.
  code                       String?
  discountType               PromotionDiscountType
  // PERCENTAGE_OFF: whole percent 1..100. FIXED_AMOUNT: minor units > 0.
  // FREE_ITEM: unused (0).
  discountValue              Int                    @default(0)
  // PERCENTAGE_OFF only — optional cap on the resulting discount, minor
  // units. Null for the other types.
  maxDiscountMinorUnits      Int?
  applicability              PromotionApplicability @default(ENTIRE_ORDER)
  // Optional minimum GROSS merchandise subtotal (before this discount, and
  // before any Mocha Bean reward), minor units.
  minimumSubtotalMinorUnits  Int?
  isActive                   Boolean                @default(true)
  // Optional active window. Eligible only when isActive AND
  // (startsAt is null OR startsAt <= now) AND (endsAt is null OR now < endsAt).
  startsAt                   DateTime?
  endsAt                     DateTime?
  appliesToAllLocations      Boolean                @default(false)
  // Optional total redemption cap across all customers. Enforced by a
  // conditional increment of `redemptionCount` inside the order
  // transaction (updateMany where redemptionCount < limit) — never a
  // read-compare-write.
  totalRedemptionLimit       Int?
  // Optional per-customer redemption cap. Requires an authenticated
  // customer (a Promotion/Coupon with this limit cannot be used by a
  // guest). Enforced by a conditional increment of the matching
  // PromotionCustomerUsage row inside the order transaction.
  perCustomerRedemptionLimit Int?
  // Materialized count of persisted successful redemptions. Only ever
  // incremented inside the order transaction that persists the Order, so it
  // is never consumed by an abandoned/declined checkout.
  redemptionCount            Int                    @default(0)
  createdAt                  DateTime               @default(now())
  updatedAt                  DateTime               @updatedAt

  eligibleProducts   PromotionProduct[]
  eligibleCategories PromotionCategory[]
  eligibleLocations  PromotionLocation[]
  customerUsage      PromotionCustomerUsage[]
  // Milestone 8G — Campaigns that reference this promotion as an optional
  // benefit. Campaign.onDelete is Restrict, so a promotion linked by a
  // Campaign cannot be hard-deleted (it never is anyway — isActive is the
  // off switch). Purely referential: a Campaign never mutates or duplicates
  // this promotion's own discount logic.
  campaigns          Campaign[]

  // Milestone S0D-1 — the owning tenant. REQUIRED since tenant isolation
  // phase 2: every write supplies it explicitly (root writes from the
  // request's TenantContext, child writes from a validated parent). No
  // default.
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, code])
  // Security 4C-2 — composite tenant key: lets child tables reference
  // (tenantId, id) so the database itself can refuse a cross-business link
  // (composite foreign keys arrive in Security 4C-3).
  @@unique([tenantId, id])
  @@index([kind, isActive])
  @@index([isActive])
  @@index([tenantId])
}

model PromotionProduct {
  promotionId String
  productId   String
  createdAt   DateTime @default(now())

  promotion Promotion @relation(fields: [tenantId, promotionId], references: [tenantId, id], onDelete: Cascade, onUpdate: Restrict)
  product   Product   @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  // Milestone S0D-1 — the owning tenant. REQUIRED since tenant isolation
  // phase 2: every write supplies it explicitly (root writes from the
  // request's TenantContext, child writes from a validated parent). No
  // default.
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([promotionId, productId])
  @@index([productId])
  @@index([tenantId])
}

model PromotionCategory {
  promotionId String
  categoryId  String
  createdAt   DateTime @default(now())

  promotion Promotion @relation(fields: [tenantId, promotionId], references: [tenantId, id], onDelete: Cascade, onUpdate: Restrict)
  category  Category  @relation(fields: [tenantId, categoryId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  // Milestone S0D-1 — the owning tenant. REQUIRED since tenant isolation
  // phase 2: every write supplies it explicitly (root writes from the
  // request's TenantContext, child writes from a validated parent). No
  // default.
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([promotionId, categoryId])
  @@index([categoryId])
  @@index([tenantId])
}

model PromotionLocation {
  promotionId String
  locationId  String
  createdAt   DateTime @default(now())

  promotion Promotion @relation(fields: [tenantId, promotionId], references: [tenantId, id], onDelete: Cascade, onUpdate: Restrict)
  location  Location  @relation(fields: [tenantId, locationId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  // Milestone S0D-1 — the owning tenant. REQUIRED since tenant isolation
  // phase 2: every write supplies it explicitly (root writes from the
  // request's TenantContext, child writes from a validated parent). No
  // default.
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([promotionId, locationId])

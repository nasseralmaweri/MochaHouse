// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Location {
  id                           String                                @id @default(uuid(7))
  name                         String
  slug                         String                                @unique
  isActive                     Boolean                               @default(true)
  isDigitalOrderingEnabled     Boolean                               @default(true)
  createdAt                    DateTime                              @default(now())
  updatedAt                    DateTime                              @updatedAt
  menus                        LocationMenu[]
  productPriceOverrides        LocationProductPriceOverride[]
  productAvailabilityOverrides LocationProductAvailabilityOverride[]
  orders                       Order[]
  preferredByCustomers         CustomerPreferredLocation[]
}

model Category {
  id           String    @id @default(uuid(7))
  name         String
  slug         String    @unique
  displayOrder Int       @default(0)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  products     Product[]
}

model Product {
  id                    String                                @id @default(uuid(7))
  name                  String
  slug                  String                                @unique
  description           String?
  basePrice             Int?
  currency              String                                @default("USD")
  isActive              Boolean                               @default(true)
  categoryId            String
  category              Category                              @relation(fields: [categoryId], references: [id])
  createdAt             DateTime                              @default(now())
  updatedAt             DateTime                              @updatedAt
  modifierGroups        ProductModifierGroup[]
  menus                 MenuProduct[]
  priceOverrides        LocationProductPriceOverride[]
  availabilityOverrides LocationProductAvailabilityOverride[]

  @@index([categoryId])
}

model Menu {
  id                    String                                @id @default(uuid(7))
  name                  String
  slug                  String                                @unique
  isActive              Boolean                               @default(true)
  products              MenuProduct[]
  locations             LocationMenu[]
  priceOverrides        LocationProductPriceOverride[]
  availabilityOverrides LocationProductAvailabilityOverride[]
  createdAt             DateTime                              @default(now())
  updatedAt             DateTime                              @updatedAt
}

model ModifierGroup {
  id            String                 @id @default(uuid(7))
  name          String
  displayOrder  Int                    @default(0)
  isRequired    Boolean                @default(false)
  minSelections Int                    @default(0)
  maxSelections Int?
  isActive      Boolean                @default(true)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  options       ModifierOption[]
  products      ProductModifierGroup[]
}

model ModifierOption {
  id              String        @id @default(uuid(7))
  name            String
  priceAdjustment Int           @default(0)
  displayOrder    Int           @default(0)
  isActive        Boolean       @default(true)
  modifierGroupId String
  modifierGroup   ModifierGroup @relation(fields: [modifierGroupId], references: [id])
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([modifierGroupId])
}

model ProductModifierGroup {
  productId       String
  modifierGroupId String
  displayOrder    Int    @default(0)

  product       Product       @relation(fields: [productId], references: [id])
  modifierGroup ModifierGroup @relation(fields: [modifierGroupId], references: [id])

  @@id([productId, modifierGroupId])
  @@index([modifierGroupId])
}

model MenuProduct {
  menuId       String
  productId    String
  displayOrder Int     @default(0)
  isActive     Boolean @default(true)

  menu    Menu    @relation(fields: [menuId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@id([menuId, productId])
  @@index([productId])
}

model LocationMenu {
  locationId String
  menuId     String
  isActive   Boolean @default(true)

  location Location @relation(fields: [locationId], references: [id])
  menu     Menu     @relation(fields: [menuId], references: [id])

  @@id([locationId, menuId])
  @@index([menuId])
}

model LocationProductPriceOverride {
  locationId String
  menuId     String
  productId  String
  price      Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  location Location @relation(fields: [locationId], references: [id])
  menu     Menu     @relation(fields: [menuId], references: [id])
  product  Product  @relation(fields: [productId], references: [id])

  @@id([locationId, menuId, productId])
  @@index([menuId])
  @@index([productId])
}

model LocationProductAvailabilityOverride {
  locationId  String
  menuId      String
  productId   String
  isAvailable Boolean
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  location Location @relation(fields: [locationId], references: [id])
  menu     Menu     @relation(fields: [menuId], references: [id])
  product  Product  @relation(fields: [productId], references: [id])

  @@id([locationId, menuId, productId])
  @@index([menuId])
  @@index([productId])
}

// --- Milestone 4, customer identity foundation -------------------------
// Cognito owns credentials/passwords, verification, recovery, and token
// lifecycle. Mocha House owns this record, the customer's profile, and
// account status. externalProvider + externalSubject is a deliberately
// provider-agnostic identity mapping (a plain string pair, never a Cognito
// SDK payload shape) so the Customer domain never depends on Cognito's
// token/claims structure — only the customer-auth boundary (apps/api) does.
// No password or Cognito token is ever stored here.

enum CustomerAccountStatus {
  ACTIVE
  RESTRICTED
  DEACTIVATED
}

model Customer {
  id                  String                      @id @default(uuid(7))
  externalProvider    String
  externalSubject     String
  email               String?
  displayName         String?
  status              CustomerAccountStatus       @default(ACTIVE)
  // Contact-verification state (Milestone 4C) — deliberately separate from
  // `status` above: this tracks whether the registration email has been
  // confirmed with the identity provider, not the customer's business
  // account standing. Null means "never verified" — set once, at
  // successful verification, and never fabricated/backfilled for rows
  // created before this column existed (see the migration's own comment).
  emailVerifiedAt     DateTime?
  // Communication preference (Milestone 4F). true ONLY when the customer
  // has explicitly opted in to marketing/promotional email. It never gates
  // transactional/account mail (verification, password recovery, order
  // confirmation, security notices) — those are operationally required and
  // sent regardless. This column is current-state only: it is not, and
  // must not be treated as, an audit-quality record of historic consent
  // (no source/version/timestamp of the consent event is captured here).
  marketingEmailOptIn Boolean                     @default(false)
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt
  orders              Order[]
  preferredLocations  CustomerPreferredLocation[]

  @@unique([externalProvider, externalSubject])
}

// --- Milestone 4F, preferred locations --------------------------------
// A managed set of authoritative Mocha House Location records a customer
// has saved to speed up repeat ordering. Pure join table: it carries no
// customer-authored content (no nickname/notes/ranking) — those are
// deliberately out of scope. There is no "primary/default" concept; the
// approved requirement is satisfied by the set alone.
//
// onDelete: Cascade on both sides — a join row is meaningless without both
// referents, and removing it can never corrupt a Customer or a Location
// (neither has a foreign key pointing here). A Location going inactive is
// handled in the query layer (CustomerPreferredLocationsService only
// returns rows whose Location is still active), not by deleting rows.
model CustomerPreferredLocation {
  id         String   @id @default(uuid(7))
  customerId String
  locationId String
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([customerId, locationId])
  @@index([customerId])
  @@index([locationId])
}

// --- Milestone 3, first transaction slice -----------------------------
// Checkout -> FakePaymentProvider -> durable Order + immutable snapshots
// -> OrderStatusHistory -> transactional OutboxEvent -> confirmation.
// Store Queue processing / status advancement is a later slice: OutboxEvent
// rows are written here but nothing consumes them yet.

enum PaymentAttemptStatus {
  PENDING
  SUCCEEDED
  DECLINED
  FAILED
}

// RECEIVED is the only status this slice ever writes. ACCEPTED..COMPLETED
// name the approved Store Queue pipeline stages so the next slice adds no
// new enum values, only the code that transitions into them.
enum OrderStatus {
  RECEIVED
  ACCEPTED
  PREPARING
  READY
  COMPLETED
}

enum OutboxEventStatus {
  PENDING
  PROCESSED
  FAILED
}

// A durable, independent record of a payment charge attempt against
// FakePaymentProvider. Created (PENDING) before the provider is invoked,
// and preserved regardless of outcome — a decline/failure never deletes or
// overwrites this row, it only ever updates its status once. The unique
// idempotencyKey is what makes checkout submission idempotent: a retried
// request with the same key reuses this row's outcome instead of charging
// or creating an Order again.
model PaymentAttempt {
  id                String               @id @default(uuid(7))
  idempotencyKey    String               @unique
  provider          String
  status            PaymentAttemptStatus @default(PENDING)
  locationId        String
  amount            Int
  currency          String
  providerReference String?
  failureReason     String?

  // Set when this attempt's payment SUCCEEDED but the subsequent protected
  // Order transaction did not commit (e.g. the catalog changed underneath
  // it, or an unexpected error aborted the transaction). `status` stays
  // SUCCEEDED — the payment truthfully did succeed — this is a separate,
  // explicit flag so that condition is durable and queryable rather than
  // only inferable from "SUCCEEDED with no linked Order". No refund or
  // retry is triggered automatically; a later reconciliation slice (worker
  // or admin) is expected to query reconciliationRequired = true.
  reconciliationRequired   Boolean   @default(false)
  reconciliationReason     String?
  reconciliationDetectedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order Order?

  @@index([status])
  @@index([reconciliationRequired])
}

// The durable Mocha House order. Only ever created inside the protected
// transaction that follows a SUCCEEDED PaymentAttempt — paymentAttemptId is
// required and unique, so the database itself rules out an Order existing
// without a successful payment behind it. Guest contact and pricing fields
// are point-in-time snapshots (see OrderLine), never re-derived from the
// catalog after the fact.
model Order {
  id          String      @id @default(uuid(7))
  orderNumber String      @unique
  // Opaque bearer credential for guest access to this order's status. The
  // internal id alone is not authorization — see OrdersController.
  accessToken String      @unique
  status      OrderStatus @default(RECEIVED)

  locationId String
  location   Location @relation(fields: [locationId], references: [id])

  // Nullable: guest checkout (Milestone 3) never sets this. Populated only
  // when the checkout request carried a valid, verified customer session
  // (Milestone 4B) — the Mocha House Customer.id, never a Cognito subject,
  // keeping this relationship provider-agnostic like the rest of the
  // customer domain. onDelete: SetNull rather than Cascade so a Customer
  // record being removed later (privacy handling is explicitly not part of
  // this slice) can never destroy this Order's own history — the order
  // simply reverts to looking like a guest order, never disappears.
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  paymentAttemptId String         @unique
  paymentAttempt   PaymentAttempt @relation(fields: [paymentAttemptId], references: [id])

  // Guest contact snapshot, captured at checkout time regardless of whether
  // the order is also linked to a Customer above — never re-derived from a
  // Customer's (mutable) profile fields, so this historical snapshot can
  // never change after the fact even if the customer later edits their
  // profile (not yet possible, but this must hold once it is).
  guestName  String
  guestPhone String
  guestEmail String?

  currency String
  // Merchandise total only. No tax/fee model is approved yet — see
  // Milestone 3 report for this explicitly flagged limitation.
  subtotal Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines         OrderLine[]
  statusHistory OrderStatusHistory[]

  @@index([locationId])
  @@index([customerId])
}

// Immutable line snapshot captured at order-creation time: prices and
// modifier selections are copied by value from the authoritative repricing
// step, never re-joined against the live catalog. `selections` is a JSON
// snapshot (group/option names + price adjustments) for the same reason
// the cart already treats catalog state as mutable — an Order must survive
// later menu/price changes unchanged.
model OrderLine {
  id      String @id @default(uuid(7))
  orderId String
  order   Order  @relation(fields: [orderId], references: [id])

  productId   String
  productName String
  unitPrice   Int
  quantity    Int
  lineTotal   Int
  currency    String
  selections  Json

  createdAt DateTime @default(now())

  @@index([orderId])
}

// Append-only. Rows are never updated or deleted — the current status is
// whichever row is latest, but Order.status is kept as the fast-read
// projection of that history rather than requiring a join on every read.
model OrderStatusHistory {
  id      String @id @default(uuid(7))
  orderId String
  order   Order  @relation(fields: [orderId], references: [id])

  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())

  @@index([orderId])
}

// Generic transactional outbox: written in the same database transaction
// that commits a successful Order, so "the order exists" and "a
// fulfillment event was recorded" can never disagree. Deliberately not
// scoped to Order via a foreign key — that's what keeps this a genuine,
// aggregate-agnostic outbox rather than an Order-specific queue table.
// Nothing consumes these rows yet; that is the next slice (Store Queue
// worker), not this one.
model OutboxEvent {
  id            String            @id @default(uuid(7))
  aggregateType String
  aggregateId   String
  eventType     String
  payload       Json
  status        OutboxEventStatus @default(PENDING)
  createdAt     DateTime          @default(now())
  processedAt   DateTime?

  @@index([status])
  @@index([aggregateType, aggregateId])
}

// --- Milestone 5A, internal identity & admin authentication -----------
// A deliberately separate identity boundary from Customer. A production
// internal user authenticates against a dedicated Cognito user pool + app
// client (never the customer pool); the local-dev provider stands in when
// none is provisioned. Mocha House is authoritative for this record and
// its lifecycle. NO password or provider token is stored here.
//
// externalProvider + externalSubject is the provider-agnostic identity
// mapping (a plain string pair, never a provider SDK payload), mirroring
// Customer. externalSubject is nullable so an InternalUser can be created
// in the INVITED state before the person has ever authenticated — it is
// bound on the first successful authentication of an already-ACTIVE user
// and is never, on its own, treated as activation.
//
// Lifecycle: INVITED -> ACTIVE -> SUSPENDED/DISABLED (and back). Only
// ACTIVE confers internal/Admin access. Authentication never promotes
// INVITED to ACTIVE — that is an explicit administrative action (Milestone
// 5B). No Role/Permission/Scope tables exist yet, by design.
enum InternalUserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  DISABLED
}

model InternalUser {
  id               String             @id @default(uuid(7))
  externalProvider String
  externalSubject  String?
  email            String             @unique
  displayName      String?
  status           InternalUserStatus @default(INVITED)

  // When the invitation record was created. `activatedAt` is set the first
  // time the account is moved to ACTIVE (administratively — Milestone 5B —
  // or by the local seed), never by authentication. `lastAuthenticatedAt`
  // is updated only on a successful ACTIVE authentication and is purely
  // observational — it can never widen access.
  invitedAt           DateTime  @default(now())
  activatedAt         DateTime?
  lastAuthenticatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([externalProvider, externalSubject])
}

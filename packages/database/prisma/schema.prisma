// Per-(promotion, customer) redemption counter — the row that is
// conditionally incremented (updateMany where usedCount < limit) inside the
// order transaction to enforce `perCustomerRedemptionLimit` under
// concurrency. Created lazily the first time a given customer redeems a
// given promotion.
model PromotionCustomerUsage {
  promotionId String
  customerId  String
  usedCount   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  promotion Promotion @relation(fields: [tenantId, promotionId], references: [tenantId, id], onDelete: Cascade, onUpdate: Restrict)
  customer  Customer  @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Cascade, onUpdate: Restrict)

  // Milestone S0D-1 — the owning tenant. REQUIRED since tenant isolation
  // phase 2: every write supplies it explicitly (root writes from the
  // request's TenantContext, child writes from a validated parent). No
  // default.
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([promotionId, customerId])
  @@index([customerId])
  @@index([tenantId])
}

// The immutable per-order record of the ONE regular Promotion/Coupon used.
// Written in the SAME transaction as the Order, the reward REDEEM/EARN
// entries and the bonus snapshot — never split into independent commits.
// SNAPSHOT BY VALUE (the OrderLine philosophy): every field below is copied
// at redemption time and never re-read from Promotion. Later HQ edits to
// the promotion (name, code, value, applicability, dates, active state)
// never change a completed order. `sourcePromotionId` is a plain reference
// string (no foreign key) kept only so history can point at what it came
// from; it is NEVER trusted for display or accounting.
//
// `orderId @unique` is both the "one regular discount per order" invariant
// and the idempotency anchor: a checkout replay re-uses the same Order (or
// none), so this row — and the redemption-count increments — happen at most
// once.
model OrderPromotionRedemption {
  id      String @id @default(uuid(7))
  orderId String @unique
  order   Order  @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  sourcePromotionId String?

  // Immutable snapshot.
  promotionName       String
  promotionKind       PromotionKind
  // Normalized coupon code snapshot — set for a COUPON, null for an
  // AUTOMATIC promotion.
  couponCode          String?
  discountType        PromotionDiscountType
  // The configured value at redemption time (percent, or minor units).
  discountValue       Int
  // The actual monetary discount applied to gross merchandise, minor units.
  discountMinorUnits  Int
  // FREE_ITEM only — the cart product one unit of which was made free.
  freeItemProductId   String?
  freeItemProductName String?
  // The customer this redemption counts against for a per-customer limit,
  // or null (guest, or the promotion has no per-customer limit).
  customerId          String?
  // Security 4C-4 — now a composite foreign key: only a customer of this
  // order's business. SET NULL clears only customerId if the customer is
  // deleted; the redemption snapshot itself is kept.
  customer            Customer?             @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: SetNull, onUpdate: Restrict)
  createdAt           DateTime              @default(now())

  // Milestone S0D-1 — the owning tenant. REQUIRED since tenant isolation
  // phase 2: every write supplies it explicitly (root writes from the
  // request's TenantContext, child writes from a validated parent). No
  // default.
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  // Security 4C-4 — the one-to-one composite relation needs its key
  // unique together with tenantId (the column alone already is).
  @@unique([tenantId, orderId])
  @@index([sourcePromotionId])
  @@index([customerId])
  // Security 4C-6 — the deleted-product-id reuse guard looks product
  // snapshots up by this column.
  @@index([freeItemProductId])
  @@index([tenantId])
}

// --- Milestone 7F, Gift Card Foundation & Administration -------------
// The financial and administrative foundation for Mocha House Gift Cards:
// a secure gift-card instrument, its immutable transaction ledger, its
// materialized balance, and the HQ administration surface. Gift Cards V1
// are digital, but nothing here ties a card to a customer, a channel, or a
// physical format — a later slice can add those without restructuring.
//
// This slice is NOT customer purchasing or checkout redemption. The ledger
// is designed so future lifecycle operations (redemption, refund) can be
// represented cleanly, but only the operations 7F actually performs are
// implemented: HQ issuance and HQ manual correction (plus deactivate /
// reactivate, which never touch the balance or the ledger).

// A deliberately minimal administrative on/off switch. A zero balance is
// NOT a status — balance represents depletion — so there is no DEPLETED or
// EXPIRED value. Gift cards have no expiration in V1.
enum GiftCardStatus {
  ACTIVE
  INACTIVE
}

// The ledger gains a new type only when the capability that writes it
// actually ships (the same discipline as MochaBeanEntryType). 7F writes
// exactly two:
//   ISSUANCE   — the opening entry, +originalValue, exactly one per card.
//   ADJUSTMENT — an authorized HQ manual correction. Signed; always
//                carries a trimmed non-empty `reason` and an
//                `actorInternalUserId`, and is mirrored by an
//                InternalAuditEvent written in the same transaction.
// REFUND is intentionally absent — it is added by the refund/restoration
// slice that writes it. Milestone 7G adds REDEMPTION (a negative entry for
// value spent as tender on a successful order).
enum GiftCardTransactionType {
  ISSUANCE
  ADJUSTMENT
  // Milestone 7G — value spent from this card as tender on ONE successful
  // order. `amountMinorUnits` is negative (the tender applied), `orderId` is
  // set, and the entry is written in the SAME transaction as the Order and
  // the OrderGiftCardRedemption snapshot. The partial unique index on
  // (orderId) WHERE type = 'REDEMPTION' makes it exactly-once per order.
  REDEMPTION
  // R1 / S5a — value RESTORED to the card because the order it paid for was
  // rejected or cancelled. `amountMinorUnits` is positive (exactly the order's
  // OrderGiftCardRedemption amount), `orderId` and `actorInternalUserId` are
  // set, and a partial unique index on (orderId) WHERE type =
  // 'REDEMPTION_REVERSAL' makes it exactly-once per order. NOTHING writes it
  // in S5a; the closure writer (S5b) does, in the same transaction as the
  // status change.
  REDEMPTION_REVERSAL
}

// One gift card. `codeHash` is the ONLY lookup path: the human code is
// canonicalized (upper-cased, un-spaced) and stored as an HMAC-SHA-256
// digest keyed by GIFT_CARD_CODE_SECRET — the plaintext code is never
// persisted and is returned exactly once, in the HQ issuance response.
// `last4` backs the masked representation (`•••• •••• •••• 4821`) used in
// every normal Admin read.
//
// `balanceMinorUnits` is a materialized projection of the sum of this
// card's ledger entries — kept on the row (the same pattern as
// Order.status ↔ OrderStatusHistory and CustomerLoyaltyAccount.balance) so
// a balance read needs no aggregate, and, crucially, so there is a single
// row to lock (SELECT ... FOR UPDATE) when enforcing the monetary
// invariants under concurrency. Invariants (enforced in the service,
// before every write): 0 <= balanceMinorUnits <= 200000 (the approved
// $2,000.00 ceiling), and `originalValueMinorUnits` is immutable after
// issuance.
model GiftCard {
  id                      String         @id @default(uuid(7))
  codeHash                String         @unique
  last4                   String
  status                  GiftCardStatus @default(ACTIVE)
  originalValueMinorUnits Int
  balanceMinorUnits       Int            @default(0)
  currency                String         @default("USD")
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt

  transactions GiftCardTransaction[]
  // Milestone 7H — the customer purchase that created this card, or null for
  // an HQ-issued card.
  purchase     GiftCardPurchase?

  // Milestone S0D-1 — the owning tenant. REQUIRED since tenant isolation
  // phase 2: every write supplies it explicitly (root writes from the
  // request's TenantContext, child writes from a validated parent). No
  // default.
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  // Security 4C-2 — composite tenant key: lets child tables reference
  // (tenantId, id) so the database itself can refuse a cross-business link
  // (composite foreign keys arrive in Security 4C-3).
  @@unique([tenantId, id])
  @@index([status])
  @@index([tenantId])
}

// Append-only gift-card transaction history — the authoritative record of
// every movement of stored value (mirrors OrderStatusHistory /
// MochaBeanLedgerEntry / InternalAuditEvent: the service never updates or
// deletes a row here). `amountMinorUnits` is signed: positive for ISSUANCE
// and a positive ADJUSTMENT, negative for a deduction.
// `balanceAfterMinorUnits` is the card balance immediately after this
// entry — a financial ledger should be readable without re-summing (the
// OrderLine snapshot philosophy).
//
// Every balance-changing write inserts exactly one row here AND updates
// GiftCard.balanceMinorUnits by the same signed delta inside ONE
// transaction, so the ledger and the materialized balance can never
// disagree.
//
// Idempotency / integrity (partial unique indexes added in the migration —
// Prisma cannot express the WHERE predicate, so they live in migration.sql
// and are documented here):
//   - UNIQUE (giftCardId) WHERE type = 'ISSUANCE' — exactly one issuance
//     entry per card.
//   - UNIQUE (tenantId, operationKey) WHERE type = 'ADJUSTMENT' — a manual
//     correction is idempotent on its caller-supplied operationKey within
//     its business; a retry with the same key returns the existing outcome
//     instead of applying it twice. Per business since SC0.5b (migration
//     20261021090000_tenant_giftcard_adjustment_operation_key; was global),
//     so one business's key never blocks or reveals another's.
//   - UNIQUE (orderId) WHERE type = 'REDEMPTION' — Milestone 7G: exactly one
//     redemption entry per order, so a checkout replay can never spend the
//     card twice.
//   - UNIQUE (orderId) WHERE type = 'REDEMPTION_REVERSAL' — R1 / S5a: at most one
//     restoration per order (migration 20261019090100_order_closure_foundation).
model GiftCardTransaction {
  id                     String                  @id @default(uuid(7))
  giftCardId             String
  type                   GiftCardTransactionType
  // Signed whole minor units. The resulting card balance is never allowed
  // below zero or above 200000 (enforced in the service, before the write).
  // Negative for a deduction (a REDEMPTION is always negative).
  amountMinorUnits       Int
  // Card balance immediately after this entry was applied.
  balanceAfterMinorUnits Int
  // Required (trimmed, non-empty) for ADJUSTMENT; null for ISSUANCE and
  // REDEMPTION.
  reason                 String?
  // The HQ operator who performed this entry. Set for a HQ-issued card and
  // for every ADJUSTMENT; null for a customer REDEMPTION. onDelete: Restrict
  // keeps the financial record — and the balance it accounts for — intact.
  actorInternalUserId    String?
  // Caller-supplied idempotency key for ADJUSTMENT; null for ISSUANCE and
  // REDEMPTION (REDEMPTION is keyed by orderId instead).
  operationKey           String?
  // Milestone 7G — set for REDEMPTION: the order this value was spent on.
  // onDelete: SetNull keeps the ledger entry — and the balance it accounts
  // for — intact even if the Order is later removed, exactly like
  // MochaBeanLedgerEntry.orderId.
  orderId                String?
  // Milestone 7H — set for the ISSUANCE entry of a card created by a
  // customer purchase; null for an HQ-issued card's ISSUANCE and for every
  // ADJUSTMENT / REDEMPTION. onDelete: SetNull keeps the ledger entry intact.
  giftCardPurchaseId     String?
  createdAt              DateTime                @default(now())

  giftCard          GiftCard          @relation(fields: [tenantId, giftCardId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  actorInternalUser InternalUser?     @relation("GiftCardTransactionActor", fields: [tenantId, actorInternalUserId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  order             Order?            @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: SetNull, onUpdate: Restrict)
  giftCardPurchase  GiftCardPurchase? @relation(fields: [tenantId, giftCardPurchaseId], references: [tenantId, id], onDelete: SetNull, onUpdate: Restrict)

  // Milestone S0D-1 — the owning tenant. REQUIRED since tenant isolation
  // phase 2: every write supplies it explicitly (root writes from the
  // request's TenantContext, child writes from a validated parent). No
  // default.
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([giftCardId, createdAt])
  @@index([actorInternalUserId])
  @@index([orderId])
  @@index([giftCardPurchaseId])
  @@index([tenantId])
}

// --- Milestone 7G, Gift Card Redemption at checkout -----------------
// The immutable per-order record of the ONE gift card redeemed as tender on
// an order. Written in the SAME transaction as the Order and the negative
// REDEMPTION GiftCardTransaction — never split into independent commits.
//
// SNAPSHOT BY VALUE (the OrderLine philosophy): `last4`, `amountMinorUnits`
// and `currency` are copied here at redemption time and never re-read from
// GiftCard. `sourceGiftCardId` is a plain reference string (like
// OrderLine.productId — no foreign key) kept only so history can point at
// the card it came from; it is NEVER trusted for display or accounting, and
// the plaintext code / codeHash are never stored here.
//
// `orderId @unique` is both the "one gift card per order" invariant and the
// idempotency anchor: a checkout replay re-uses the same Order (or none), so
// this row — and the REDEMPTION ledger entry — is created at most once.
model OrderGiftCardRedemption {
  id      String @id @default(uuid(7))
  orderId String @unique
  order   Order  @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  // Plain reference to the gift card this came from. Nullable and un-joined
  // on purpose — the snapshot below is authoritative.
  sourceGiftCardId String?

  // Immutable snapshot. `last4` is the ONLY code representation ever stored.
  last4            String
  // The tender actually applied to this order (a positive amount; the
  // matching REDEMPTION ledger entry carries the negative of this).
  amountMinorUnits Int
  currency         String
  createdAt        DateTime @default(now())

  // Milestone S0D-1 — the owning tenant. REQUIRED since tenant isolation
  // phase 2: every write supplies it explicitly (root writes from the
  // request's TenantContext, child writes from a validated parent). No
  // default.
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  // Security 4C-4 — the one-to-one composite relation needs its key
  // unique together with tenantId (the column alone already is).
  @@unique([tenantId, orderId])
  @@index([sourceGiftCardId])
  @@index([tenantId])
}

// --- Milestone 7H, Customer Digital Gift Card Purchase --------------
// A customer-initiated purchase of a digital gift card, paid through the
// existing PaymentProvider boundary. NOT an Order — a purchase has no
// location, no lines, no fulfilment; it reuses PaymentAttempt (1:1) purely
// for the payment lifecycle. On a successful payment the shared issuance
// core creates the GiftCard + its single ISSUANCE ledger entry in one
// transaction, and this row transitions PENDING -> ISSUED.
//
// `paymentAttemptId @unique` is the idempotency anchor: a retried purchase
// with the same PaymentAttempt.idempotencyKey re-uses this row and never
// charges or issues again.
//
// FULL-CODE LOST-RESPONSE RECOVERY: the plaintext code is NEVER persisted.
// For a bounded 7-day window it is recoverable via AES-256-GCM ciphertext
// (`codeCiphertext` + `codeIv` + `codeAuthTag`, key GIFT_CARD_PURCHASE_CODE_KEK)
// stored here, decryptable only server-side, only through the two-step
// purchase flow (never a purchase-id-only endpoint), and only until
// `codeRetrievableUntil`. After that the ciphertext is dead weight (no
// cleanup worker in 7H) and the code is gone.
//
// GUEST RECOVERY CREDENTIAL: a guest purchase carries `recoveryCredentialHash`
// — the HMAC-SHA-256 verifier (keyed by GIFT_CARD_PURCHASE_RECOVERY_SECRET)
// of a 256-bit CSPRNG credential the server generates when the PENDING
// purchase is first established (step 1, BEFORE any charge) and returns to
// the buyer exactly once. Guest full-code recovery requires BOTH the
// PaymentAttempt.idempotencyKey (payment idempotency) AND this credential —
// the idempotency key alone never yields the code. A signed-in purchase
// leaves this null and is authorised by customer ownership instead.
enum GiftCardPurchaseStatus {
  PENDING
  ISSUED
  RECONCILIATION_REQUIRED
}

model GiftCardPurchase {
  id               String                 @id @default(uuid(7))
  status           GiftCardPurchaseStatus @default(PENDING)
  amountMinorUnits Int
  currency         String                 @default("USD")

  // 1:1 with the payment. PaymentAttempt.idempotencyKey is the logical
  // purchase key — this row needs no separate one.
  paymentAttemptId String         @unique
  paymentAttempt   PaymentAttempt @relation(fields: [tenantId, paymentAttemptId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  // Set once the card is issued; null while PENDING and forever if the
  // purchase ends in RECONCILIATION_REQUIRED.
  giftCardId String?   @unique
  giftCard   GiftCard? @relation(fields: [tenantId, giftCardId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  // Buyer. Signed-in -> customerId; guest -> null. `purchaserEmail` is the
  // BUYER's own contact for support / a future receipt — it is NOT a
  // recipient-delivery field (7H issues the code on screen only).
  customerId     String?
  customer       Customer? @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: SetNull, onUpdate: Restrict)
  purchaserEmail String
  purchaserName  String?

  // Encrypted temporary full-code recovery material (see the model comment).
  // Never the plaintext. All three are set together at issuance or all null.
  codeCiphertext       Bytes?
  codeIv               Bytes?
  codeAuthTag          Bytes?
  codeRetrievableUntil DateTime?

  // Guest recovery: HMAC-SHA-256 verifier of the server-generated 256-bit
  // recovery credential (see the model comment). Never the plaintext
  // credential. Set for a guest purchase at step-1 establishment; null for a
  // signed-in purchase (customer ownership is the authorisation there).
  recoveryCredentialHash String?

  // Step-2 concurrency claim: the FIRST request to atomically flip this from
  // null (guarded by status = PENDING) owns the single payment-provider
  // charge; every concurrent step-2 request then replays instead. Like a
  // stuck food checkout, a process that dies after claiming but before the
  // charge settles leaves the purchase PENDING (no double charge, no value
  // created) — the buyer restarts with a fresh idempotency key.
  chargeClaimedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions GiftCardTransaction[]

  // Milestone S0D-1 / S0D-2C-1B — the owning tenant. REQUIRED since
  // S0D-2C-1B: copied from its validated PaymentAttempt (PaymentAttempt ->
  // GiftCardPurchase is the one authoritative ownership chain — never a
  // second, independently-resolved TenantContext). No default.
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  // Security 4C-2 — composite tenant key: lets child tables reference
  // (tenantId, id) so the database itself can refuse a cross-business link
  // (composite foreign keys arrive in Security 4C-3).
  @@unique([tenantId, id])
  // Security 4C-4 — the one-to-one composite relation needs its key
  // unique together with tenantId (the column alone already is).
  @@unique([tenantId, paymentAttemptId])
  @@unique([tenantId, giftCardId])
  @@index([customerId])
  @@index([status])
  @@index([tenantId])
}

// The single company-wide gift-card purchasing configuration, persisted now
// so the FUTURE customer-purchasing slice has HQ settings to read. Nothing
// in 7F consumes it. Modelled as a keyed singleton (like
// LoyaltyConfiguration): every code path uses key "company". Seeded, and
// also lazily upserted by the service so a fresh database (or a test that
// skips the seed) still reads safe defaults.
//
// `presetAmountsMinorUnits` are HQ-editable suggested purchase amounts
// (integer minor units, each 1..200000). The seeded values ($10/$25/$50/
// $100) are examples, never permanent business rules.
// `customAmountEnabled` toggles whether a customer will later be able to
// enter their own amount. No custom-amount min/max fields in V1.
model GiftCardConfiguration {
  id                      String   @id @default(uuid(7))
  key                     String
  presetAmountsMinorUnits Int[]
  customAmountEnabled     Boolean  @default(true)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  // Milestone S0D-1 — the owning tenant. REQUIRED since tenant isolation
  // phase 2: every write supplies it explicitly (root writes from the
  // request's TenantContext, child writes from a validated parent). No
  // default.
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, key])
  @@index([tenantId])
}

// --- Milestone 8B, Careers / Job Openings ---------------------------
// HQ manages job openings; the public site shows only PUBLISHED ones that
// are visible (corporate, or tied to an active Location). Applicant
// submission / management is Milestone 8C and is NOT modelled here.
//
// Lifecycle (enforced in the service, never via a raw status write):
//   DRAFT      <-> PUBLISHED        (publish / unpublish)
//   DRAFT / PUBLISHED -> ARCHIVED   (archive)
//   ARCHIVED   is terminal in 8B — no edit, no publish, no unarchive.
// `publishedAt` is set on the FIRST publish and retained afterward.
enum JobOpeningStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum JobEmploymentType {
  FULL_TIME
  PART_TIME
  TEMPORARY
  SEASONAL
}

model JobOpening {
  id               String            @id @default(uuid(7))
  title            String
  employmentType   JobEmploymentType
  // null => a corporate / HQ role. Set => a specific Mocha House location.
  locationId       String?
  location         Location?         @relation(fields: [tenantId, locationId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  // Short teaser shown in the public list. Plain text.
  summary          String
  // The full body / responsibilities / qualifications — plain multiline
  // text (no rich text, no markdown infrastructure, no arrays).
  description      String
  responsibilities String
  qualifications   String
  status           JobOpeningStatus  @default(DRAFT)
  publishedAt      DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  // Milestone 8C — applications submitted for this opening. onDelete:
  // Restrict (see JobApplication) so a job with applications can never be
  // hard-deleted and orphan candidate history (jobs use status anyway).
  applications     JobApplication[]

  // Milestone S0D-1 / S0D-2D — the owning tenant. REQUIRED since S0D-2D:
  // from the request's server-side TenantContext, cross-checked against the
  // Location when one is supplied. No default.
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  // Security 4C-2 — composite tenant key: lets child tables reference
  // (tenantId, id) so the database itself can refuse a cross-business link
  // (composite foreign keys arrive in Security 4C-3).
  @@unique([tenantId, id])
  @@index([status])
  @@index([locationId])
  @@index([tenantId])
}

// --- Milestone 8C, Applicants -------------------------------------
// A public visitor's application to one job opening. No applicant account.
// Contact fields live inline (there is no separate Applicant identity in
// V1 — one person applying to N jobs is N rows). `jobTitleSnapshot` is a
// point-in-time copy so the record stays legible after the opening is
// edited or archived (the OrderLine snapshot philosophy). No resume file
// bytes — `resumeUrl` is an optional external link only.
enum JobApplicationStatus {
  NEW
  REVIEWING
  CONTACTED
  HIRED
  REJECTED
}

model JobApplication {
  id               String               @id @default(uuid(7))
  jobOpeningId     String
  jobOpening       JobOpening           @relation(fields: [tenantId, jobOpeningId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  jobTitleSnapshot String
  firstName        String
  lastName         String
  email            String
  phone            String
  location         String
  workAuthorized   Boolean
  availability     String
  message          String
  resumeUrl        String?
  status           JobApplicationStatus @default(NEW)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  notes JobApplicationNote[]

  // Milestone S0D-1 / S0D-2D — the owning tenant. REQUIRED since S0D-2D:
  // copied from its validated JobOpening. No default.
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  // Security 4C-2 — composite tenant key: lets child tables reference
  // (tenantId, id) so the database itself can refuse a cross-business link
  // (composite foreign keys arrive in Security 4C-3).
  @@unique([tenantId, id])
  @@index([jobOpeningId])
  @@index([status])
  @@index([createdAt])
  @@index([tenantId])
}

// An internal note an authorized HQ user attaches to an application.
// APPEND-ONLY in 8C: no edit, no delete. Adding one also writes an
// InternalAuditEvent (`applicants.note_added`, targetType 'job_application')
// in the SAME transaction — only the note id and length, never the body.
model JobApplicationNote {
  id                   String         @id @default(uuid(7))
  jobApplicationId     String
  jobApplication       JobApplication @relation(fields: [tenantId, jobApplicationId], references: [tenantId, id], onDelete: Cascade, onUpdate: Restrict)
  authorInternalUserId String
  authorInternalUser   InternalUser   @relation("JobApplicationNoteAuthor", fields: [tenantId, authorInternalUserId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  body                 String
  createdAt            DateTime       @default(now())

  // Milestone S0D-1 / S0D-2D — the owning tenant. REQUIRED since S0D-2D:
  // copied from its validated JobApplication. No default.
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([jobApplicationId, createdAt])
  @@index([authorInternalUserId])
  @@index([tenantId])
}

// --- Milestone 8A, HQ CRM foundation ---------------------------------
// An internal, free-text note an authorized HQ user attaches to a customer
// record. APPEND-ONLY in 8A: there is no edit or delete route. It is the
// ONLY CRM-specific storage this slice adds — every other CRM screen field
// is projected live from the authoritative domain (Customer / Order /
// loyalty / gift cards / preferences). Creating a note also writes an
// InternalAuditEvent (`crm.note_added`, targetType 'customer') in the SAME
// transaction, so the note and its audit trail can never disagree.
model CustomerNote {
  id                   String   @id @default(uuid(7))
  customerId           String
  authorInternalUserId String
  // Trimmed, 1..2000 characters (enforced in the service before the write).
  body                 String
  createdAt            DateTime @default(now())

  customer           Customer     @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Cascade, onUpdate: Restrict)
  authorInternalUser InternalUser @relation("CustomerNoteAuthor", fields: [tenantId, authorInternalUserId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  // Milestone S0D-1 / S0D-2B-2 — the owning tenant. REQUIRED since
  // S0D-2B-2: copied from the tenant-validated parent Customer. No default.
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([customerId, createdAt])
  @@index([authorInternalUserId])
  @@index([tenantId])
}

// --- Milestone 8D, Franchising inquiries ------------------------------
// A prospective franchisee's contact + interest record, captured from the
// public /franchising/inquiry form. One flat model — no separate
// "prospect" identity, mirroring the 8C Applicants shape. No file
// references; investmentRange / timeframe are free text (no invented $ or
// time buckets). consentAcknowledged records the visitor's own consent
// checkbox at submission time.
enum FranchiseInquiryStatus {
  NEW
  REVIEWING
  CONTACTED
  QUALIFIED
  CLOSED
}

model FranchiseInquiry {
  id                  String                 @id @default(uuid(7))
  firstName           String
  lastName            String
  email               String
  phone               String
  city                String
  state               String
  country             String
  preferredMarket     String
  investmentRange     String?
  timeframe           String?
  businessExperience  String?
  message             String?
  consentAcknowledged Boolean
  status              FranchiseInquiryStatus @default(NEW)
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  notes FranchiseInquiryNote[]

  // Milestone S0D-1 / S0D-2D — the owning tenant. REQUIRED since S0D-2D:
  // from the request's server-side TenantContext. No default.
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  // Security 4C-2 — composite tenant key: lets child tables reference
  // (tenantId, id) so the database itself can refuse a cross-business link
  // (composite foreign keys arrive in Security 4C-3).
  @@unique([tenantId, id])
  @@index([status])
  @@index([createdAt])
  @@index([tenantId])
}

// An internal note an authorized HQ user attaches to a franchise inquiry.
// APPEND-ONLY in 8D: no edit, no delete. Adding one also writes an
// InternalAuditEvent (`franchising.note_added`, targetType
// 'franchise_inquiry') in the SAME transaction — only the note id and
// length, never the body.
model FranchiseInquiryNote {
  id                   String           @id @default(uuid(7))
  franchiseInquiryId   String
  franchiseInquiry     FranchiseInquiry @relation(fields: [tenantId, franchiseInquiryId], references: [tenantId, id], onDelete: Cascade, onUpdate: Restrict)
  authorInternalUserId String
  authorInternalUser   InternalUser     @relation("FranchiseInquiryNoteAuthor", fields: [tenantId, authorInternalUserId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  body                 String
  createdAt            DateTime         @default(now())

  // Milestone S0D-1 / S0D-2D — the owning tenant. REQUIRED since S0D-2D:
  // copied from its validated FranchiseInquiry. No default.
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([franchiseInquiryId, createdAt])
  @@index([authorInternalUserId])
  @@index([tenantId])
}

// --- Milestone 8E, CMS foundation --------------------------------------
// Structured content management for a small, code-defined set of public
// page keys (see CMS_PAGE_KEYS in @mocha-house/contracts) — NOT a page
// builder. `draftContent` is the Admin working copy; `publishedContent` is
// the public snapshot, replaced wholesale only by an explicit publish
// action (no revisions kept). `status` becomes PUBLISHED on the first
// publish and stays PUBLISHED thereafter — there is no unpublish. No row
// is seeded; the first PATCH (save draft) or POST .../publish creates it.
enum CmsPageStatus {
  DRAFT
  PUBLISHED
}

model CmsPage {
  id               String        @id @default(uuid(7))
  key              String
  title            String
  status           CmsPageStatus @default(DRAFT)
  draftContent     Json
  publishedContent Json?
  publishedAt      DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  // Milestone S0D-1 — the owning tenant. REQUIRED since tenant isolation
  // phase 2: every write supplies it explicitly (root writes from the
  // request's TenantContext, child writes from a validated parent). No
  // default.
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, key])
  @@index([tenantId])
}

// --- Milestone 8F, Media Library --------------------------------------
// A minimal HQ image library backing CMS content. `objectKey` is the
// storage-provider key (S3 or the local/test MediaStorage stub) — the
// public URL is resolved from configuration, never stored here. Deletion
// is soft (`isActive`); the API refuses to deactivate an asset still
// referenced by known CMS content, and the underlying object is never
// removed from storage in 8F.
model MediaAsset {
  id                       String       @id @default(uuid(7))
  objectKey                String       @unique
  fileName                 String
  contentType              String
  fileSizeBytes            Int
  // Milestone 8I — optional, admin-editable metadata. Neither is used for
  // search ranking or any business logic beyond display; altText has no
  // fallback enforced here (CMS/Marketing consumers decide their own
  // fallback-to-fileName behavior).
  title                    String?
  altText                  String?
  isActive                 Boolean      @default(true)
  uploadedByInternalUserId String
  uploadedByInternalUser   InternalUser @relation("MediaAssetUploader", fields: [tenantId, uploadedByInternalUserId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  // Security 4C-6 — campaigns showing this asset (same business only).
  campaigns                Campaign[]
  createdAt                DateTime     @default(now())
  updatedAt                DateTime     @updatedAt

  // Milestone S0D-1 — the owning tenant. REQUIRED since tenant isolation
  // phase 2: every write supplies it explicitly (root writes from the
  // request's TenantContext, child writes from a validated parent). No
  // default.
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  // Security 4C-2 — composite tenant key: lets child tables reference
  // (tenantId, id) so the database itself can refuse a cross-business link
  // (composite foreign keys arrive in Security 4C-3).
  @@unique([tenantId, id])
  @@index([isActive, createdAt])
  @@index([uploadedByInternalUserId])
  @@index([tenantId])
}

// --- Milestone 8G, Marketing Campaigns ---------------------------------
// The smallest useful HQ "Campaign Management" layer — it ORGANIZES
// existing systems, never reimplements them. A Campaign optionally
// references ONE Promotion (discounts/coupons, 7E) AND/OR ONE
// LoyaltyBonusPromotion (bonus Mocha Beans, 7D) as independent optional
// benefits. Campaign itself performs NO discount or Mocha Beans
// calculation — those systems remain fully authoritative for their own
// eligibility, redemption and checkout behavior; a Campaign's own
// DRAFT -> ACTIVE -> ENDED lifecycle is purely organizational and NEVER
// mutates a linked Promotion / LoyaltyBonusPromotion (their own
// isActive / date-window state is untouched by a Campaign status change).
// `mediaAssetId` is a plain reference to a MediaAsset by id — no FK, the
// same pattern as CmsPage's hero.backgroundImageId (see
// media-reference-check.ts, extended to also protect a Campaign-referenced
// image from deactivation). There is deliberately NO campaign-to-order
// attribution/snapshot table in 8G — Campaign has zero checkout/runtime
// behavior; order attribution, conversion tracking and ROI are deferred.
enum CampaignStatus {
  DRAFT
  ACTIVE
  ENDED
}

model Campaign {
  id                      String                 @id @default(uuid(7))
  name                    String
  description             String?
  status                  CampaignStatus         @default(DRAFT)
  startsAt                DateTime?
  endsAt                  DateTime?
  mediaAssetId            String?
  // Security 4C-6 — the campaign image must be a media asset of the SAME
  // business (composite foreign key; it had no foreign key before). Media
  // assets are deactivated, never deleted, so RESTRICT changes nothing.
  mediaAsset              MediaAsset?            @relation(fields: [tenantId, mediaAssetId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  promotionId             String?
  promotion               Promotion?             @relation(fields: [tenantId, promotionId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  loyaltyBonusPromotionId String?
  loyaltyBonusPromotion   LoyaltyBonusPromotion? @relation(fields: [tenantId, loyaltyBonusPromotionId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt

  featuredProducts CampaignProduct[]

  // Milestone S0D-1 — the owning tenant. REQUIRED since tenant isolation
  // phase 2: every write supplies it explicitly (root writes from the
  // request's TenantContext, child writes from a validated parent). No
  // default.
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  // Security 4C-2 — composite tenant key: lets child tables reference
  // (tenantId, id) so the database itself can refuse a cross-business link
  // (composite foreign keys arrive in Security 4C-3).
  @@unique([tenantId, id])
  @@index([status])
  @@index([promotionId])
  @@index([loyaltyBonusPromotionId])
  @@index([mediaAssetId])
  @@index([tenantId])
}

// Ordered Featured Products targeting. onDelete: Cascade from the campaign
// (a join row is meaningless without it); onDelete: Restrict from the
// Product so a catalog product a campaign features cannot be hard-deleted
// out from under it. Same shape as PromotionProduct /
// LoyaltyBonusPromotionProduct, plus `displayOrder` so HQ's chosen ordering
// persists deterministically (mirrors CMS's ordered Home
// featuredProducts.productIds array, as a column since this is a
// relational join table rather than JSON). The composite primary key is
// also the "no duplicate featured product per campaign" constraint.
model CampaignProduct {
  campaignId   String
  productId    String
  displayOrder Int
  createdAt    DateTime @default(now())

  campaign Campaign @relation(fields: [tenantId, campaignId], references: [tenantId, id], onDelete: Cascade, onUpdate: Restrict)
  product  Product  @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  // Milestone S0D-1 — the owning tenant. REQUIRED since tenant isolation
  // phase 2: every write supplies it explicitly (root writes from the
  // request's TenantContext, child writes from a validated parent). No
  // default.
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([campaignId, productId])
  @@index([productId])
  @@index([tenantId])
}

// --- Milestone 8J, Approvals ------------------------------------------
// The smallest reusable "request -> decide" primitive, deliberately shaped
// like OutboxEvent (targetType/targetId, aggregate-agnostic) rather than a
// per-feature table. Only ONE business workflow is wired to it in 8J:
// Marketing Campaign activation (targetType "Campaign", action
// "marketing.campaign_activate" — see @mocha-house/contracts for the
// stable constants). Approving or rejecting NEVER mutates the target
// itself; a PENDING/APPROVED/REJECTED row here only ever gates a
// precondition the target's own service checks (see
// CampaignsAdminService.activate()). Staleness (the target changed after
// approval) is derived by comparing the target's own updatedAt to
// decidedAt — never stored, and an old APPROVED row is never mutated or
// relabeled; a fresh request is simply created when one is needed again.
enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model ApprovalRequest {
  id         String         @id @default(uuid(7))
  targetType String
  targetId   String
  action     String
  status     ApprovalStatus @default(PENDING)

  requestedByInternalUserId String
  requestedByInternalUser   InternalUser  @relation("ApprovalRequester", fields: [tenantId, requestedByInternalUserId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  decidedByInternalUserId   String?
  decidedByInternalUser     InternalUser? @relation("ApprovalDecider", fields: [tenantId, decidedByInternalUserId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  decisionReason            String?

  createdAt DateTime  @default(now())
  decidedAt DateTime?

  // The structural "at most one PENDING request per target+action"
  // guarantee is a PARTIAL unique index (status = 'PENDING' only), added by
  // hand to the migration SQL — @@unique here can't express a partial
  // condition, and a plain unique on (targetType, targetId, action) would
  // wrongly forbid ever requesting approval again after a decision.

  // Milestone S0D-1 — the owning tenant. REQUIRED since tenant isolation
  // phase 2: every write supplies it explicitly (root writes from the
  // request's TenantContext, child writes from a validated parent). No
  // default.
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([targetType, targetId, action])
  @@index([status])
  @@index([tenantId])
}

// SC3c-3 — a business's designated billing contact: ONE per business, a
// staff member of THAT business (composite foreign key — never another
// business's staff). Billing email goes to them when they are eligible at
// delivery time (ACTIVE, billing.manage business-wide, recently verified
// email); otherwise to the earliest eligible administrator. Reassigned only
// by a platform operator (audited).
model TenantBillingContact {
  id             String   @id @default(uuid(7))
  internalUserId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenantId     String
  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  internalUser InternalUser @relation("TenantBillingContactUser", fields: [tenantId, internalUserId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId])
  @@unique([tenantId, internalUserId])
  @@unique([tenantId, id])
}

// SC3c-3 — every operator grace extension (PAST_DUE) or grace exception
// (UNPAID): append-only (database trigger). At most 14 days each, at most 60
// in total per unpaid episode (episodeStartedAt = the episode's first failed
// payment). The debt is never touched.
model BillingGraceExtension {
  id                      String   @id @default(uuid(7))
  subscriptionId          String
  kind                    String
  episodeStartedAt        DateTime
  days                    Int
  previousEndsAt          DateTime
  newEndsAt               DateTime
  reason                  String
  actorPlatformOperatorId String
  createdAt               DateTime @default(now())

  subscription          TenantSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  actorPlatformOperator PlatformOperator   @relation("BillingGraceExtensionActor", fields: [actorPlatformOperatorId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([subscriptionId, episodeStartedAt])
  @@index([actorPlatformOperatorId])
}

// SC3c-3 — the platform billing notification queue (SEPARATE from the
// restaurant OutboxEvent / NotificationDelivery pipeline). One row per
// logical notice, deduplicated by `dedupeKey` (tied to the actual billing
// event or unpaid episode). The worker leases rows, sends at most twice
// (a provider timeout can still duplicate an email — never claimed
// exactly-once), and hands failures to review. The recipient is chosen at
// delivery time and never stored here.
model BillingNotification {
  id                String    @id @default(uuid(7))
  subscriptionId    String
  kind              String
  dedupeKey         String    @unique
  payload           Json
  status            String    @default("PENDING")
  attemptCount      Int       @default(0)
  nextAttemptAt     DateTime  @default(now())
  expiresAt         DateTime
  leaseOwner        String?
  leaseExpiresAt    DateTime?
  sendStartedAt     DateTime?
  possibleDuplicate Boolean   @default(false)
  sentAt            DateTime?
  finishedAt        DateTime?
  lastErrorCode     String?
  createdAt         DateTime  @default(now())

  subscription TenantSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([status, nextAttemptAt])
  @@index([subscriptionId])
}

// SC3d — a change of a BILLED business's plan or price: previewed (with the
// billing provider's own calculation), then — in later SC3d steps — requested,
// paid or scheduled, and applied. Platform data (no tenantId): the business is
// reached only through its subscription.
//
//   timing  IMMEDIATE   an upgrade (or monthly -> annual): charged now with
//                       proration; the new plan applies only after the
//                       provider's invoice is VERIFIED paid;
//           PERIOD_END  a downgrade (or annual -> monthly): at the end of
//                       the current period, no refund or credit;
//           TRIAL_END   the plan a trial becomes (no charge, no new modules
//                       during the trial).
//   status  PREVIEWED -> REQUESTED -> AWAITING_PAYMENT / SCHEDULED -> APPLIED,
//           or CANCELED / EXPIRED / FAILED; REVIEW when the provider and our
//           records disagree. At most ONE open (non-preview) change per
//           subscription (partial unique index). The previewed amounts and
//           proration date never change once recorded (trigger): a different
//           charge needs a NEW preview the business confirms again.
model BillingPlanChange {
  id                         String    @id @default(uuid(7))
  subscriptionId             String
  timing                     String
  status                     String    @default("PREVIEWED")
  fromPlanVersionId          String
  fromPlanPriceId            String
  toPlanVersionId            String
  toPlanPriceId              String
  currency                   String
  // IMMEDIATE only: the provider's preview of the charge now (minor units).
  previewAmountDueMinorUnits Int?
  previewTotalMinorUnits     Int?
  previewTaxMinorUnits       Int?
  previewDiscountMinorUnits  Int?
  previewProrationMinorUnits Int?
  prorationDate              DateTime?
  externalItemId             String?
  // The recurring price after the change, and from when.
  nextRecurringMinorUnits    Int
  nextRecurringStartsAt      DateTime?
  previewExpiresAt           DateTime
  // Later SC3d steps: the provider's invoice / schedule and what was paid.
  externalInvoiceId          String?
  externalScheduleId         String?
  amountPaidMinorUnits       Int?
  failureCode                String?
  // SC3d-2 — when a business user confirmed the change (and its charge);
  // an operator preview's mandatory written reason (operators never confirm).
  confirmedAt                DateTime?
  operatorReason             String?
  actorKind                  String
  actorPlatformOperatorId    String?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt
  finishedAt                 DateTime?

  subscription          TenantSubscription      @relation(fields: [subscriptionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  fromPlanVersion       SubscriptionPlanVersion @relation("BillingPlanChangeFromVersion", fields: [fromPlanVersionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  toPlanVersion         SubscriptionPlanVersion @relation("BillingPlanChangeToVersion", fields: [toPlanVersionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  fromPlanPrice         SubscriptionPlanPrice   @relation("BillingPlanChangeFromPrice", fields: [fromPlanPriceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  toPlanPrice           SubscriptionPlanPrice   @relation("BillingPlanChangeToPrice", fields: [toPlanPriceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  actorPlatformOperator PlatformOperator?       @relation("BillingPlanChangeActor", fields: [actorPlatformOperatorId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([subscriptionId, status])
  @@index([fromPlanVersionId])
  @@index([toPlanVersionId])
  @@index([fromPlanPriceId])
  @@index([toPlanPriceId])
  @@index([actorPlatformOperatorId])
}

// SC3e-1 — the business's CENTERIVO subscription invoices as the billing
// provider last reported them (owner decision D1): kept in line from
// verified provider events (invoices, credit notes) and the reconciliation
// sweep, always from a LIVE provider read. The provider stays authoritative
// for money; this is history to show, never a basis for charging or
// refunding. No document URL and no payment-method detail is ever stored
// (document links are resolved per request — owner decision D2).
//
// Platform billing data (no tenantId): the business is reached only through
// TenantSubscription. Never a restaurant order, payment or refund.
// Never deleted; the provider invoice and its subscription are set once; a
// paid or void invoice stays so (database trigger).
model BillingInvoice {
  // SC3e-3 — refunds and credits on this invoice.
  adjustments                 BillingAdjustment[]
  id                          String              @id @default(uuid(7))
  subscriptionId              String
  provider                    String
  externalInvoiceId           String
  externalCustomerId          String
  externalSubscriptionId      String
  // The provider's invoice number (null while a draft).
  number                      String?
  // draft | open | paid | void | uncollectible
  status                      String
  billingReason               String?
  // Lower-case ISO currency, as the provider reports it.
  currency                    String
  totalMinorUnits             Int
  amountDueMinorUnits         Int
  amountPaidMinorUnits        Int
  amountRemainingMinorUnits   Int
  // Credit notes issued after payment (refunds or account credits).
  postPaymentCreditMinorUnits Int                 @default(0)
  // Credit notes before payment and account balance applied to it.
  prePaymentCreditMinorUnits  Int                 @default(0)
  balanceAppliedMinorUnits    Int                 @default(0)
  periodStart                 DateTime?
  periodEnd                   DateTime?
  issuedAt                    DateTime
  paidAt                      DateTime?
  // When the provider was read for this version (a stale read never
  // overwrites a newer one).
  syncedAt                    DateTime
  createdAt                   DateTime            @default(now())
  updatedAt                   DateTime            @updatedAt

  subscription TenantSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([provider, externalInvoiceId])
  @@index([subscriptionId, issuedAt(sort: Desc), id(sort: Desc)])
}

// SC3e-2 — a permission held by a CENTERIVO platform operator (owner
// decision D1). Database-backed, re-read on every request. Granted and
// revoked ONLY by the human-run provisioning CLI (never by an API, so an
// operator can never grant itself anything), each with a reason and a
// platform audit event. A revoked grant stays (revokedAt): the history of
// who could do what is never lost. At most one live grant per operator and
// permission (partial unique index); never deleted (database trigger).
model PlatformOperatorPermission {
  id                  String    @id @default(uuid(7))
  operatorId          String
  permission          String
  grantReason         String
  grantedAt           DateTime  @default(now())
  revokedAt           DateTime?
  revokeReason        String?
  // SC3e-3 (owner decision D7) — how it was granted: CLI (non-financial
  // permissions only), CLI_BOOTSTRAP (the documented, restricted first grants
  // of financial permissions: who ran it and the independent approval's
  // reference are recorded), or CONSOLE (an authenticated operator holding
  // platform.permissions.manage, never for itself).
  grantedVia          String    @default("CLI")
  grantedByOperatorId String?
  approvalReference   String?
  executedBy          String?
  revokedByOperatorId String?

  operator  PlatformOperator  @relation("PlatformOperatorPermissionHolder", fields: [operatorId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  grantedBy PlatformOperator? @relation("PlatformOperatorPermissionGrantor", fields: [grantedByOperatorId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  revokedBy PlatformOperator? @relation("PlatformOperatorPermissionRevoker", fields: [revokedByOperatorId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([operatorId])
  @@index([grantedByOperatorId])
  @@index([revokedByOperatorId])
}

// SC3e-2 — a complimentary arrangement for a business (owner decisions
// D2–D4): an explicitly chosen plan version, indefinite or until `endsAt`.
//   SCHEDULED  a paying business: its provider subscription is set to cancel
//              at the end of the period already paid (verified), and the
//              grant starts only once the provider confirms it ended;
//   ACTIVE     the business is COMPLIMENTARY on `planVersionId`;
//   WITHDRAWN  ended before it started (the cancellation undone);
//   ENDED      expired or revoked: the business returned to billing.
// What the business was billed as before (`previous*`) is kept so that
// ending the grant restores it exactly — into payment setup / restart, never
// a new trial and never an automatic charge. Platform billing data (no
// tenantId). At most one SCHEDULED or ACTIVE grant per subscription; never
// deleted; forward-only (database trigger).
model BillingComplimentaryGrant {
  id                                 String    @id @default(uuid(7))
  subscriptionId                     String
  status                             String
  planVersionId                      String
  // null: indefinite.
  endsAt                             DateTime?
  reason                             String
  grantedByOperatorId                String
  previousStatus                     String
  previousPlanVersionId              String
  previousPlanPriceId                String
  previousBillingProvider            String
  previousExternalCustomerId         String
  previousExternalSubscriptionId     String?
  previousTrialStartedAt             DateTime?
  previousTrialEndsAt                DateTime?
  previousTrialRequiresPaymentMethod Boolean?
  // SCHEDULED: the end of the paid period (when the provider ends it).
  effectiveAt                        DateTime?
  // When the provider's scheduled cancellation was verified.
  cancelVerifiedAt                   DateTime?
  startedAt                          DateTime?
  finishedAt                         DateTime?
  // WITHDRAWN / ENDED: a short code (EXPIRED, REVOKED, WITHDRAWN, …) and
  // the operator's reason, when an operator did it.
  finishCode                         String?
  finishReason                       String?
  finishedByOperatorId               String?
  createdAt                          DateTime  @default(now())
  updatedAt                          DateTime  @updatedAt

  subscription        TenantSubscription      @relation(fields: [subscriptionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  planVersion         SubscriptionPlanVersion @relation("BillingComplimentaryGrantPlan", fields: [planVersionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  previousPlanVersion SubscriptionPlanVersion @relation("BillingComplimentaryGrantPreviousPlan", fields: [previousPlanVersionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  previousPlanPrice   SubscriptionPlanPrice   @relation("BillingComplimentaryGrantPreviousPrice", fields: [previousPlanPriceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  grantedBy           PlatformOperator        @relation("BillingComplimentaryGrantGrantedBy", fields: [grantedByOperatorId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  finishedBy          PlatformOperator?       @relation("BillingComplimentaryGrantFinishedBy", fields: [finishedByOperatorId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([subscriptionId, createdAt])
  @@index([status, endsAt])
  @@index([planVersionId])
  @@index([previousPlanVersionId])
  @@index([previousPlanPriceId])
  @@index([grantedByOperatorId])
  @@index([finishedByOperatorId])
}

// SC3e-2 — what an operator did on a billing review case (owner decision
// D5): a Stripe recheck, a verified schedule release, or closing it with an
// outcome. Append-only (database trigger): never changed or deleted.
model BillingReconciliationCaseAction {
  id                      String   @id @default(uuid(7))
  caseId                  String
  // RECHECKED | SCHEDULE_RELEASED | CLOSED
  action                  String
  // A short result code (e.g. CONSISTENT, RELEASED, FIXED_AT_PROVIDER).
  result                  String
  note                    String?
  // SCHEDULE_RELEASED: the provider schedule that was released.
  externalScheduleId      String?
  actorPlatformOperatorId String
  createdAt               DateTime @default(now())

  case  BillingReconciliationCase @relation(fields: [caseId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  actor PlatformOperator          @relation("BillingCaseActionActor", fields: [actorPlatformOperatorId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([caseId, createdAt])
  @@index([actorPlatformOperatorId])
}

// SC3e-3 — a refund or credit on one of a business's CENTERIVO subscription
// invoices (owner decisions D1–D6), as a Stripe credit note against that paid
// invoice. Platform billing data (no tenantId); never a restaurant payment
// or refund.
//   origin CENTERIVO: requested by an operator, approved by one or two OTHER
//     operators (by amount, currency and annual full refunds), executed by
//     the final approver: PENDING_APPROVAL -> EXECUTING (reserved before the
//     provider is called) -> SUBMITTED (credit note issued, refund not yet
//     confirmed) -> SUCCEEDED; or REJECTED / CANCELED / EXPIRED before it,
//     FAILED (nothing issued) or REVIEW (unclear: an operator investigates).
//   origin EXTERNAL: a credit note or refund made directly in Stripe,
//     RECORDED (never approved here, never repeated or reversed).
// What was requested (amounts as Stripe previewed them, tax included —
// never computed here) never changes; at most one open CENTERIVO adjustment
// per invoice; never deleted (database trigger).
model BillingAdjustment {
  id                    String    @id @default(uuid(7))
  subscriptionId        String
  invoiceId             String
  origin                String
  // REFUND (to the original payment method) | CREDIT (customer balance,
  // toward future invoices) | OUT_OF_BAND (external only)
  kind                  String
  // FULL | PARTIAL (CENTERIVO only)
  scope                 String?
  status                String
  currency              String
  totalMinorUnits       Int
  taxMinorUnits         Int       @default(0)
  // A full refund of an annual period (always two approvers).
  annualFullRefund      Boolean   @default(false)
  requiredApprovals     Int       @default(0)
  reason                String?
  requestedByOperatorId String?
  // The credit-note lines requested (invoice line ids and amounts), exactly
  // as previewed.
  lineSpec              Json?
  expiresAt             DateTime?
  executionStartedAt    DateTime?
  submittedAt           DateTime?
  finishedAt            DateTime?
  failureCode           String?
  externalCreditNoteId  String?   @unique
  externalRefundId      String?   @unique
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  subscription TenantSubscription          @relation(fields: [subscriptionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  invoice      BillingInvoice              @relation(fields: [invoiceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  requestedBy  PlatformOperator?           @relation("BillingAdjustmentRequester", fields: [requestedByOperatorId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  decisions    BillingAdjustmentDecision[]
  events       BillingAdjustmentEvent[]

  @@index([subscriptionId, createdAt])
  @@index([invoiceId])
  @@index([status, expiresAt])
  @@index([requestedByOperatorId])
}

// SC3e-3 — one operator's decision on an adjustment: APPROVED or REJECTED,
// with a note. One per operator per adjustment, never the requester's;
// append-only (database trigger).
model BillingAdjustmentDecision {
  id           String   @id @default(uuid(7))
  adjustmentId String
  operatorId   String
  decision     String
  note         String
  createdAt    DateTime @default(now())

  adjustment BillingAdjustment @relation(fields: [adjustmentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  operator   PlatformOperator  @relation("BillingAdjustmentDecider", fields: [operatorId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([adjustmentId, operatorId])
  @@index([operatorId])
}

// SC3e-3 — the adjustment's history (requested, approved, executing,
// submitted, succeeded, failed, review, recorded …): append-only.
model BillingAdjustmentEvent {
  id                      String   @id @default(uuid(7))
  adjustmentId            String
  type                    String
  // A short result code (e.g. PREVIEW_CHANGED, REFUND_PENDING).
  code                    String?
  // The operator's written note (a withdrawal or a review resolution).
  note                    String?
  actorPlatformOperatorId String?
  createdAt               DateTime @default(now())

  adjustment BillingAdjustment @relation(fields: [adjustmentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  actor      PlatformOperator? @relation("BillingAdjustmentEventActor", fields: [actorPlatformOperatorId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([adjustmentId, createdAt])
  @@index([actorPlatformOperatorId])
}

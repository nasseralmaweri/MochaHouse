  billingProviderEvent  BillingProviderEvent?    @relation(fields: [billingProviderEventId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([subscriptionId, createdAt])
  @@index([planPriceId])
  @@index([billingProviderEventId])
}

enum PlatformAuditOutcome {
  SUCCEEDED
  DENIED
}

// Security-relevant platform-operator events (sign-in to the platform API,
// denied access, provisioning changes). Append-only by convention, written
// synchronously. Never holds a token, credential or request payload.
model PlatformAuditEvent {
  id                      String               @id @default(uuid(7))
  // Null when no operator could be established (e.g. a verified identity
  // with no operator record) or for a CLI action with no operator actor.
  actorPlatformOperatorId String?
  action                  String
  outcome                 PlatformAuditOutcome
  // A short machine code (e.g. OPERATOR_DISABLED); never free text from a
  // request.
  reasonCode              String?
  // The verified identity involved when there is no operator row to point
  // at — identifiers only, never a token.
  identityProvider        String?
  identitySubject         String?
  // The server-assigned request id, when the event came from a request.
  requestReference        String?
  // SC1d — what the event was about, when it was about one record (e.g.
  // targetType "tenant", targetId the business's id). Both or neither. A
  // plain value, never a foreign key: the platform trail holds no reference
  // to a business record.
  targetType              String?
  targetId                String?
  createdAt               DateTime             @default(now())

  actorPlatformOperator PlatformOperator? @relation("PlatformAuditEventActor", fields: [actorPlatformOperatorId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([actorPlatformOperatorId])
  @@index([action, createdAt])
  @@index([createdAt])
}

